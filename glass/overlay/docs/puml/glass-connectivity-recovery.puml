@startuml glass-connectivity-recovery
!include _standard-style.puml
left to right direction
skinparam defaultFontSize 15
skinparam componentFontSize 15
skinparam arrowFontSize 13
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 18
skinparam ranksep 70
hide stereotype
title What breaks, who notices, what happens — glass

package "What breaks" {
  component "A provider or the proxy\nblips (network error, 502/503/504)" as f1 <<external>>
  component "The corporate proxy\nrefuses the tunnel" as f2 <<external>>
  component "Kerberos ticket expired\n(e.g. overnight, off the network)" as f3 <<external>>
  component "glass daemon not running" as f4 <<external>>
  component "Local proxy stale after\njoining / leaving VPN" as f5 <<external>>
}

package "Who notices" {
  component "the forward\n(each request)" as d1 <<core>>
  component "egress\n(each request)" as d2 <<core>>
  component "network monitor\n(every 15 s, and on an OS\nnetwork change: macOS, Linux)" as d3 <<util>>
  component "glass <agent> / glass ui\n(at launch)" as d4 <<cli>>
}

package "What happens" {
  component "retry up to 3× (0 · 300 · 900 ms),\nonly before the first byte;\nthen a 502 the agent can show" as a1 <<core>>
  component "error names proxy, host and status;\nsame host fails fast for 10 s" as a2 <<core>>
  component "macOS: asks the Kerberos SSO extension\n(≤ every 2 min); Linux / WSL: run kinit;\nWindows renews it at logon;\nstatus line K:NO until it lands" as a3 <<core>>
  component "starts the daemon, re-adopts live\nsessions; if it cannot, the agent\nruns unmeasured — never blocked" as a4 <<core>>
  component "not healed by glass — status line\nP:OFF; restart the local proxy\n(coding's coordinator does this)" as a5 <<api>>
}

f1 SYNC_LINE d1
d1 CONTROL_LINE a1
f2 SYNC_LINE d2
d2 CONTROL_LINE a2
f3 SYNC_LINE d3
d3 CONTROL_LINE a3
f4 SYNC_LINE d4
d4 CONTROL_LINE a4
f5 SYNC_LINE d3
d3 OPTIONAL_LINE a5
@enduml
