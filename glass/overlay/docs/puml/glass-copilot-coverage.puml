@startuml glass-copilot-coverage
!include _standard-style.puml
top to bottom direction
skinparam defaultFontSize 20
skinparam componentFontSize 20
skinparam packageFontSize 20
skinparam arrowFontSize 16
skinparam nodesep 40
skinparam ranksep 50
skinparam shadowing false
skinparam componentStyle rectangle
hide stereotype

rectangle "Measured by glass — per call, per model" {
  component "Agents started with glass <agent>\nCopilot CLI · OpenCode · pi\nin any terminal, VS Code's included" as agents <<agent>>
  component "VS Code Copilot Chat\nread from its chat history\n(estimated)" as vscode <<agent>>
  component "coding's background jobs\nwhere coding is installed" as bg <<core>>
  component "glass\nCost tab · GH €" as meter <<storage>>
  agents SYNC_LINE meter : every call
  vscode OPTIONAL_LINE meter : after the fact
  bg SYNC_LINE meter : every call
}

rectangle "Not measured — only in GitHub's total" {
  component "Agents started\nwithout glass" as bare <<external>>
  component "Other machines\ngithub.com" as other <<external>>
  bare -[hidden]down- other
}

component "Your GitHub Copilot account\nGitHub's own month-to-date count" as bill <<api>>
meter DATA_LINE bill : measured + priced
bill <-[#757575,thickness=1,dotted]- bare
bill <-[#757575,thickness=1,dotted]- other
bill ASYNC_LINE meter : GitHub reports\n(read-only, every 15 min)
@enduml
