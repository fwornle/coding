@startuml
!include _standard-style.puml

package "Compatibility Layer" {
  component "CodeGraphAgent\n(shim)" as cga <<agent>>
  component "checkMemgraphConnection\n(vestigial)" as chk <<api>>
}

package "Static Graph Backend" {
  component "GraphifyGraph" as gg <<core>>
  component "kindOf/nameOf\n(label parsing)" as parse <<core>>
  database "graph.json\n(NetworkX node-link)" as graphjson <<storage>>
}

package "Graph Persistence & Migration" {
  component "GraphDatabaseService\n(dirty-flag model)" as gds <<core>>
  component "migrate-graph-db-entity-types.js\n(ENTITY_TYPE_MAPPING)" as migrate <<cli>>
  component "Anchor Resolution\n(name+type, projectAnchorName)" as anchor <<core>>
}

cga --> chk : "preserves legacy interface"
cga --> gg : "delegates reads"
gg --> graphjson : "loads static export"
gg --> parse : "derives type/name"
graphjson ..> migrate : "consolidated by"
migrate ..> parse : "type divergence risk"
gds --> graphjson : "manual dirty-flag persist"
anchor --> gds : "queryIncomingRelations/storeRelationship"
anchor ..> graphjson : "prevents orphan nodes"
cga ..> gds : "would need write-path audit"

@enduml