@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Dashboard UI" {
  component "ukb-workflow-modal.tsx" as modal <<core>>
  component "calculateDynamicEta()" as dynEta <<core>>
  component "calculateStepAwareEta()" as legacyEta <<core>>
  component "multi-agent-graph.tsx" as graph <<core>>
  component "AGENT_SUBSTEPS" as substeps <<core>>
  component "WAVE_AGENTS" as waveAgents <<core>>
}

package "Knowledge Store Access Paths" {
  component "ukb-database/cli.js" as dbCli <<cli>>
  component "ukb-unified/cli.js (UKBCli)" as unifiedCli <<cli>>
  component "VkbApiClient" as vkbClient <<api>>
}

package "Backend Store" {
  database "SQLite + Qdrant + GraphDB" as store
  cloud "VKB Server (port 8080)" as vkbServer
}

modal --> dynEta : "computes batch-aware ETA"
legacyEta --> dynEta : "delegates (legacy shim)"
modal --> legacyEta : "some call sites use"

graph --> substeps : "renders LLM-tier map"
graph --> waveAgents : "fallback for historical view"

dbCli --> store : "direct writes"
unifiedCli --> store : "orchestrated incremental writes"
vkbClient --> vkbServer : "HTTP CRUD + isServerAvailable()"
vkbServer --> store : "enforces validation/decay"

modal ..> unifiedCli : "reflects pipeline state"
graph ..> unifiedCli : "visualizes agent pipeline"

@enduml