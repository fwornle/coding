@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Data Sources" {
  component "Git History" as git <<external>>
  component "LSL Session Logs" as lsl <<external>>
  component "Code Analysis Output" as code <<external>>
}

package "Batch Analysis Pipeline" {
  component "OnlineLearning Extractor" as extractor <<core>>
}

package "VKB Server" {
  component "Persistence Operations" as persist <<api>>
  component "Decay Tracking Logic" as decay <<core>>
  component "Schema Coordination" as schema <<core>>
  database "Graph Store" as graph <<storage>>
}

component "code-graph-agent.ts" as agent <<agent>>

git --> extractor
lsl --> extractor
code --> extractor

extractor --> persist : "extracted entities"
persist --> graph : "writes"
decay --> graph : "tracks freshness of"
schema --> graph : "governs entity types in"

agent --> persist : "consumes entity operations"

@enduml