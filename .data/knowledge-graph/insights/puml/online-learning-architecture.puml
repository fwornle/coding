@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Learning Source Classification" {
  component "learning-source.ts\n(isOnlineLearned)" as source <<core>>
  component "color-fallback.ts\n(classColor/node FillColor)" as colorfb <<core>>
  component "BATCH_PALETTE /\nONLINE_PALETTE" as palettes <<storage>>
}

package "Graph Visualization" {
  component "D3GraphCanvas.tsx\n(VKB port)" as canvas <<core>>
  component "ONLINE_RING_COLOR\nring overlay" as ring <<core>>
  component "Legend / Filter Rail /\nHistory Sidebar" as legend <<core>>
}

package "System Health Dashboard" {
  component "ukbSlice.ts\n(LLMMode, llmMode?)" as slice <<core>>
  component "multi-agent-graph.tsx\n(AGENT_SUBSTEPS, llmUsage)" as agentgraph <<agent>>
  component "ukb-workflow-modal.tsx\n(HISTORY_PAGE_SIZE=500)" as modal <<api>>
}

database "/api/ukb/history" as historyApi

colorfb --> source : "delegates classification"
colorfb --> palettes : "resolves fill/ring colors"
canvas --> source : "imports isOnlineLearned"
canvas --> ring : "draws provenance ring"
canvas --> legend : "shares classification"
colorfb --> legend : "shares classification"

slice --> agentgraph : "propagates llmMode"
agentgraph --> modal : "reports substep status"
modal --> historyApi : "fetches paginated history"

canvas ..> colorfb : "uses node FillColor/node ShapeFor"

@enduml