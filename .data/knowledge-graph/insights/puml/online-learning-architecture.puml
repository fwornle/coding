@startuml
!include _standard-style.puml

package "Graph Visualization" {
  component "D3GraphCanvas.tsx" as d3canvas <<core>>
  component "SigmaCanvas.tsx" as sigmacanvas <<core>>
  component "learning-source" as learnsrc <<core>>
  component "isOnlineLearned" as isol <<core>>
}

package "Density Tooling" {
  component "assert-graph-density.ts" as density <<cli>>
  component "DEFAULT_FILTERS" as filters <<core>>
}

package "Write Path (Unlanded)" {
  component "writeInsight" as writeinsight <<core>>
  component "Embedding Dedup (dry-run)" as dedup <<core>>
}

d3canvas --> learnsrc : "imports"
learnsrc --> isol : "exposes flag"
isol --> d3canvas : "colors node by learning source"

density --> filters : "defines"
filters --> learnsrc : "learningSource='combined'"

writeinsight ..> dedup : "planned integration"
dedup ..> learnsrc : "conceptually related\n(no code link found)"

@enduml