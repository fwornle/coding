@startuml
!include _standard-style.puml

package "Streaming Ingestion (Online)" {
  component "Conversational Exchange Buffer" as buffer <<core>>
  component "Streaming Config\n(bufferSize/debounceMs/minExchangeLength)" as config <<core>>
  component "learning-source.ts\n(isOnlineLearned)" as learnsrc <<core>>
}

package "Batch Ingestion (UKB/Wave)" {
  component "UKB Workflow Modal" as modal <<agent>>
  component "ukbSlice (batchIterations, WaveGroup)" as slice <<core>>
}

package "Shared Graph Store" {
  database "Entity/Insight Graph" as graph <<storage>>
  component "km-core-adapter.ts\n(entity Type-aware resolution)" as adapter <<core>>
  component "hierarchy-parents.ts\n(deriveParents)" as hierarchy <<core>>
}

package "Visualization" {
  component "D3GraphCanvas.tsx" as canvas <<api>>
  component "vokb-palette\n(ONLINE_RING_COLOR)" as palette <<external>>
}

config --> buffer : "governs debounce/batch"
buffer --> learnsrc : "flags entities as online-learned"
learnsrc --> adapter : "writes without wave-analysis stamp"

modal --> slice : "drives batch state"
slice --> adapter : "writes with source='wave-analysis'"

adapter --> graph : "storeRelationship (entity Type-safe)"

graph --> hierarchy : "deriveParents (Insight @ Detail)"
graph --> canvas : "renders entities"
learnsrc --> canvas : "isOnlineLearned flag"
palette --> canvas : "ring color"

@enduml