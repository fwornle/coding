@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "CLI & Orchestration" {
  component "cli.js" as cli <<cli>>
  component "GapAnalyzer" as gap <<core>>
  component "TeamCheckpointManager" as ckpt <<core>>
  component "WorkflowOrchestrator" as orch <<core>>
}

package "Automated Extraction" {
  component "MCP Tools\n(execute_workflow)" as mcp <<external>>
  component "AGENT_SUBSTEPS Pipeline\n(kg_operators, git_history)" as substeps <<agent>>
}

package "Data & Visualization" {
  database "GraphDB" as graphdb <<storage>>
  component "data-processor.js\nexportOnlineKnowledge()" as dproc <<core>>
  component "ukb-workflow-modal.tsx\ncalculateDynamicEta()" as eta <<core>>
}

cli --> ckpt : "loads checkpoint"
cli --> gap : "getGapSummary()"
gap --> orch : "gap scope (sinceCommit, commits, sessions)"
orch --> mcp : "checkMCPToolsAvailability()"
orch ..> orch : "fallback mock*Workflow"
mcp --> substeps : "executeIncrementalWorkflow()"
substeps --> graphdb : "writes auto-extracted entities"
substeps --> eta : "batchIterations timing"
graphdb --> dproc : "queryEntities(team, limit:5000)"
dproc --> dproc : "source 'auto' -> 'online'"

@enduml