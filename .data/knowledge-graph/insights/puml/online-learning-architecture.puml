@startuml
!include _standard-style.puml

package "Rendering Layer" {
  component "D3GraphCanvas.tsx" as canvas <<core>>
  component "learning-source.ts" as learnsrc <<external>>
  component "color-fallback.ts" as colorfb <<external>>
}

package "Viewer Store / Filters" {
  component "viewer-store.ts (missing)" as store <<external>>
  component "assert-graph-density.ts" as assertscript <<cli>>
}

package "Batch Wave Pipeline" {
  component "ukb-workflow-modal.tsx" as modal <<core>>
  database "Insight Documents (73)" as insightdocs <<storage>>
  database "Graph Nodes (Insight type)" as insightnodes <<storage>>
}

canvas ..> learnsrc : "imports isOnlineLearned"
canvas ..> colorfb : "imports ONLINE_RING_COLOR"

assertscript ..> store : "duplicates DEFAULT_FILTERS\n(learningSource='combined')"

modal --> insightdocs : "writes batch insight docs"
insightdocs ..> insightnodes : "expected but missing\n(Wave 4 gap)"
insightnodes ..> modal : "History sidebar Batch badge\n(entity Type='Insight')"

modal --> canvas : "provides batch-derived entities"
learnsrc ..> insightnodes : "classifies provenance\n(online vs batch)"

@enduml