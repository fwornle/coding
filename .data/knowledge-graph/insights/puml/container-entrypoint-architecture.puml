@startuml
!include _standard-style.puml

package "Container Boundary" {
  component "entrypoint.sh" as entry <<core>>
  component "wait_for_service()" as tcpcheck <<core>>
  component "Feature Gating Block" as featuregate <<core>>
  component ".env Loader / Filter" as envfilter <<core>>
  component "supervisord" as supervisord <<core>>
}

package "External Dependencies" {
  database "Qdrant" as qdrant
  database "Redis" as redis
  cloud "llm-cli-proxy :12435" as proxy <<external>>
  component "features.json" as featuresjson <<storage>>
}

package "Host-Side Parallel Gating" {
  component "start-services-robust.js" as hoststart <<core>>
  component "service-gating.test.mjs" as gatingtest <<agent>>
  component "service-probe.js" as probe <<core>>
}

entry --> tcpcheck : "TCP readiness poll"
tcpcheck --> qdrant : "checks reachability"
tcpcheck --> redis : "checks reachability"
entry --> featuregate : "reads snapshot"
featuregate --> featuresjson : "loadFeatures()"
featuregate --> supervisord : "writes disabled.conf"
entry --> envfilter : "filters *_API_KEY/*_TOKEN"
envfilter --> proxy : "routes LLM/embedding egress"
entry --> supervisord : "exec (handoff)"

featuresjson --> hoststart : "shared data contract"
hoststart --> gatingtest : "validated by"
supervisord ..> probe : "coarse TCP vs HTTP health tiers"

@enduml