@startuml
!include _standard-style.puml

package "Supervision Layer" {
  component "combined-status-line.js" as statusline <<core>>
  component "ProcessStateManager" as psm <<core>>
  component "health-remediation-actions.js" as remediation <<core>>
}

package "TranscriptMonitor Core" {
  component "EnhancedTranscriptMonitor" as etm <<core>>
  component "resolveHostCodingPath()" as hostpath <<core>>
  component "toolCallArgs() / bashWriteTargets()" as normalizer <<core>>
  component "singleton-reclaim.mjs" as reclaim <<core>>
}

package "Downstream Write Path" {
  component "ObservationWriter" as writer <<storage>>
  component "ObservationConsolidator" as consolidator <<storage>>
  database "obs-api" as obsapi <<storage>>
}

statusline --> etm : "ensureTranscriptMonitorRunning / start"
statusline --> psm : "tracks lifecycle state"
remediation --> etm : "restartTranscriptMonitor"

etm --> hostpath : "resolves host path at load"
etm --> normalizer : "extractFileChanges()"
etm --> reclaim : "reclaim stalled lock (STALL-DETECT)"
etm --> psm : "reports state"

etm --> writer : "emits exchanges/artifacts"
writer --> consolidator : "persist/digest"
consolidator --> obsapi : "execFileAsync (contention risk)"

@enduml