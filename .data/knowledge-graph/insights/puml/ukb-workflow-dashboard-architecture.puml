@startuml
!include _standard-style.puml

package "UKB Workflow Modal" {
  component "ukb-workflow-modal.tsx" as modal <<core>>
  component "HISTORY_PAGE_SIZE\n(/api/ukb/history)" as pagesize <<api>>
  component "calculateDynamicEta" as eta <<core>>
  component "calculateStepAwareEta\n(legacy delegate)" as etalegacy <<core>>
  component "useWorkflowWebSocket" as ws <<api>>
}

package "Redux State Layer" {
  component "ukbSlice.ts" as slice <<core>>
  component "UKBProcess\n(legacy polling state)" as legacyState <<storage>>
  component "WorkflowExecutionState\n(event-driven state)" as newState <<storage>>
  component "shared/workflow-types" as sharedtypes <<external>>
}

package "Workflow Visualization" {
  component "MultiAgentGraph\n(multi-agent-graph.tsx)" as mag <<core>>
  component "AGENT_SUBSTEPS" as substeps <<core>>
  component "D3GraphCanvas" as d3 <<core>>
  component "color-fallback.ts\n(node FillColor/node ShapeFor)" as colorfb <<core>>
}

modal --> pagesize : "fetches history"
modal --> eta : "computes ETA"
eta --> etalegacy : "delegates to"
modal --> ws : "live updates"
modal --> slice : "reads/dispatches"
modal --> mag : "renders"

slice --> legacyState : "maintains"
slice --> newState : "maintains"
slice --> sharedtypes : "typed by"

mag --> substeps : "configures agents"
d3 --> colorfb : "resolves colors/shapes"
mag ..> colorfb : "shares resolver"

newState ..> legacyState : "parallel, unconsolidated"

@enduml