@startuml
!include _standard-style.puml

package "System Health Dashboard" {
  component "UkbWorkflowModal\n(UkbWorkflowDashboard)" as modal <<core>>
  component "History Tab" as history <<core>>
  component "Progress/Statistics Tabs" as stats <<core>>
  component "calculateDynamicEta()" as eta <<core>>
  component "calculateStepAwareEta()\n(legacy shim)" as legacyEta <<core>>
  component "ukbSlice (Redux)" as slice <<storage>>
}

package "Workflow Subcomponents ('./workflow')" {
  component "MultiAgentGraph\n(UKBWorkflowGraph)" as graph <<agent>>
  component "WorkflowLegend" as legend <<core>>
  component "TraceModal" as trace <<core>>
  component "UKBNodeDetailsSidebar" as sidebar <<core>>
}

cloud "/api/ukb/history" as api <<external>>
database "Report Storage / Graph Nodes" as store <<storage>>

modal --> history : "renders"
modal --> stats : "renders"
modal --> graph : "composes"
modal --> legend : "composes"
modal --> trace : "composes"
modal --> sidebar : "drill-down to code"

history --> api : "fetches paginated\nHISTORY_PAGE_SIZE"
api --> store : "parses ALL reports\n(limit only slices)"

stats --> eta : "computes ETA"
eta ..> legacyEta : "delegated by\n(compat shim)"

modal --> slice : "reads/dispatches"
slice --> slice : "WorkflowExecutionState\nvs UKBProcess (dual state)"

store ..> history : "Insight nodes must be\nstamped to be visible"

@enduml