@startuml
!include _standard-style.puml

package "Capture & Upstream" {
  component "enhanced-transcript-monitor.js" as etm <<agent>>
}

package "Write & Consolidate (obs-api)" {
  component "ObservationWriter" as writer <<core>>
  component "legacy-ingest adapters" as adapter <<core>>
  component "raw-fallback.js" as rawfb <<core>>
  component "ObservationConsolidator" as consolidator <<core>>
  database "GraphKMStore (LevelDB)" as kmstore <<storage>>
}

package "Export & Consumption" {
  component "ObservationExporter" as exporter <<core>>
  component "observation-export JSON" as jsonstore <<storage>>
  component "dashboard /api/coding/observations" as dashboard <<api>>
}

etm --> writer : "extracted artifacts"
writer --> adapter : "legacyObservationToEntity"
adapter --> kmstore : "putEntity (capturedBy anchored)"
writer ..> rawfb : "isRawFallbackSummary()"

kmstore --> consolidator : "reads observations"
consolidator --> consolidator : "consolidateDay() / synthesizeInsights()"
consolidator --> writer : "writeInsight (single-owner)"
consolidator --> kmstore : "async git via execFileAsync"

kmstore --> exporter : "reads entities"
exporter ..> rawfb : "keepInExport() filter"
exporter --> jsonstore : "_mergeWithExisting / tombstones"
jsonstore --> dashboard : "ColdStoreReader"

@enduml