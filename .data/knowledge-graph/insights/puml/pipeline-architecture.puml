@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Coordination" {
  component "Coordinator Agent" as coord <<agent>>
}

package "Analysis Stages" {
  component "Semantic Analysis Agent" as sem <<agent>>
  component "Ontology Classification Agent" as onto <<agent>>
  component "Observation Generation" as obs <<core>>
  component "Deduplication Stage" as dedup <<core>>
}

package "Graph & Storage" {
  component "KG Operator" as kg <<core>>
  component "Persistence Agent" as persist <<agent>>
  database "Durable Store" as store <<storage>>
}

coord --> sem : "sequences"
coord --> onto : "sequences"
sem --> obs : "produces entities"
onto --> obs : "produces classifications"
obs --> dedup : "merges git/LSL entities"
dedup --> kg : "writes intermediate rep"
kg --> persist : "in-memory results"
persist --> store : "durable writes"

@enduml