@startuml
!include _standard-style.puml

package "Ontology Pipeline" {
  component "coding.lower.json" as codingLower <<core>>
  component "OntologyRegistry" as ontReg <<core>>
  component "OntologyClassificationAgent" as classifier <<agent>>
  component "LegacyOntologyAdapter" as legacyAdapter <<core>>
  component "createOntologySystem()" as ontFactory <<core>>
}

package "Health & Monitoring" {
  component "health-coordinator.js" as healthCoord <<core>>
  component "pollKnowledgePipeline" as pollKP <<core>>
  component "graph_integrity check" as graphIntegrity <<core>>
  component "BatchProgress Dashboard" as dashboard <<external>>
}

package "Repair & Validation Tooling" {
  component "repair-writer-ontology-class.mjs" as repairScript <<cli>>
  component "obs-api" as obsApi <<api>>
  database "km-core LevelDB" as levelDB
  component "SemanticAnalysisAgent" as semAgent <<agent>>
}

codingLower --> ontReg : "source classification"
ontReg --> classifier : "L1/L2 refinement"
classifier ..> "CodingLowerOntologySource Bug" : "unexpected emission"

ontFactory --> legacyAdapter : "requires"
legacyAdapter --> ontReg : "wraps (migration seam)"
ontFactory --> classifier : "wires validator/classifier"

healthCoord --> pollKP : "5s tick"
pollKP --> classifier : "monitors freshness"
healthCoord --> graphIntegrity : "slower interval scan"
dashboard --> healthCoord : "polls :3033 REST"

repairScript --> obsApi : "HTTP only (thin client)"
obsApi --> levelDB : "single-owner store"
repairScript --> classifier : "arbitrate() conflict resolution"
semAgent --> classifier : "feeds taxonomy validation"

@enduml