@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Ingestion" {
  component "Git History\n(fetch/diff/extract)" as git <<agent>>
}

package "Semantic Analysis Pipeline" {
  component "Content Parsing\n(rule-based)" as parse <<core>>
  component "Entity Extraction\n(LLM NER)" as extract <<agent>>
  component "Relation Discovery\n(LLM)" as relate <<agent>>
  component "Context Enrichment\n(fast LLM)" as enrich <<agent>>
}

package "KG Operators" {
  component "Embed / Dedup / Merge" as kgops <<core>>
}

package "Pipeline Execution & Health" {
  component "run_pipeline / full_pipeline" as runner <<cli>>
  component "pollKnowledgePipeline" as health <<api>>
}

git --> parse : "raw commit diffs"
parse --> extract : "Parsed content"
extract --> relate : "Entities"
relate --> enrich : "Entity relations"
enrich --> kgops : "Enriched entities\n+ Observations"

runner --> parse : "orchestrates"
runner --> kgops : "orchestrates"
health --> runner : "monitors"

@enduml