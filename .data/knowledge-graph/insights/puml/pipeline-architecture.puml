@startuml
!include _standard-style.puml

package "Ontology Core" {
  component "createOntologySystem()" as factory <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "OntologyClassificationAgent" as classifier <<agent>>
  database "coding.lower.json" as codinglower <<storage>>
}

package "Data Quality & Repair" {
  component "repair-writer-ontology-class.mjs" as repair <<cli>>
  component "arbitrate()" as arbitrate <<core>>
}

package "Monitoring & Health" {
  component "health-coordinator.js" as health <<agent>>
  component "knowledge_pipeline slot" as kpslot <<storage>>
  component "graph_integrity probe" as gintegrity <<core>>
  component "batch-progress.tsx" as dashboard <<external>>
}

factory --> adapter : "requires (fail-fast)"
adapter --> classifier : "wires legacy shape"
classifier --> codinglower : "reads for L2 refinement"
classifier ..> codinglower : "emits CodingLowerOntologySource (bug)"

repair --> codinglower : "reads/repairs schema"
repair --> arbitrate : "resolves ontologyClass vs entity Type"

health --> kpslot : "tracks pipeline freshness"
health --> gintegrity : "separates orphans/stranded"
gintegrity ..> classifier : "detects output quality issues"
dashboard --> health : "reads state via HTTP"

codinglower ..> repair : "shared-schema coupling"

@enduml