@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Pipeline Orchestration" {
  component "Coordinator Agent" as coord <<agent>>
  component "BaseAgent" as base <<core>>
  component "OntologyClassificationAgent" as onto <<agent>>
  component "SemanticAnalysisAgent" as sem <<agent>>
}

package "Analysis Stages" {
  component "AgentResponse Envelope" as resp <<core>>
  component "Observation Accumulator" as obs <<core>>
  component "Deduplication Logic" as dedup <<core>>
}

package "Persistence" {
  component "Persistence Agent" as persist <<agent>>
  database "Knowledge Graph" as kg <<storage>>
}

coord --> base : "extends"
onto --> base : "extends"
sem --> base : "extends"

coord --> onto : "invokes"
coord --> sem : "invokes"

base --> resp : "wraps output"
onto --> resp : "produces"
sem --> resp : "produces"

resp --> obs : "accumulates"
obs --> dedup : "two-phase dedup"
dedup --> kg : "merge"

resp --> persist : "confidence/issue metadata"
persist --> kg : "write or flag for review"

@enduml