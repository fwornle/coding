@startuml
!include _standard-style.puml

package "SemanticAnalysis Pipeline (unresolved)" {
  component "SemanticAnalysisAgent" as saa <<agent>>
  component "OntologyClassificationAgent" as oca <<agent>>
  component "CodingLowerOntologySource\n(unexpected emission)" as bugsrc <<core>>
}

package "Ontology Composition Root" {
  component "createOntologySystem()" as factory <<core>>
  component "OntologyValidator" as validator <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  database "km-core OntologyRegistry" as registry <<storage>>
}

package "Maintenance & Monitoring (unrelated)" {
  component "repair-writer-ontology-class.mjs\n(arbitrate)" as repair <<cli>>
  component "health-coordinator.js\n(pollKnowledgePipeline)" as health <<agent>>
  cloud "obs-api / LevelDB" as obsapi <<external>>
}

saa --> oca : "classifies intent"
oca --> bugsrc : "emits (bug: contract violation)"

factory --> validator : "wires"
factory --> classifier : "wires"
factory --> adapter : "wires"
adapter --> registry : "wraps"

repair --> obsapi : "fetch entities/relations"
repair --> registry : "arbitrate() conflicts"

health --> obsapi : "poll freshness"
health ..> bugsrc : "unrelated (name collision only)"

oca ..> factory : "conceptually adjacent\n(not same file)"

@enduml