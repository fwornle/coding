@startuml
!include _standard-style.puml

package "Hook Abstraction Layer" {
  component "HooksManager\n(abstract base)" as hooksApi <<core>>
  component "registerHook()\npush-then-sort" as regHook <<core>>
  component "HookEvent Map\n(eager pre-populate)" as hookMap <<storage>>
}

package "Claude Bridge Process" {
  component "claude-bridge.js\n(stdin/stdout)" as bridge <<external>>
  component "EVENT_MAP\ntranslation table" as eventMap <<core>>
  component "getHookManager()\n(hook-manager.js)" as hookManager <<core>>
}

package "Adjacent / Unrelated Domains" {
  component "Copilot EVENT_MAPPINGS\n(version-adaptive)" as copilotMap <<external>>
  component "System-Health-Dashboard\nReact hooks (unrelated)" as reactHooks <<external>>
}

hooksApi --> hookMap : "pre-populates on construct"
hooksApi --> regHook : "validates + inserts"
regHook --> hookMap : "sorted by priority"

bridge --> eventMap : "maps native events"
eventMap --> hookManager : "dispatches unified event"
bridge ..> hooksApi : "shares unified vocabulary"

eventMap ..> copilotMap : "version-adaptive translation\n(POST_PROMPT unsupported)"

reactHooks ..> hooksApi : "naming collision only\n(no functional relation)"

@enduml