@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Agent Hook Layer" {
  component "HooksManager" as hm <<core>>
  component "EVENT_MAPPINGS" as em <<core>>
  component "ClaudeBridge" as bridge <<agent>>
  component "HookManager\n(hook-manager.js)" as mgr <<core>>
}

package "CLI Gating Layer" {
  component "require-feature.sh" as guard <<cli>>
  component "Guarded CLIs\n(semantic/graphify/constraints)" as clis <<cli>>
}

package "Dashboard Hook Layer" {
  component "usePolledFetch" as poll <<core>>
  component "useRecentCalls\n(subscribers)" as sub <<core>>
  component "Routing Tab UI" as routing <<external>>
}

cloud "Claude Code stdin/stdout" as claude <<external>>

hm --> em : "translateEvent()"
hm --> mgr : "registerHook/triggerHook"
bridge --> mgr : "getHookManager() (dynamic import)"
claude --> bridge : "hook JSON protocol"
bridge --> claude : "decision: allow (fail-open)"

clis --> guard : "require_feature <name>"
guard --> clis : "exit 2 if disabled\n(fail-open on guard error)"

poll --> sub : "shared interval pattern"
routing --> poll : "enabled: !draftDirty"
poll --> routing : "immediate refresh on resume"

@enduml