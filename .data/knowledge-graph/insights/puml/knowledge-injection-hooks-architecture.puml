@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Claude Code Hook" {
  component "knowledge-injection-hook.js" as hook <<core>>
  component "isInjectionEnabled()" as gate <<core>>
  component "extractConversationTopics()" as extract <<core>>
  component "SAFETY_TIMEOUT_MS Guard" as timeout <<core>>
}

package "PI Agent Hook" {
  component "knowledge-injection-pi.js" as pihook <<core>>
  component "Query Builder" as querybuild <<core>>
  component "AGENTS.md Writer" as writer <<core>>
}

package "External Resources" {
  database "Session Transcript" as transcript <<storage>>
  component "git diff HEAD~3" as gitdiff <<external>>
  cloud "Retrieval Service" as retrieval <<external>>
  component "Output Truncator (16000 chars)" as trunc <<core>>
}

hook --> gate : "checks CODING_KNOWLEDGE_INJECTION"
hook --> extract : "on enabled"
extract --> transcript : "reads last 50000 bytes"
hook --> timeout : "enforces 5s/15s deadline"
timeout --> hook : "force-exits if hung"

pihook --> querybuild : "builds query"
querybuild --> gitdiff : "fetches changed files"
querybuild --> retrieval : "sends query + context"
retrieval --> trunc : "raw results"
trunc --> pihook : "trimmed output"
pihook --> writer : "writes AGENTS.md"
writer ..> writer : "refuses if PI_CODING_AGENT_DIR is ~/.pi/agent"

hook ..> hook : "fail-open on parse error"
pihook ..> pihook : "fail-open, exit(0) on error"

@enduml