@startuml
!include _standard-style.puml

package "HealthCoordinator Core" {
  component "health-coordinator.js\n(currentState SoT)" as hc <<core>>
  component "HTTP Gateway\n(/health, /signals, /refresh)" as api <<api>>
  component "5s Tick Scheduler" as tick <<core>>
  component "Injection Test Harness\n(shouldInject, injectionFlags)" as inject <<core>>
}

package "Check Registries" {
  component "graph_integrity\n(slow interval)" as gi <<core>>
  component "sub_agent_capture" as sac <<core>>
  component "health-verification-rules.json" as rules <<storage>>
}

package "External Sources" {
  component "structural-anchors.mjs\n(fetchAndAudit)" as anchors <<external>>
  component "Knowledge Graph" as kg <<storage>>
  database "Heartbeat Files\n(claude/opencode/copilot)" as hb
  component "repair-writer-ontology-class.mjs\n(arbitrate)" as arbitrate <<external>>
}

api --> hc : "reads/writes"
hc --> tick : "drives"
tick --> rules : "loads check registry"
tick --> gi : "runs (slower interval)"
tick --> sac : "runs (5s)"
hc --> inject : "fault simulation"
inject ..> gi : "injects failure"
gi --> anchors : "invokes"
anchors --> kg : "audits orphans/stranded"
sac --> hb : "reads heartbeats"
arbitrate --> kg : "graph-edge arbitration"
hc ..> arbitrate : "ontology-adjacent\n(cross-cutting)"

@enduml