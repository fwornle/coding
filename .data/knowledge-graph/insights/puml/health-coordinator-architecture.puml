@startuml
!include _standard-style.puml

package "HealthCoordinator API" {
  component "HTTP Gateway\n(0.0.0.0)" as http <<api>>
  component "currentState\n(in-memory SoT)" as state <<core>>
}

package "Tick Scheduler" {
  component "TICK_MS Loop\n(5s)" as tick <<core>>
  component "Check Registry" as registry <<core>>
  component "Slow Interval Probe\n(graph_integrity)" as slow <<core>>
}

package "Config & Fault Injection" {
  database "health-verification-rules.json" as rules <<storage>>
  component "FORBIDDEN_RULE_NAMES\nGuard" as forbidden <<core>>
  component "shouldInject()\n(env + Map flags)" as inject <<core>>
}

package "Contract Testing" {
  component "health-coordinator-etm-expected.test.mjs" as tests <<cli>>
}

http --> state : "GET /health, /health/state"
http --> state : "POST /signals, /health/refresh"
tick --> registry : "iterates checks"
registry --> rules : "loads rule config"
registry --> forbidden : "filters skipped rules"
tick --> state : "writes status per subsystem"
slow --> state : "writes graph_integrity"
inject --> tick : "fault injection hook"
tests ..> tick : "regex-validates ETM invariants"
tests ..> state : "regex-validates stall clock fields"

@enduml