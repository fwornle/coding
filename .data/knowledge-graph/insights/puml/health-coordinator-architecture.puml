@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Health Coordination" {
  component "Health Coordinator" as hc <<core>>
  component "Service Probe Lib" as probe <<core>>
  component "Health Verification Rules" as rules <<storage>>
}

package "Probe Targets" {
  component "HTTP Health Probe" as httpProbe <<api>>
  component "TCP Port Probe" as tcpProbe <<api>>
  component "Dockerized Service Fleet" as fleet <<external>>
}

package "Consumers" {
  component "Global Service Coordinator" as gsc <<agent>>
}

hc --> rules : "reads probe config\n(type, endpoint, thresholds)"
hc --> probe : "invokes every 5s"
probe --> httpProbe : "probeHttpHealth()"
probe --> tcpProbe : "probeTcpPort()"
httpProbe --> fleet : "checks"
tcpProbe --> fleet : "checks"
hc --> hc : "SPEC R6:\nconservative multi-check\nconfirmation"
gsc --> hc : "queries aggregated\nhealth state"

@enduml