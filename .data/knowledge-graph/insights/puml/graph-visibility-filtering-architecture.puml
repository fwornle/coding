@startuml
!include _standard-style.puml

package "Core Predicate" {
  component "isEntityVisible /\nVisibilityFilters" as pred <<core>>
}

package "Live Rendering" {
  component "useGraphVisibility" as hook <<core>>
  component "D3GraphCanvas.tsx" as canvas <<core>>
  component "viewer-store.ts\n(default filters)" as store <<core>>
}

package "Offline Audit" {
  component "assert-graph-density.ts" as gate <<cli>>
  component "DEFAULT_FILTERS\n(reconstructed)" as defaults <<core>>
}

package "Hierarchy Attribution" {
  component "deriveParents /\nrootOf" as hierarchy <<core>>
  component "attribution.test.ts" as tests <<core>>
}

canvas --> hook : "computes isVisible"
hook --> pred : "wraps predicate"
store --> hook : "supplies live filter state"

gate --> pred : "imports directly"
gate --> defaults : "re-derives store defaults"
defaults ..> store : "drift risk (unshared state)"

gate --> hierarchy : "attributes visible nodes\nto Project/System"
hierarchy --> tests : "validated by"

@enduml