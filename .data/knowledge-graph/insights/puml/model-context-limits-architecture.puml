@startuml
!include _standard-style.puml

package "Sources" {
  database "models.dev catalogue" as catalogue <<external>>
  component "opencode.json (user config)" as userconfig <<external>>
}

package "model-limits.cjs" {
  component "limits()" as limits <<core>>
  component "deriveLimits()" as derive <<core>>
  component "byPair / byModel maps" as maps <<storage>>
  component "FALLBACK_PROVIDERS" as fallback <<core>>
  component "userConfigContextWindow()" as userwin <<core>>
  component "catalogueContextWindow()" as catwin <<core>>
  database "on-disk derived cache" as diskcache <<storage>>
}

package "Consumer" {
  component "status-line gauge (context-gauge.cjs)" as gauge <<cli>>
}

catalogue --> limits : "stat mtime+size"
limits --> diskcache : "read/write atomic temp+rename"
limits --> derive : "on cache miss"
derive --> fallback : "resolve custom provider ids"
derive --> maps : "modal tie-break (favor larger)"

userconfig --> userwin : "override lookup"
maps --> catwin : "exact/modal fallback"
userwin --> catwin : "tier 1 precedence"

catwin --> gauge : "context size or null"
gauge --> gauge : "regex fallback if null"

@enduml