@startuml
!include _standard-style.puml

package "Missing Component" {
  component "ModelContextLimits\n(not found in codebase)" as mcl <<core>>
}

package "LLM Routing Dashboard Surface" {
  component "cost-model.ts\npriceForModel()" as cost <<core>>
  component "offload-decision.tsx\nevaluateOffload()" as offload <<core>>
  component "use-classifier-judge.ts" as judge <<core>>
  component "provider.tsx\n(Redux)" as provider <<core>>
}

package "Model ID Lifecycle" {
  component "copilot-model-ids.test.mjs" as idtest <<cli>>
  component "align-copilot-model-ids.mjs" as aligner <<core>>
}

cloud "@rapid/llm-proxy" as proxy <<external>>

cost ..> mcl : "no context-window\nlookup present"
offload ..> mcl : "routes by complexity band,\nnot token ceiling"
judge --> offload : "rubric/backend check"
provider --> offload : "state container"

idtest --> aligner : "asserts rewrite"
aligner --> proxy : "rewrites retired\nmodel ids before ship"

@enduml