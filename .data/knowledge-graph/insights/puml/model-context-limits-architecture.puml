@startuml
!include _standard-style.puml

package "Missing Component" {
  component "ModelContextLimits\n(not found in codebase)" as mcl <<core>>
}

package "LLM Routing (system-health-dashboard)" {
  component "cost-model.ts\nmodelPrices/priceForModel" as cost <<core>>
  component "offload-decision.tsx\nGATES/evaluateOffload" as offload <<agent>>
  component "use-classifier-judge.ts\nJudge/JudgeBackend" as judge <<agent>>
}

package "Unrelated / Noise" {
  component "provider.tsx\nReduxProvider" as store <<core>>
  component "copilot-model-ids.test.mjs\nid drift guard" as idtest <<cli>>
}

database "BudgetTracker\n(usage/token accounting)" as budget <<storage>>

cost ..> budget : "reports $ pricing,\nnot token limits"
offload --> judge : "complexity-band\nrouting"
judge ..> cost : "adjacent domain,\nno context-size logic"
mcl ..> cost : "closest structural\nanalog (family fallback)"
mcl ..> offload : "different axis:\ncomplexity vs size"
store ..> mcl : "retrieval noise\n(no LLM logic)"
idtest ..> mcl : "id validity only,\nnot limits"

@enduml