@startuml
!include _standard-style.puml

package "Ontology Subsystem (src/ontology/index.ts)" {
  component "createOntologySystem\n(factory)" as factory <<core>>
  component "validateOntologyConfig" as validator_fn <<core>>
  component "OntologySystem\n(interface)" as system <<core>>
}

package "Core Components" {
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "OntologyValidator" as ovalidator <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "createHeuristicClassifier\n(heuristics/index.ts)" as heuristic <<core>>
  component "OntologyConfigManager" as configmgr <<core>>
}

package "External / Consumers" {
  component "km-core OntologyRegistry" as registry <<external>>
  component "OntologyClassificationAgent" as agent <<agent>>
  component "coding.lower.json\n(L2 refinement source)" as codinglower <<storage>>
}

factory --> adapter : "requires (no mock fallback)"
factory --> ovalidator : "assembles"
factory --> classifier : "assembles"
factory --> heuristic : "assembles"
factory --> system : "produces"

validator_fn --> configmgr : "checks upper/lower paths"
validator_fn ..> factory : "pre-flight, decoupled"

adapter --> registry : "wraps"
agent --> adapter : "constructs (shared adapter pattern)"

codinglower --> registry : "feeds classification"
registry --> classifier : "used by"

ovalidator --> adapter : "operates via"
classifier --> adapter : "operates via"

@enduml