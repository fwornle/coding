@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Classification Agent Sub-Steps" {
  component "Class Matching" as match <<agent>>
  component "Classification Validation" as validate <<agent>>
  component "Ontology Auto-Extension" as extend <<agent>>
}

package "Ontology Core" {
  component "Ontology" as ontClass <<core>>
  component "OntologyConfigManager" as configMgr <<core>>
  component "ontologyPathResolver" as pathResolver <<core>>
  component "GraphKMStore.ontology" as kmStore <<core>>
}

package "Ontology Data & Tools" {
  database "KG_ONTOLOGY_DIR" as ontDir <<storage>>
  component "handleOntologyClasses" as apiHandler <<api>>
  component "collectByOntologyClass" as collector <<core>>
  component "resolveOntologyDir" as resolveDir <<core>>
}

match --> validate : "classifications"
validate --> extend : "unclassified entities"

match --> ontClass : "queries classes"
validate --> ontClass : "checks constraints"
extend --> ontClass : "new class suggestions"

ontClass --> configMgr : "configured by"
configMgr --> pathResolver : "resolves paths"
pathResolver --> ontDir : "locates"

apiHandler --> ontClass : "exposes"
collector --> ontDir : "reads from"
resolveDir --> ontDir : "resolves"
kmStore --> ontClass : "manages"

@enduml