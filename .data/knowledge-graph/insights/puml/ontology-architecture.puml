@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Classification" {
  component "OntologyClassificationAgent" as agent <<agent>>
  component "OntologyClassifier (LLM)" as llmClassifier <<agent>>
  component "HIERARCHY_ROOTS Guards" as roots <<core>>
}

package "L2 Refinement" {
  component "L2 Refinement Layer" as l2 <<core>>
  component "loadL2Classes" as loadL2 <<core>>
  component "buildL2RefinementPrompt" as buildPrompt <<core>>
  component "extractL2FromLLMResponse" as extractL2 <<core>>
  database "coding.lower.json" as lowerJson
}

package "Validation & Storage" {
  component "OntologyValidator" as validator <<core>>
  component "GraphKMStore.ontology()" as graphStore <<storage>>
  database "Ontology Registry" as registry
}

agent --> llmClassifier : "delegates classification"
agent --> roots : "checks closed-set entities"
agent --> l2 : "requests L2 refinement"

l2 --> loadL2 : "loads subsystem classes"
l2 --> buildPrompt : "constructs LLM prompt"
l2 --> extractL2 : "parses LLM response"
loadL2 --> lowerJson : "reads"
extractL2 ..> lowerJson : "graceful degradation if absent"

agent --> validator : "submits entity for validation"
validator --> lowerJson : "validates against class/hierarchy"
validator --> graphStore : "accepts entity"
graphStore --> registry : "persists ontology data"

@enduml