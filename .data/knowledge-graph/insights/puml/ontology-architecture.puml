@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Extraction" {
  component "Semantic Analysis Agent" as sem <<agent>>
}

package "Ontology Classification" {
  component "Ontology Classification Agent" as ont <<agent>>
  component "Upper Ontology" as upper <<core>>
  component "Lower Ontology" as lower <<core>>
  component "Entity Type Resolver" as resolver <<core>>
  component "Validation Routines" as validator <<core>>
}

package "Pipeline" {
  component "Persistence Stage" as persist <<storage>>
}

sem --> ont : "produces entities"
ont --> resolver : "resolve most specific class"
resolver --> upper : "domain-independent categories"
resolver --> lower : "domain-specific types"
resolver --> validator : "classified entities"
validator --> persist : "validated entities"

@enduml