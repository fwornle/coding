@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Path Resolution & Config" {
  component "ontologyPathResolver.ts" as resolver <<core>>
  component "OntologyConfigManager.ts" as configMgr <<core>>
  component "OntologyPathNotFoundError" as pathErr <<core>>
}

package "Classification & API" {
  component "OntologyClassificationAgent" as classifier <<agent>>
  component "ApiClient.ts" as apiClient <<api>>
  component "OntologyClass / Entity Types" as typedApi <<api>>
}

package "Viewer / UI" {
  component "OntologyFilter.tsx" as filterUI <<external>>
  component "VOKB_SCHEMA" as schema <<core>>
  component "viewer-store.ts" as viewerStore <<core>>
}

database "Ontology JSON Files\n(upper/coding.lower/coding)" as ontJson

configMgr --> resolver : "resolves paths via"
resolver --> ontJson : "cached filesystem lookup"
resolver --> pathErr : "throws on missing file"
classifier --> configMgr : "loads ontology definitions"
classifier --> ontJson : "closed-vocabulary classification"

apiClient --> typedApi : "exposes"
apiClient --> classifier : "surfaces classified entities"

filterUI --> schema : "imports"
filterUI --> viewerStore : "persists selection via useViewerStore"
filterUI --> typedApi : "consumes OntologyClass metadata"

schema ..> ontJson : "should mirror (no shared-source enforcement)"

@enduml