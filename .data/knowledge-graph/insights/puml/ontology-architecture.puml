@startuml
!include _standard-style.puml

package "Ontology Factory" {
  component "createOntologySystem" as factory <<core>>
  component "OntologySystem" as system <<core>>
  component "validateOntologyConfig" as validator <<core>>
  component "LegacyOntologyAdapter" as adapter <<agent>>
  component "OntologyClassifier" as classifier <<agent>>
  component "createHeuristicClassifier" as heuristic <<agent>>
  component "UnifiedInferenceEngine" as inference <<external>>
}

package "km-core Storage" {
  database "OntologyRegistry" as registry <<storage>>
  database "LevelDB (obs-api)" as leveldb <<storage>>
}

package "Repair & Pipeline Tools" {
  component "repair-writer-ontology-class.mjs" as repair <<cli>>
  component "arbitrate()" as arbitrate <<core>>
  component "OntologyClassificationAgent" as pipeline <<agent>>
  component "observations-api-server.mjs" as obsapi <<api>>
}

validator --> factory : "checked before"
factory --> adapter : "wires"
factory --> classifier : "wires"
factory --> inference : "requires (hard-fail)"
classifier --> heuristic : "composes"
factory --> system : "returns"
system --> adapter : "field: ontology"
adapter --> registry : "wraps"

repair --> obsapi : "HTTP only"
obsapi --> leveldb : "single-owner access"
repair --> arbitrate : "resolves conflicts"
arbitrate --> registry : "edge-type derived class"

pipeline --> registry : "consumes coding.lower.json"
pipeline ..> repair : "downstream inconsistencies"

@enduml