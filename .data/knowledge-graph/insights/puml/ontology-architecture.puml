@startuml
!include _standard-style.puml

package "Ontology System (src/ontology/index.ts)" {
  component "createOntologySystem()" as factory <<core>>
  component "validateOntologyConfig()" as validator_fn <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "OntologyValidator" as validatorC <<core>>
  component "LegacyOntologyAdapter" as adapter <<adapter>>
  component "createHeuristicClassifier\n(heuristics/index.ts)" as heuristic <<core>>
  component "OntologyConfigManager" as config <<core>>
  component "ontologyPathResolver\n(+ probe/cache instrumentation)" as resolver <<core>>
}

package "External Backends" {
  database "km-core OntologyRegistry" as kmcore <<storage>>
  component "persistence-agent.ts" as persAgent <<agent>>
  component "external inferenceEngine" as inference <<external>>
}

package "API / Consumers" {
  component "ApiClient (OntologyClass,\nlistOntologyClasses)" as apiclient <<api>>
  component "GraphKMStore.ontology()" as graphstore <<core>>
  component "observations-api-server.mjs\n(KG_ONTOLOGY_DIR)" as obsserver <<api>>
}

factory --> adapter : "requires (fail-fast)"
factory --> inference : "requires (fail-fast)"
factory --> validatorC : "wires"
factory --> classifier : "wires"
factory --> heuristic : "wires"

classifier --> validatorC : "depends on"
classifier --> heuristic : "uses"
classifier --> inference : "delegates inference"

adapter --> kmcore : "wraps (Adapter pattern)"
adapter ..> persAgent : "preserves legacy call sites"

validator_fn --> config : "enforces upper/lower rules"
config --> resolver : "loads paths"

apiclient --> factory : "consumes"
graphstore --> factory : "consumes"
obsserver --> config : "reads KG_ONTOLOGY_DIR"

@enduml