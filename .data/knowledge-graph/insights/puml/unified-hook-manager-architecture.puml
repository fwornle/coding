@startuml
!include _standard-style.puml

package "Agent API Hooks" {
  component "UnifiedHookManager" as uhm <<core>>
  component "hook-config.js\nvalidateConfig()" as hookconfig <<core>>
}

package "Health Monitoring" {
  component "health-prompt-hook.js" as healthhook <<cli>>
  component "deriveSummary()" as derive <<core>>
  database "Health Coordinator\n/health/state" as coordinator <<external>>
}

package "Dashboards" {
  component "Next.js constraint-monitor\ndashboard" as constraintdash <<external>>
  component "Vite system-health\ndashboard" as healthdash <<external>>
  component "tmux statusline\n(constraints tab)" as statusline <<cli>>
}

uhm --> hookconfig : "fail-soft config\nvalidation"
uhm ..> statusline : "dispatches violation\nhandlers (unverified path)"

healthhook --> coordinator : "polls HTTP state"
healthhook --> derive : "computes status"
derive ..> derive : "refuses silent\n'healthy' (SPEC R6)"

healthhook --> constraintdash : "feeds violation data"
healthhook --> healthdash : "feeds health data"

statusline --> constraintdash : "click opens/focuses tab"

@enduml