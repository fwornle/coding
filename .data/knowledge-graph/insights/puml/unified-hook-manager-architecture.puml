@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration" {
  component "HookConfigLoader" as loader <<core>>
  database "hooks.json" as hooksjson
}

package "UnifiedHookManager" {
  component "Handler Registry\n(priority-sorted per event)" as registry <<core>>
  component "Dispatch Logic" as dispatch <<core>>
  component "Handler-Type Resolver" as resolver <<core>>
}

package "Handler Execution" {
  component "Script Handler" as script <<external>>
  component "Command Handler" as command <<external>>
  component "Module Handler" as module <<core>>
  component "Agent-Scoped Handler" as agent <<agent>>
}

hooksjson --> loader : "raw config"
loader --> registry : "merged config"
registry --> dispatch : "priority order"
dispatch --> resolver : "handler type"
resolver --> script : "invokes"
resolver --> command : "invokes"
resolver --> module : "invokes"
resolver --> agent : "scoped dispatch"

@enduml