@startuml
!include _standard-style.puml

package "Hook System (Unverified Internals)" {
  component "UnifiedHookManager" as uhm <<core>>
  component "hook-manager.js" as hmfile <<core>>
}

package "Sibling Hook (Verified)" {
  component "health-prompt-hook.js" as hph <<cli>>
  component "deriveSummary()" as ds <<core>>
}

package "Adjacent Subsystems" {
  component "Coordinator (HTTP)" as coord <<external>>
  component "require-feature.sh" as feat <<cli>>
  component "bin/constraints" as binc <<cli>>
  component "Constraint-Monitor Dashboard" as cmd <<external>>
  component "Statusline Click-Report" as sl <<external>>
}

uhm ..> hmfile : "defined in (no bodies known)"

hph --> coord : "fetches health state"
hph --> ds : "reduces to summary"
hph ..> uhm : "sibling, no direct call"

feat --> binc : "gates execution"

uhm ..> cmd : "constraint violations (inferred)"
sl --> cmd : "click-to-focus"
hph ..> sl : "status feeds (inferred)"

@enduml