@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Claude Adapter Layer" {
  component "claude-bridge.js" as bridge <<agent>>
  component "EVENT_MAP" as eventMap <<core>>
  component "transformContext()" as transform <<core>>
}

package "Unified Hook System" {
  component "UnifiedHookManager" as manager <<core>>
  database "Handler Registry\n(Map<event,Handler[]>)" as registry <<storage>>
}

package "Legacy/Parallel System" {
  component "HooksManager\n(hooks-api.js)" as legacy <<core>>
  component "EVENT_MAPPINGS" as legacyMap <<core>>
}

component "ViolationCaptureService" as violation <<api>>

bridge --> eventMap : "translates event names"
bridge --> transform : "builds unifiedContext"
transform --> manager : "spreads raw metadata (no sanitization)"
bridge --> manager : "getHookManager().executeHooks()"
manager --> registry : "priority-sorted lookup"
manager ..> violation : "possible downstream sanitization?"

legacy --> legacyMap : "per-agentType translation"
legacy --> registry : "parallel Map<event,Handler[]>"
manager ..> legacy : "divergent implementation risk"

bridge ..> bridge : "fail-open: default 'allow' on error"
legacy ..> legacy : "fail-soft: try/catch per handler"

@enduml