@startuml
!include _standard-style.puml

package "Claude Code Integration" {
  component "claude-bridge.js" as bridge <<core>>
  component "EVENT_MAP\n(transformContext/transformResponse)" as eventmap <<core>>
}

package "Hook Manager Layer" {
  component "getHookManager()\n(singleton accessor)" as accessor <<api>>
  component "UnifiedHookManager\n(hook-manager.js)" as uhm <<core>>
  component "HooksManager\n(hooks-api.js, abstract base)" as hooksapi <<core>>
}

package "HookManagementSystem (Session)" {
  component "Statusline Click-Report\n(constraints focus)" as statusline <<core>>
  component "Tmux Pane Badge\n(ETM entry selection)" as etm <<core>>
}

database "Hook Registry\n(Map<HookEvent, HookHandler[]>)" as registry <<storage>>

bridge --> eventmap : "translate native events"
eventmap --> accessor : "dynamic import ./hook-manager.js"
accessor --> uhm : "lazy init"
bridge --> uhm : "initialize(projectPath)"
bridge --> uhm : "executeHooks(event, context, 'claude')"
uhm --> registry : "register/sort/dispatch by priority"
hooksapi ..> uhm : "shared idiom (pre-populate + push-sort)"

statusline ..> uhm : "adjacent UI dispatch"
etm ..> uhm : "adjacent session-selection concern"

bridge --> bridge : "fail-open catch\n(decision:allow, exit(0))"

@enduml