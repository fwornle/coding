@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Gating Layer" {
  component "docker/entrypoint.sh" as entrypoint <<core>>
  component "supervisord" as supervisord <<core>>
}

package "Wrapper Scripts" {
  component "api-service.js" as apiService <<cli>>
  component "dashboard-service.js" as dashboardService <<cli>>
}

package "Registry Core" {
  component "ProcessStateManager" as psm <<core>>
}

component "constraint-api child" as apiChild <<agent>>
component "constraint-dashboard child" as dashChild <<agent>>

entrypoint --> supervisord : "feature-gates programs"
supervisord --> apiService : "spawns (if enabled)"
supervisord --> dashboardService : "spawns (if enabled)"

apiService --> apiChild : "spawn"
dashboardService --> dashChild : "spawn"

apiService ..> psm : "dynamic import + registerService('global')"
dashboardService ..> psm : "dynamic import + registerService('global')"

apiChild ..> apiService : "exit event"
dashChild ..> dashboardService : "exit event"

apiService ..> psm : "unregisterService('global') on exit"
dashboardService ..> psm : "unregisterService('global') on exit"

@enduml