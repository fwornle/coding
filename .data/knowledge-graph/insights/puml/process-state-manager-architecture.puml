@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Wrapper Scripts" {
  component "api-service.js" as api <<agent>>
  component "dashboard-service.js" as dash <<agent>>
}

package "Process State Manager" {
  component "process-state-manager.js" as psm <<core>>
  database "PSM State\n(PID, name, start time)" as state <<storage>>
}

package "Process Contexts" {
  component "Docker-contained Process" as docker <<external>>
  component "Standalone Node Process" as node <<external>>
}

component "Global Service Coordinator" as gsc <<core>>

api --> docker : "spawns"
dash --> node : "spawns"

api --> psm : "register() after spawn"
dash --> psm : "register() after spawn"

api ..> psm : "unregister() on SIGTERM/SIGINT"
dash ..> psm : "unregister() on SIGTERM/SIGINT"

psm --> state : "updates"
gsc --> psm : "queries source of truth"

@enduml