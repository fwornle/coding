@startuml
!include _standard-style.puml

package "Startup Orchestration" {
  component "start-services-robust.js" as ssr <<core>>
  component "SERVICE_CONFIGS/ORDER" as sc <<core>>
}

package "Process State Layer" {
  component "ProcessStateManager" as psm <<core>>
  component "pgrep OS Scan" as pgrep <<external>>
}

package "Parallel Gating Authority" {
  component "entrypoint.sh" as ep <<cli>>
  database "features.json" as feat
  component "supervisord" as sup <<external>>
}

package "Managed Services" {
  component "api-service.js / dashboard-service.js" as wrap <<agent>>
  component "transcript-monitor" as tm <<agent>>
}

ssr --> sc : "reads service configs"
ssr --> psm : "instantiates singleton"
ssr --> psm : "isServiceRunning(name, scope, opts)"
psm ..> pgrep : "falls back to raw scan\n(not sole source of truth)"
ssr --> pgrep : "isProcessRunningByScript()"
pgrep --> psm : "registerService() reconciles orphan"
ssr --> tm : "spawns if not running"

wrap --> psm : "registerService() on spawn"
wrap --> psm : "unregisterService() on exit"
sup --> wrap : "tracks wrapper PID only"

ep --> feat : "reads snapshot"
feat --> ep : "may drift to logging-only"
ep --> sup : "autostart=false override"

psm ..> ep : "no shown integration\n(parallel gating authority)"

@enduml