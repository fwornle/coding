@startuml
!include _standard-style.puml

package "Service Orchestration" {
  component "start-services-robust.js" as ssr <<core>>
  component "startOneService (startFn)" as startfn <<core>>
  component "SERVICE_CONFIGS / SERVICE_ORDER" as configs <<core>>
}

package "Process State Layer" {
  component "ProcessStateManager" as psm <<core>>
  database "Service Registry\n(name/type keyed)" as registry <<storage>>
}

package "OS-Level Verification" {
  component "pgrep / isProcessRunningByScript" as pgrep <<external>>
}

component "service-gating.test.mjs" as tests <<cli>>

ssr --> psm : "instantiates\nnew ProcessStateManager()"
ssr --> configs : "drives service order"
ssr --> startfn : "invokes per service"

startfn --> psm : "isServiceRunning(name, type)"
psm --> registry : "reads/writes"

startfn --> pgrep : "fallback check\nif PSM reports absent"
pgrep --> psm : "registerService(...)\n(orphan re-registration)"

tests ..> startfn : "exercises via configs"
tests ..> configs : "imports SERVICE_CONFIGS"
tests ..> psm : "NOT covered\n(gap)"

@enduml