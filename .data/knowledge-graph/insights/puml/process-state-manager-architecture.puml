@startuml
!include _standard-style.puml

package "Orchestration Layer" {
  component "start-services-robust.js" as orchestrator <<core>>
  component "SERVICE_CONFIGS\n(transcriptMonitor.startFn)" as serviceConfigs <<core>>
  component "service-starter.js\n(startServiceWithRetry)" as serviceStarter <<core>>
}

package "Process State Manager" {
  component "ProcessStateManager\n(singleton psm)" as psm <<core>>
  database "PID Registry\n(name+scope+projectPath)" as registry <<storage>>
}

package "OS-Level Verification" {
  component "isProcessRunningByScript\n(pgrep -lf)" as pgrep <<external>>
}

package "Wrapper Services" {
  component "api-service.js" as apiService <<agent>>
  component "dashboard-service.js" as dashboardService <<agent>>
}

component "service-gating.test.mjs\n(stubs startFn)" as tests <<cli>>

orchestrator --> serviceConfigs : "defines"
orchestrator --> psm : "instantiates\nconst psm = new ProcessStateManager()"
serviceConfigs --> psm : "isServiceRunning(name, scope)"
psm --> registry : "queries/updates"
serviceConfigs --> pgrep : "fallback liveness check"
pgrep ..> psm : "registerService()\n(orphan re-registration)"

apiService --> psm : "registerService()\n(post-spawn)"
dashboardService --> psm : "registerService()\n(post-spawn)"
serviceStarter ..> psm : "possible implicit registration"

tests ..> serviceConfigs : "stubs startFn\n(bypasses PSM)"

@enduml