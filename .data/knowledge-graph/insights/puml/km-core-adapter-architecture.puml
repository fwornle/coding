@startuml
!include _standard-style.puml

package "Backend Ingestion" {
  component "KmCoreAdapter" as kmcore <<core>>
  component "GraphifyGraph" as graphify <<core>>
  component "wave-controller.ts" as wavectl <<core>>
  component "migrate-leveldb-to-kmcore.mjs" as migrate <<cli>>
  database "graph.json" as graphjson
}

package "Dashboard Visualization" {
  component "multi-agent-graph.tsx\n(AGENT_SUBSTEPS)" as magraph <<agent>>
  component "ukb-workflow-modal.tsx" as ukbmodal <<api>>
  component "ukbSlice.ts" as ukbslice <<core>>
  component "D3GraphCanvas.tsx" as d3canvas <<core>>
  component "color-fallback.ts" as colorfb <<core>>
}

cloud "/api/ukb/history" as historyapi <<external>>

kmcore --> graphify : "delegates ingestion"
migrate --> kmcore : "provenance stamping\n(layer=evidence)"
wavectl --> migrate : "anchors wave persistence"
graphify --> graphjson : "mtime-cached re-parse"
graphjson --> d3canvas : "consumed for rendering"

magraph ..> graphify : "stale techNote:\nCypher/Memgraph (drift)"
magraph --> wavectl : "w1/w2/w3 persist substeps"

ukbmodal --> historyapi : "full-parse then slice"
ukbmodal --> ukbslice : "updates WorkflowExecutionState"

d3canvas --> colorfb : "parent-walk normalization"
d3canvas --> ukbslice : "store-authoritative path"

@enduml