@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Hook Configuration Layer" {
  component "HookConfigLoader" as loader <<core>>
  database "~/.coding-tools/hooks.json" as userCfg
  database ".coding/hooks.json" as projCfg
  component "DEFAULT_CONFIG\n(event buckets)" as defaults <<core>>
}

package "Hook Dispatch" {
  component "UnifiedHookManager" as manager <<core>>
}

package "Violation Handling" {
  component "ViolationCaptureService" as capture <<core>>
  component "sanitizeParams()" as sanitize <<core>>
  component "calculateStatistics()" as stats <<core>>
  database "session-violations.jsonl" as jsonl
  database "violation-history.json" as history
}

package "Related Systems" {
  component "ContentValidationAgent" as content <<agent>>
  component "System Health Dashboard" as dashboard <<external>>
}

userCfg --> loader : "user config"
projCfg --> loader : "project override"
defaults --> loader : "default buckets"
loader --> manager : "merged config"

manager --> capture : "dispatches pre/post-tool events"
capture --> sanitize : "redacts secrets"
sanitize --> jsonl : "writes record"
capture --> stats : "on write"
stats --> history : "rolling summary\n(capped at 1000)"

history --> dashboard : "constraint/violation data"
content ..> capture : "shares severity taxonomy"

@enduml