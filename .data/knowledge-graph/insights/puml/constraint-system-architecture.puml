@startuml
!include _standard-style.puml

package "Hook Management" {
  component "UnifiedHookManager" as hookmgr <<core>>
  component "HookConfigLoader" as cfgloader <<core>>
  database "hooks.json (user/project)" as cfgfiles
}

package "Violation Capture" {
  component "ViolationCaptureService" as vcs <<core>>
  component "sanitizeParams()" as sanitize <<core>>
  database "session-violations.jsonl" as jsonl
  database "violation-history.json" as rollup
}

package "Dashboards & UX" {
  component "health-prompt-hook.js" as aggregator <<core>>
  component "constraint-monitor (Next.js)" as constraintdash <<external>>
  component "system-health-dashboard (Vite)" as healthdash <<external>>
  component "tmux Statusline" as statusline <<cli>>
}

cfgfiles --> cfgloader : "loads user+project config"
cfgloader --> hookmgr : "provides merged handlers"
hookmgr --> vcs : "dispatches violation events"

vcs --> sanitize : "redacts sensitive params"
sanitize --> jsonl : "writes append-only log"
sanitize --> rollup : "updates capped (1000) rollup"

jsonl --> aggregator : "full history read"
rollup --> aggregator : "aggregated stats"

aggregator --> constraintdash : "feeds violation data"
aggregator --> healthdash : "feeds violation data"

statusline --> constraintdash : "click opens/focuses tab"

@enduml