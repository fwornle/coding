@startuml
!include _standard-style.puml

package "Configuration Layer" {
  component "HookConfigLoader" as loader <<core>>
  database "hooks.json (user/project)" as configFiles <<storage>>
}

package "Hook Execution Layer" {
  component "UnifiedHookManager" as manager <<core>>
  component "HookHandler Registry (Map<event, HookHandler[]>)" as registry <<core>>
}

package "Violation & Reporting Layer" {
  component "ViolationCaptureService" as violation <<core>>
  component "sanitizeParams()" as sanitize <<core>>
  database "violation-history.json (max 1000)" as history <<storage>>
  component "calculateStatistics()" as stats <<core>>
}

package "Knowledge Validation Layer" {
  component "ContentValidationAgent" as validator <<agent>>
  component "GitStalenessDetector" as gitcache <<core>>
  cloud "Filesystem / Codebase" as fs <<external>>
}

configFiles --> loader : "cascades: default < user < project"
loader --> manager : "provides merged config"
manager --> registry : "sorts by priority on register"
registry --> violation : "dispatch triggers capture"

violation --> sanitize : "redacts password/token/key/secret"
sanitize --> history : "writes sanitized JSONL record"
history --> stats : "aggregated on-demand"

validator --> fs : "cross-checks references"
validator --> gitcache : "queries commit history (60s TTL)"
gitcache --> fs : "git log/show"

violation ..> validator : "parallel 'validate vs ground truth' pattern"

@enduml