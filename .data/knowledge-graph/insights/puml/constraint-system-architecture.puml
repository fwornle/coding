@startuml
!include _standard-style.puml

package "HookManagementSystem" {
  component "hook-config.js\n(HookConfigLoader)" as config <<core>>
  component "hook-manager.js\n(UnifiedHookManager)" as manager <<core>>
  component "Statusline Click-Handler" as statusline <<cli>>
}

package "ConstraintCapture" {
  component "violation-capture-service.js" as capture <<core>>
  component "sanitizeParams()" as sanitize <<core>>
  database "Session JSONL Log" as jsonl
  database "violation-history.json\n(capped 1000)" as history
}

package "HealthDashboards" {
  component "health-prompt-hook.js\n(status aggregator)" as aggregator <<api>>
  component "constraint-monitor dashboard\n(Next.js)" as dashboard <<api>>
  component "system-health-dashboard\n(Vite)" as sysdash <<api>>
}

config --> manager : "user + project config merge"
manager --> capture : "dispatches violation events"
capture --> sanitize : "redacts sensitive fields"
sanitize --> jsonl : "append-only raw events"
sanitize --> history : "rolling aggregate stats"

history --> aggregator : "feeds statistics"
jsonl ..> aggregator : "recoverable history"
aggregator --> dashboard : "constraint violations UI"
aggregator --> sysdash : "operational metrics"

statusline --> dashboard : "click opens/focuses tab"
manager --> statusline : "violation state surfaced"

@enduml