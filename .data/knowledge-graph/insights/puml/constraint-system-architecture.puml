@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration" {
  component "User Config\n~/.coding-tools/hooks.json" as userCfg <<external>>
  component "Project Config\n.coding/hooks.json" as projCfg <<external>>
  component "HookConfigLoader" as loader <<core>>
}

package "Hook Orchestration" {
  component "UnifiedHookManager" as manager <<core>>
  component "Registered Handlers\n(script/command/module)" as handlers <<agent>>
}

package "Violation Persistence" {
  component "ViolationCaptureService" as capture <<core>>
  database "session-violations.jsonl" as jsonl
  database "violation-history.json" as history
}

userCfg --> loader : "loaded first"
projCfg --> loader : "overrides (precedence)"
loader --> manager : "provides merged config"
manager --> handlers : "dispatch by event\n(sorted by priority)"
handlers --> capture : "reports violations"
capture --> jsonl : "append-only writes\n(sanitized params)"
capture --> history : "capped at 1000 entries"
history --> capture : "calculateStatistics()"

@enduml