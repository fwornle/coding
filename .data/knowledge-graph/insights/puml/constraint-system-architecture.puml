@startuml
!include _standard-style.puml

package "Hook Configuration" {
  component "HookConfigLoader" as config <<core>>
  component "UnifiedHookManager" as manager <<core>>
}

package "Violation Capture" {
  component "ViolationCaptureService" as capture <<agent>>
  database "violation-history.json" as history <<storage>>
  database "JSONL Audit Log" as jsonl <<storage>>
  component "sanitizeParams()" as sanitize <<core>>
}

package "Monitoring UI" {
  component "Tmux Statusline" as statusline <<cli>>
  component "Constraint-Monitor Dashboard" as dashboard <<external>>
}

component "ContentValidationAgent" as contentagent <<agent>>

config --> manager : "supplies merged\nconfig (project > user > default)"
manager --> capture : "dispatches pre/post-tool\nviolation events"
capture --> sanitize : "redacts sensitive params"
sanitize --> jsonl : "append-only write"
sanitize --> history : "rolling 1000-entry write"
history --> dashboard : "synchronous read on load"
statusline --> dashboard : "click 'constraints' field\nopens/focuses tab"
contentagent ..> capture : "parallel validation strategy\n(unstructured text refs)"

@enduml