@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration" {
  component "HookConfigLoader" as loader <<core>>
  database "user hooks.json" as userCfg
  database "project hooks.json" as projCfg
}

package "Dispatch" {
  component "UnifiedHookManager" as manager <<core>>
}

package "Violation Pipeline" {
  component "ViolationCaptureService" as capture <<core>>
  database ".mcp-sync/violation-history.json" as history
  component "calculateStatistics()" as stats <<core>>
}

package "Knowledge Base Validation" {
  component "ContentValidationAgent" as validator <<agent>>
}

userCfg --> loader : "global defaults"
projCfg --> loader : "project overrides"
loader --> manager : "mergeConfigs() result"
loader ..> manager : "validateConfig() warnings"

manager --> capture : "dispatches violations"
capture --> capture : "sanitizeParams()"
capture --> history : "updateViolationHistory() (cap 1000)"
history --> stats : "recompute on demand"

manager ..> validator : "shared validation philosophy"
validator --> validator : "git-based staleness detection"

@enduml