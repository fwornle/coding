@startuml
!include _standard-style.puml

package "L2 Classification Subsystem (documented, not retrieved)" {
  component "ontology-classification-agent.ts" as agent <<core>>
  component "loadL2Classes()" as loadL2 <<core>>
  component "buildL2RefinementPrompt()" as buildPrompt <<core>>
  component "extractL2FromLLMResponse()" as extract <<core>>
  component "classifySingleObservation()" as classify <<core>>
}

package "Pipeline Defect Context" {
  component "CodingLowerOntologySource Emission" as bug <<core>>
  component "Hard-Root-Guard (unrelated fix)" as guard <<core>>
}

package "Retrieved Files (mismatched cluster)" {
  component "copilot.sh / opencode.sh / pi.sh" as launchers <<cli>>
  component "no-unbounded-fs-scan.ts" as guardTool <<agent>>
  component "batch-provenance.mjs" as dashboard <<external>>
}

agent --> loadL2 : "loads OntologyRegistry classes"
agent --> buildPrompt : "builds refinement prompt"
agent --> extract : "parses LLM response"
classify --> agent : "invokes L2 refinement"
extract --> classify : "fail-closed fallback to L1"

classify ..> bug : "leaks CodingLowerOntologySource"
guard ..> bug : "does not fix (distinct issue)"

launchers ..> agent : "NOT related (retrieval mismatch)"
guardTool ..> agent : "NOT related (retrieval mismatch)"
dashboard ..> agent : "NOT related (retrieval mismatch)"

@enduml