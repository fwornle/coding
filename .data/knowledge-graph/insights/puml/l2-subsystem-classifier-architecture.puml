@startuml
!include _standard-style.puml

package "Ontology System" {
  component "OntologyClassificationAgent" as agent <<agent>>
  component "L2SubsystemClassifier" as l2 <<core>>
  component "loadL2Classes" as load <<core>>
  component "buildL2RefinementPrompt" as prompt <<core>>
  component "extractL2FromLLMResponse" as extract <<core>>
  component "createOntologySystem" as factory <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "OntologyValidator" as validator <<core>>
}

database "coding.lower.json" as codingLower <<storage>>
database "OntologyRegistry" as registry <<storage>>

package "Downstream Consumers" {
  component "Consolidator" as consolidator <<core>>
  component "repair-writer-ontology-class.mjs" as repair <<cli>>
}

agent --> l2 : "invokes L2 refinement"
l2 --> load : "loads L2 classes"
load --> codingLower : "reads source"
l2 --> prompt : "builds prompt"
l2 --> extract : "parses LLM response"
codingLower --> registry : "km-core registry"
agent --> factory : "constructs"
factory --> adapter : "requires (throws if absent)"
factory --> validator
adapter --> registry : "wraps"

l2 ..> consolidator : "stamps entity Type"
consolidator --> repair : "produces violations"
repair ..> consolidator : "reports (does not repair)"

@enduml