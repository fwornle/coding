@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Classification Pipeline" {
  component "classifySingleObservation()" as classify <<core>>
  component "Hard-Root-Guard\n(HIERARCHY_ROOTS)" as rootguard <<core>>
  component "L2SubsystemClassifier" as l2 <<agent>>
  component "buildL2RefinementPrompt()" as prompt <<core>>
  component "extractL2FromLLMResponse()" as extract <<core>>
}

package "Ontology Data" {
  database "coding.lower.json" as lowerjson <<storage>>
  component "loadL2Classes()" as loadl2 <<core>>
  component "REFINABLE_L1_PARENTS\n(hardcoded)" as parents <<core>>
}

package "External / Test" {
  cloud "LLM Provider" as llm <<external>>
  component "ontology-classification-agent.test.ts\n(tmpdir fixtures)" as tests <<cli>>
}

classify --> rootguard : "checks known roots"
rootguard --> l2 : "bypass if match\notherwise refine"
l2 --> loadl2 : "load candidate L2 classes"
loadl2 --> lowerjson : "filter classCatalog"
loadl2 --> parents : "filter by extends"
l2 --> prompt : "build multiple-choice prompt"
prompt --> llm : "send closed vocabulary prompt"
llm --> extract : "free-text response"
extract --> lowerjson : "token-boundary match"
extract --> classify : "return L2 or fallback to L1"
tests ..> l2 : "integration test"
tests ..> lowerjson : "copies fixture"

@enduml