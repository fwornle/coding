@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Live Session Runtime" {
  component "OperationalLogger" as ol <<core>>
  component "EnhancedOperationalLogger" as eol <<core>>
  component "LiveLoggingCoordinator" as llc <<core>>
  component "lsl-config.json" as cfg <<external>>
}

package "km-core Write Path" {
  component "ObservationWriter" as ow <<core>>
}

package "Validation & Preflight" {
  component "validateOperationalLogger" as vol <<agent>>
  component "OperationalLoggerTest(s)" as tests <<agent>>
}

llc --> eol : "initializeOperationalLogger"
eol --> ol : "extends / delegates log()"
ol --> cfg : "reads defaults at runtime"
ol --> ol : "log() batched writes"
ol ..> ow : "distinct write path\n(not used for normalized transcripts)"

vol ..> cfg : "checks schema assumptions"
vol ..> ol : "preflight validation"
tests ..> ol : "unit/integration tests"
tests ..> eol : "system validation"

@enduml