@startuml
!include _standard-style.puml

package "Ontology Heuristics" {
  component "EntityPatternAnalyzer" as epa <<core>>
  component "teamDirectories Map" as tdm <<core>>
  component "artifactPatterns Regexes" as apr <<core>>
  component "extractArtifacts()" as ea <<core>>
}

package "Knowledge Management Scripts" {
  component "verify-patterns.sh" as vps <<cli>>
  database "SHARED_MEMORY JSON" as shm <<storage>>
}

package "Graphify Test Fixtures" {
  component "DesignViewModel.cs" as dvm <<external>>
  component "DesignView.xaml" as dvx <<external>>
}

epa --> tdm : "loads team/dir table"
epa --> apr : "loads per-team regex table"
epa --> ea : "delegates free-text extraction"
ea --> apr : "matches class-name suffixes"

vps --> shm : "writes compliance score"
vps ..> apr : "duplicates ad-hoc pattern checks"

dvx --> dvm : "DataContext binding"

@enduml