@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Agent Bridge" {
  component "claude-bridge.js" as bridge <<cli>>
}

package "Hook Manager Core" {
  component "getHookManager()" as factory <<core>>
  component "resetHookManager()" as reset <<core>>
  component "UnifiedHookManager" as manager <<core>>
}

package "Configuration & Handlers" {
  component "loadConfig()" as loadcfg <<core>>
  component "registerHandler()" as register <<core>>
  database "user/project hooks.json" as cfgfiles
  component "eventHandlers Map\n(HookEvent enum)" as handlersmap <<storage>>
}

bridge --> factory : "lazy import"
factory --> manager : "returns singleton"
reset --> manager : "clears instance"

bridge --> manager : "initialize(projectPath)"
manager --> loadcfg : "loadConfig(userConfigPath)"
manager --> loadcfg : "loadConfig(projectConfigPath)"
loadcfg --> cfgfiles : "reads JSON"
loadcfg ..> manager : "logs error on non-ENOENT"

manager --> handlersmap : "pre-populated per HookEvent"
register --> handlersmap : "findIndex/overwrite + sort by priority"

bridge --> bridge : "fail-open: catch errors,\nreturn allow decision"

@enduml