@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Claude Bridge Subprocess" {
  component "claude-bridge.js\nmain()" as bridge <<cli>>
  component "readStdin()" as stdin <<core>>
  component "transformContext()" as transform <<core>>
}

package "Hook Manager Core" {
  component "getHookManager()" as getmgr <<core>>
  component "resetHookManager()" as resetmgr <<core>>
  component "UnifiedHookManager" as unified <<core>>
}

package "Legacy Hook Abstraction" {
  component "HooksManager (abstract)" as hooksapi <<core>>
  component "triggerHook()" as trigger <<core>>
  component "registerHook() [priority sort]" as register <<core>>
}

bridge --> stdin : "reads payload"
bridge --> transform : "builds unifiedContext"
bridge --> getmgr : "import + call"
getmgr --> unified : "creates/returns singleton"
resetmgr ..> unified : "resets (test isolation)"
bridge --> unified : "executeHooks(event, ctx, 'claude')"

hooksapi --> register : "registerHandler"
register --> trigger : "sorted eventHooks"
trigger ..> unified : "NOT invoked by bridge\n(naming mismatch)"

unified ..> bridge : "on error: fail-open\ndecision: allow"

@enduml