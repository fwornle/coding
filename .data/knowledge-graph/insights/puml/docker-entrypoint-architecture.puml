@startuml
!include _standard-style.puml

package "Entrypoint Stages" {
  component "wait_for_service()" as wait <<core>>
  component ".env Loader\n(secret exclusion)" as envload <<core>>
  component "Feature Gating Block" as featgate <<core>>
  component "exec \"$@\"" as execcmd <<core>>
}

package "External Dependencies" {
  database "Qdrant" as qdrant
  database "Redis" as redis
  cloud "Host .env File" as hostenv
}

package "Snapshot & Config" {
  component "features.json Snapshot" as snapshot <<storage>>
  component "features.d/disabled.conf" as disabledconf <<storage>>
  component "supervisord" as supervisord <<core>>
}

wait --> qdrant : "TCP poll (fail-open)"
wait --> redis : "TCP poll (fail-open)"
wait --> envload : "proceeds regardless"

hostenv --> envload : "raw key=value lines"
envload ..> envload : "skip *_API_KEY|*_TOKEN|*_MANAGEMENT_KEY"
envload --> featgate : "sanitized env"

snapshot --> featgate : "node -e reads snap.features"
featgate --> disabledconf : "writes autostart=false stanzas"
featgate --> execcmd : "on missing snapshot: start everything"

disabledconf --> supervisord : "include dir"
execcmd --> supervisord : "PID1 exec-replace"

@enduml