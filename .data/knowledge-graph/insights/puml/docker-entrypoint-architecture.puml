@startuml
!include _standard-style.puml

package "Host Boundary" {
  component ".env (host)" as envfile <<external>>
  component "~/.coding/features.yaml" as featuresyaml <<external>>
  component "llm-cli-proxy :12435" as proxy <<external>>
}

package "docker/entrypoint.sh" {
  component "Env Loader\n(*_API_KEY/*_TOKEN filter)" as envloader <<core>>
  component "wait_for_service()\nTCP poll, always returns 0" as waitfn <<core>>
  component "Feature Gating Block\nPROGRAM_FEATURES" as gatefn <<core>>
  component "exec \"$@\"" as exechandoff <<core>>
}

package "Container Runtime" {
  database "runtime/features.json\n(read-only snapshot)" as snapshot <<storage>>
  component "/etc/supervisor/features.d/disabled.conf" as disabledconf <<storage>>
  component "supervisord.conf" as supervisorconf <<core>>
  component "supervisord" as supervisord <<core>>
  component "Qdrant / Redis" as qdredis <<external>>
}

featuresyaml --> snapshot : "flattened by host"
envfile --> envloader : "imports vars"
envloader ..> proxy : "forces LLM egress via"

snapshot --> gatefn : "read (fail-open if missing)"
gatefn --> disabledconf : "generates autostart=false"
disabledconf --> supervisorconf : "overrides autostart only"

waitfn --> qdredis : "polls readiness"
waitfn --> supervisord : "defers failure to restarts"

envloader --> waitfn : "setup complete"
waitfn --> gatefn : "then gating"
gatefn --> exechandoff : "features.d written"
exechandoff --> supervisord : "PID 1 handoff"
supervisorconf --> supervisord : "process config"

@enduml