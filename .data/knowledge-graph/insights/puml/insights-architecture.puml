@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Insight Sources" {
  component "kb-ab-sample-tasks.mjs\nINSIGHTS" as kbTasks <<core>>
  component "audit-knowledge-overlap.mjs" as auditOverlap <<core>>
  component "backfill-insight-mentions.mjs\nderiveInsightSummary" as backfillMentions <<core>>
  component "backfill.ts\nreadInsights" as backfillTs <<core>>
}

package "Consolidation Engine" {
  component "ObservationConsolidator.js\nsynthesizeInsights" as consolidator <<core>>
  component "_relinkOrphanOnlineInsights" as relink <<core>>
}

package "Server & API" {
  component "server.js\nhandleGetInsights" as serverApi <<api>>
  component "copilot-http-server.js\nanalyzeSessionForInsights" as copilotServer <<api>>
}

package "UI Layer" {
  component "App.tsx\nGatedInsights" as gatedUI <<agent>>
  component "ClipboardButton" as clipboard <<external>>
  component "ConsolidationProgress" as progressUI <<external>>
  component "MarkdownText" as markdownUI <<external>>
}

backfillMentions --> consolidator : "feeds summaries"
backfillTs --> consolidator : "provides raw insights"
auditOverlap --> consolidator : "detects overlaps"
kbTasks --> consolidator : "sample insights"

consolidator --> relink : "resolves orphans"
consolidator --> serverApi : "exposes via API"

serverApi --> gatedUI : "handleGetInsights response"
copilotServer --> gatedUI : "session insights"

gatedUI --> clipboard : "copy insight"
gatedUI --> progressUI : "shows consolidation status"
gatedUI --> markdownUI : "renders insight text"

@enduml