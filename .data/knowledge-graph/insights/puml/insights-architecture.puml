@startuml
!include _standard-style.puml

package "Insights API Layer" {
  component "server.js\nhandleGetInsights" as server <<api>>
  component "ApiClient.ts\nlistInsights" as apiClient <<api>>
  component "copilot-http-server.js\nanalyzeSessionForInsights" as copilotServer <<api>>
  component "observations-api-server.mjs\nINSIGHTS_DIR" as obsServer <<storage>>
}

package "Insights Core Processing" {
  component "kb-ab-sample-tasks.mjs\nINSIGHTS" as kbTasks <<core>>
  component "backfill-insight-mentions.mjs\nderiveInsightSummary" as deriveSummary <<core>>
  component "backfill.ts\nreadInsights" as readInsights <<core>>
  component "audit-knowledge-overlap.mjs\ninsights" as auditOverlap <<core>>
}

package "Insights UI" {
  component "App.tsx\nGatedInsights" as gatedInsights <<agent>>
  component "online-mapper.test.ts\ninsights" as onlineMapper <<external>>
}

database "INSIGHTS_DIR" as insightsDB <<storage>>

apiClient --> server : "requests insights"
server --> obsServer : "reads/writes"
obsServer --> insightsDB : "persists"

readInsights --> insightsDB : "loads raw insights"
deriveSummary --> readInsights : "summarizes"
kbTasks --> deriveSummary : "consumes"
auditOverlap --> insightsDB : "audits overlap"

copilotServer --> server : "session analysis"
gatedInsights --> apiClient : "fetches insights"
onlineMapper ..> apiClient : "test validation"

@enduml