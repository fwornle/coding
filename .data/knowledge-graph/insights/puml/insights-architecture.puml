@startuml
!include _standard-style.puml

package "UKB Pipeline" {
  component "UKB Wave Pipeline" as wave <<core>>
  component "Evidence Gate" as gate <<core>>
  component "writeInsight" as write <<core>>
  component "Embedding Dedup (dry-run)" as dedup <<core>>
}

package "Insight Processing Scripts" {
  component "backfill-insight-parents.mjs" as backfillParents <<cli>>
  component "backfill-insight-mentions.mjs" as backfillMentions <<cli>>
  component "delete-wave-insight-stubs.mjs" as deleteStubs <<cli>>
  component "compact-insights.mjs" as compact <<cli>>
  component "Intent Spine Producer Script" as intentSpine <<core>>
}

package "UI / API" {
  component "handleGetInsights" as apiHandler <<api>>
  component "InsightsPage" as page <<agent>>
  component "ConsolidationProgress" as progress <<agent>>
}

database "Knowledge Graph / KB" as kb <<storage>>

wave --> gate : "generates candidate insight"
gate --> write : "passes evidence check"
write --> dedup : "checked for near-duplicates"
dedup --> kb : "writes Insight entity"

backfillParents --> kb : "links parent insights"
backfillMentions --> kb : "derives insight summaries"
deleteStubs --> kb : "removes empty stubs"
compact --> kb : "consolidates insights"
intentSpine --> kb : "clusters insights into Intents"

apiHandler --> kb : "queries insights"
page --> apiHandler : "fetches insights"
page --> progress : "shows consolidation status"

@enduml