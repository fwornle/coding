@startuml
!include _standard-style.puml

package "Ingestion & Generation" {
  component "UKB Insight Generation Pipeline" as ukb <<core>>
  component "Evidence Gating" as gating <<core>>
  component "writeInsight" as writeInsight <<core>>
  component "Embedding Dedup (dry-run)" as dedup <<core>>
}

package "Structuring & Classification" {
  component "Insight Roll-up (ObservationConsolidator.js)" as rollup <<core>>
  component "derive-intent-spine.mjs" as intentSpine <<core>>
  component "repair-writer-ontology-class.mjs" as repair <<core>>
  component "InsightSchema (schemas.ts)" as schema <<core>>
}

package "Access & Storage" {
  database "km-core LevelDB (Insights)" as kb <<storage>>
  component "observations-api-server.mjs" as apiServer <<api>>
  component "ApiClient.listInsights" as apiClient <<api>>
}

ukb --> gating : "generates candidate insights"
gating --> writeInsight : "writes evidence-backed insights"
writeInsight --> dedup : "checks near-duplicates"
dedup --> kb : "writes (gated)"

kb --> rollup : "assigns parentId"
kb --> intentSpine : "loadInsights"
intentSpine --> kb : "aggregate edges -> Intent"

kb --> repair : "arbitrate() classification"
repair --> schema : "validates ARTIFACT_CLASSES"

apiServer --> kb : "INSIGHTS_DOC_DIR access"
apiClient --> apiServer : "handleGetInsights"

@enduml