@startuml
!include _standard-style.puml

package "LLM Response Pipeline" {
  component "Provider Response\n(dmr-provider / Anthropic / OpenAI / Groq)" as provider <<external>>
  component "ParseLlmJson" as parsellmjson <<core>>
  component "escapeControlCharsInStrings()" as escape <<core>>
  component "truncateToLastCompleteElement()" as truncate <<core>>
}

package "Sibling LLM Infrastructure" {
  component "rapid-llm-proxy" as proxy <<external>>
  component "LLMAbstraction Tier Routing" as tierRouting <<agent>>
  component "Copilot Model Id Guard" as copilotGuard <<agent>>
}

provider --> parsellmjson : "malformed JSON completion"
parsellmjson --> escape : "sanitize control chars in strings"
parsellmjson --> truncate : "truncate at safe bracket boundary"

proxy ..> parsellmjson : "ruled out as corruption source"
tierRouting ..> parsellmjson : "adjacent LLM subsystem context"
copilotGuard ..> parsellmjson : "similar silent-failure guard pattern"

@enduml