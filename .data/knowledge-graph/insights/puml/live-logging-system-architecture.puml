@startuml
!include _standard-style.puml

package "Ontology Layer" {
  component "OntologyRegistry" as registry <<core>>
  component "coding.lower.json (L2 Classes)" as ontology <<storage>>
}

package "Classification Layer" {
  component "L2SubsystemClassifier\n(classifyL2)" as classifier <<core>>
  component "OntologyClassificationAgent" as agent <<agent>>
  component "extractL2FromLLMResponse\n(regex boundary match)" as extractor <<core>>
}

package "Live Logging Configuration" {
  component "LSLConfigValidator" as validator <<core>>
  database "lsl-config.json" as lslConfig <<storage>>
  database "redaction-config.yaml" as redaction <<storage>>
  component "validateUserEnvironment\n(SHA256 hash truncation)" as userhash <<core>>
}

component "LiveLoggingSystem" as lls <<component>>
component "Semantic Analysis Logger\n(buffered writer)" as semlogger <<external>>

ontology --> registry : "loaded at runtime"
registry --> lls : "materializes concept"

classifier --> lls : "deterministic classification"
agent --> classifier : "loadL2Classes()"
agent --> extractor : "validates LLM output"
extractor --> lls : "confirms exact match"

lls --> validator : "operational config check"
validator --> lslConfig : "validates schema/bounds"
validator --> redaction : "validates redaction rules"
validator --> userhash : "hashes USER env var"

lls ..> semlogger : "contrasted with (session windowing,\nredaction not shared)"

@enduml