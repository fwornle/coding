@startuml
!include _standard-style.puml

package "Session Capture" {
  component "Meeting Recording Pipeline" as recording <<core>>
  component "session-facts.ts" as facts <<core>>
  component "health-coordinator.js" as health <<agent>>
}

package "Classification Pipeline" {
  component "l2-subsystem-classifier.js" as classifier <<core>>
  component "OntologyClassificationAgent" as agent <<agent>>
  component "extractL2FromLLMResponse()" as extractor <<core>>
}

package "Configuration & Storage" {
  component "LSLConfigValidator" as validator <<core>>
  database "Knowledge Graph" as kg <<storage>>
  component "obs-api" as obsapi <<api>>
}

recording --> facts : "produces transcripts"
facts --> obsapi : "writes observations"
facts --> kg : "anchors via parentId/contains"

health --> recording : "monitors heartbeat/PID"

obsapi --> classifier : "text passed for classification"
classifier --> agent : "falls back on low confidence"
agent --> extractor : "validates LLM output"
extractor --> kg : "stamps LiveLoggingSystem class"

validator --> recording : "validates lsl-config.json"
validator --> facts : "enforces schema"

@enduml