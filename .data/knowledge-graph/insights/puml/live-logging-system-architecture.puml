@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration Validation" {
  component "LSLConfigValidator" as validator <<core>>
  component "validate-lsl-config.js" as script <<core>>
  database "lsl-config.json" as configJson <<storage>>
  database "redaction-config.yaml" as redactionYaml <<storage>>
}

package "Schema Domains" {
  component "multiUser Schema" as multiUser <<core>>
  component "fileManager Schema" as fileManager <<core>>
  component "operationalLogger Schema" as opLogger <<core>>
  component "classification Schema" as classification <<core>>
}

package "User Identity" {
  component "validateUserEnvironment()" as userEnv <<core>>
  component "FOREGROUND_USER_HASHES" as userHashes <<external>>
}

package "Ontology Classification" {
  component "OntologyClassificationAgent" as ontAgent <<agent>>
  component "buildL2RefinementPrompt()" as promptBuilder <<core>>
  component "extractL2FromLLMResponse()" as extractor <<core>>
}

script --> validator : "instantiates"
validator --> configJson : "validates"
validator --> redactionYaml : "validates"
validator --> multiUser : "enforces"
validator --> fileManager : "enforces"
validator --> opLogger : "enforces"
validator --> classification : "enforces"

validator --> userEnv : "delegates hashing"
userEnv --> userHashes : "aligns with convention"

ontAgent --> promptBuilder : "builds prompt"
promptBuilder --> extractor : "parses response"
extractor --> validator : "refines L2 classification"

@enduml