@startuml
!include _standard-style.puml

package "Validation & Classification" {
  component "validate-lsl-config.js" as validator <<cli>>
  component "Ontology Classification Agent" as classifier <<agent>>
}

package "Session Capture" {
  component "LSL Coding Session Pipeline" as lsl <<core>>
  component "RapidScribe Meeting Recorder" as rapidscribe <<core>>
  component "Diarization/Transcription" as transcribe <<agent>>
}

package "Storage & Continuity" {
  database "Date-Partitioned LSL Tranches" as tranches <<storage>>
  database "Cohort Vault (e.g. EF-412)" as vault <<storage>>
  component "Continuity Summaries" as summaries <<core>>
}

validator --> lsl : "validates config before capture"
lsl --> classifier : "streams session content"
classifier --> tranches : "classifies & routes"

rapidscribe --> transcribe : "records audio"
transcribe --> vault : "writes timeline.md,\npersonal-development.md"

tranches --> summaries : "synthesized into"
vault --> summaries : "synthesized into"

@enduml