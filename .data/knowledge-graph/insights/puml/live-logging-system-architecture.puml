@startuml
!include _standard-style.puml

package "Capture & Persistence" {
  component "ETM (Enhanced Transcript Monitor)" as etm <<core>>
  component "ObservationWriter.js" as writer <<core>>
  database "Observation Database" as db <<storage>>
}

package "Configuration" {
  component "LSLConfigValidator" as validator <<core>>
  component "validateUserEnvironment()" as userenv <<core>>
}

package "Continuity & Recovery" {
  component "/sl Command" as sl <<cli>>
  component "LSL Transcript Files" as transcripts <<storage>>
}

package "Ontology Classification" {
  component "OntologyClassificationAgent" as ontagent <<agent>>
  component "classifyL2 (l2-subsystem-classifier.js)" as classifier <<agent>>
  component "session-facts.ts (buildSessionFactIndex)" as sessionfacts <<core>>
}

etm --> writer : "raw observations"
writer --> db : "semantic dedup & snapshot promotion"
writer ..> db : "[Raw] fallback logged as stored\n(silently fails to persist)"

validator --> userenv : "derives 6-char SHA-256\nuser hash"
validator --> writer : "governs batching/rotation\nthresholds"

sl --> transcripts : "reads"
transcripts --> sl : "continuity summary"
writer ..> transcripts : "feeds session logs"

db --> ontagent : "observations tagged\nas generic Component"
ontagent --> classifier : "invokes classification"
classifier --> db : "promotes to\nLiveLoggingSystem L2"
sessionfacts --> db : "anchors Insight nodes\nvia parentId"

@enduml