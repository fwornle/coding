@startuml
!include _standard-style.puml

package "Agent-API Core" {
  component "HooksManager\n(abstract base)" as hm <<core>>
  component "EVENT_MAPPINGS" as em <<core>>
  component "registerHook()" as rh <<api>>
  component "triggerHook()" as th <<api>>
}

package "Claude Bridge Layer" {
  component "claude-bridge.js" as cb <<agent>>
  component "EVENT_MAP" as evm <<core>>
  component "readStdin()" as rs <<api>>
  component "transformContext()" as tc <<api>>
  component "main() fail-open" as mn <<api>>
}

package "Downstream Consumers" {
  component "hook-manager.js\n(UnifiedHookManager)" as ugm <<core>>
  component "ViolationCaptureService" as vcs <<external>>
}

hm --> rh : "seeds registry\nMap<event,[]>"
rh --> th : "sorted by priority"
hm ..> em : "agent-type mapping\n(stale vs EVENT_MAP)"

cb --> rs : "reads stdin JSON"
rs --> tc : "raw claudeContext"
tc --> evm : "maps native event"
evm ..> em : "diverges from"
tc --> mn : "unfiltered metadata"

mn --> ugm : "dynamic import\ngetHookManager()"
ugm --> th : "structurally similar\nregistry logic"
th --> mn : "fail-permissive\n(per-handler)"
mn --> mn : "fail-open\n(per-process, exit 0)"

tc --> vcs : "raw tool_input\n(no sanitization)"
vcs ..> vcs : "sanitizeParams()\n(implicit contract)"

@enduml