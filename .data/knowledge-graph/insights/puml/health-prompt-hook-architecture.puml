@startuml
!include _standard-style.puml

package "Claude Code Hook Layer" {
  component "main()" as main <<core>>
  component "checkHealthStatus()" as check <<core>>
  component "deriveSummary()" as derive <<core>>
  component "outputEnvelope()" as envelope <<core>>
  component "outputHealthContext()" as context <<core>>
}

package "Environment Detection" {
  component "health-verifier.js\n(existence check)" as verifier <<cli>>
}

package "Upstream Source" {
  cloud "Health Coordinator\n/health/state" as coordinator <<external>>
}

main --> check : "invokes"
check --> verifier : "checks file existence\n(Q3 carve-out)"
check --> coordinator : "fetch()"
coordinator --> check : "JSON status\n(container, databases,\nservices[], knowledge_pipeline)"
check --> derive : "on success"
derive --> context : "formats summary"
check --> envelope : "on error/unknown\n(SPEC R6)"
context --> envelope : "wraps in JSON"
main --> envelope : "all exit paths\n(SPEC R8)"

@enduml