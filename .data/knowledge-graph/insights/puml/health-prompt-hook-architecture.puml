@startuml
!include _standard-style.puml

package "Claude Hook Runtime" {
  component "main()" as main <<core>>
  component "checkHealthStatus()" as check <<core>>
  component "deriveSummary()" as derive <<core>>
  component "outputEnvelope()/outputHealthContext()" as envelope <<core>>
}

package "Environment Detection" {
  component "health-verifier.js existence check" as verifierCheck <<cli>>
}

package "External Coordinator" {
  cloud "/health/state endpoint" as coordinator <<external>>
}

package "Consumer Dashboards" {
  component "Constraint-Monitor (Next.js)" as nextDash <<external>>
  component "System-Health-Dashboard (Vite)" as viteDash <<external>>
}

component "health-prompt-hook-stall.test.mjs" as test <<agent>>

main --> check : "invokes, catches all errors"
check --> coordinator : "fetch()"
check --> verifierCheck : "Q3 carve-out heuristic"
check --> derive : "state.knowledge_pipeline.status"
derive --> envelope : "summary (issue/no-issue)"
check --> envelope : "unknown status (SPEC R6)"
main --> envelope : "fallback on fatal error"
envelope --> nextDash : "JSON envelope (SPEC R8)"
envelope --> viteDash : "JSON envelope (SPEC R8)"
test ..> derive : "asserts stalled vs stale/busy/unreachable/disabled"

@enduml