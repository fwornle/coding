@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "HealthPromptHook Flow" {
  component "main()" as main <<core>>
  component "checkHealthStatus()" as check <<core>>
  component "VERIFIER_SCRIPT existsSync" as verifier <<external>>
  component "Coordinator Fetch" as fetch <<api>>
  component "deriveSummary()" as summary <<core>>
  component "OK_SERVICE_STATUSES" as okset <<storage>>
  component "outputEnvelope()" as envelope <<core>>
}

main --> check : "invokes"
check --> verifier : "detects outside repo\n(existsSync heuristic)"
check --> fetch : "queries service health"
fetch --> summary : "raw status data\n(or failure)"
summary --> okset : "checks 'busy' as OK"
summary --> envelope : "overallStatus\n(unknown on failure, R6)"
envelope --> main : "hookSpecificOutput\n(always R8 shape)"
main --> main : "process.exit(0)\n(never blocks Claude)"

@enduml