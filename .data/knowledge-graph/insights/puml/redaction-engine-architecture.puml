@startuml
!include _standard-style.puml

package "Write Path (Full Fidelity)" {
  component "ObservationWriter" as ow <<core>>
  component "ConfigurableRedactor" as redactor <<core>>
  database "km-core GraphKMStore" as kmcore <<storage>>
  component "_observationEmitter (SSE bus)" as emitter <<core>>
}

package "Agent Sources" {
  component "opencode/claude transcripts" as fullagents <<agent>>
  component "copilot-events-tail\n(buildStubObservation)" as copilottail <<agent>>
}

package "Token Usage Path" {
  component "opencode-token-rows\n(summarizeParts/snip)" as tokrows <<core>>
  component "token-db\n(insertTokenRow/baseValues)" as tokdb <<core>>
  database "token-usage.db" as tokdbstore <<storage>>
}

fullagents --> ow : "raw transcript content"
copilottail --> ow : "metadata-only stub\n(lsl_incomplete: true)"

ow --> redactor : "invokes at init()\n(gate-before-persist)"
redactor --> kmcore : "sanitized writes"
ow --> emitter : "emit('written', row)\nafter redaction"

tokrows --> tokdb : "prompt_preview\n(truncated, not redacted)"
tokdb --> tokdbstore : "parameterized ? binds\n(T-69-sql)"

@enduml