@startuml
!include _standard-style.puml

package "Agent Layer" {
  component "OntologyClassificationAgent" as agent <<agent>>
  component "OntologyValidator" as validator <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "HeuristicClassifier" as heuristic <<core>>
}

package "Composition Root" {
  component "createOntologySystem()" as factory <<core>>
  component "OntologySystem" as system <<core>>
}

package "Ontology Infrastructure" {
  component "LegacyOntologyAdapter" as adapter <<core>>
  database "km-core OntologyRegistry" as registry <<storage>>
  component "repair-writer-ontology-class.mjs" as repair <<external>>
}

agent --> system : "consumes"
factory --> system : "wires"
factory --> adapter : "fail-fast construct"
factory --> validator : "fail-fast construct"
system --> validator : "provides"
system --> classifier : "provides"
system --> heuristic : "fallback provides"
system --> adapter : "exposes"
adapter --> registry : "wraps"
repair --> registry : "walks extends chain"
classifier --> registry : "IS-A legality checks"

@enduml