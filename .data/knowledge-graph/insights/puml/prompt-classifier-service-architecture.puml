@startuml
!include _standard-style.puml

package "rapid-llm-proxy" {
  component "classifier.impl (service ext point)" as proxyExt <<api>>
  component "/health endpoint" as proxyHealth <<api>>
}

package "PromptClassifierService" {
  component "POST /classify\nGET /health\nPATCH /config" as api <<api>>
  component "classifierFor()" as classifierFor <<core>>
  component "PromptKnnClassifier" as knn <<core>>
  component "loadConfig()\n(mtime polling)" as loadConfig <<core>>
  component "currentNetwork()" as netDetect <<core>>
  component "envFallbackConfig()" as envFallback <<core>>
}

database "config/prompt-classifier.yaml" as configYaml

cloud "Configurable Backend LLM" as backendLLM <<external>>

proxyExt --> api : "POSTs {text}"
api --> classifierFor : "decides tier"
classifierFor --> knn : "local judge"
classifierFor --> backendLLM : "remote judge"
classifierFor --> netDetect : "backend selection\n(first-enabled-network-match)"
netDetect --> proxyHealth : "reads live network state\n(cached via NETWORK_TTL_MS)"
loadConfig --> configYaml : "hot-reload poll"
loadConfig --> classifierFor : "ordered backend list"
envFallback ..> loadConfig : "fallback on\nparse failure"
api --> proxyExt : "returns {band}"

@enduml