@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Pre-Flight Validation" {
  component "validate-lsl-config.js" as validator <<cli>>
  component "Config Schema\n(session window / file routing)" as schema <<core>>
}

package "CI / Developer Workflow" {
  component "CI Pipeline" as ci <<external>>
  component "Developer" as dev <<agent>>
}

package "Runtime Logging" {
  component "logging.ts" as logging <<core>>
  component "Session Data Capture" as capture <<storage>>
}

dev --> validator : "runs manually"
ci --> validator : "runs pre-deploy"
validator --> schema : "validates against"
schema --> logging : "consumed at runtime"
logging --> capture : "writes session data"

validator ..> logging : "no runtime coupling"

@enduml