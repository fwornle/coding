@startuml
!include _standard-style.puml

package "Semantic Analysis (offline/batch)" {
  component "ContentValidationAgent" as cva <<agent>>
  component "filePathPatterns / commandPatterns\n(regex extraction)" as patterns <<core>>
  component "GitStalenessDetector" as gsd <<core>>
  component "CommitEntityCorrelation" as cec <<core>>
  database "Knowledge Graph\n(entity observations)" as kg
}

package "Git History" {
  database "Repository Commit History" as gitrepo
}

package "Hook Dispatch Subsystem (decoupled)" {
  component "HooksManager\n(hooks-api.js)" as hm <<api>>
  component "claude-bridge.js\n(fail-open)" as bridge <<external>>
}

kg --> cva : "entity observation text"
cva --> patterns : "extracts file/command refs"
patterns --> gsd : "candidate references"
gsd --> cec : "correlate vs commits"
cec --> gitrepo : "queries commit history"
cec --> cva : "staleness score"

hm ..> bridge : "priority-sorted dispatch\n(sibling subsystem)"
cva ..> hm : "NOT wired into\nPreToolUse/PostToolUse"

@enduml