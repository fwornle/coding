@startuml
!include _standard-style.puml

package "EF-412 Work Record (documented only)" {
  component "ContentValidationAgent" as cva <<agent>>
  component "ContentValidator (record label)" as cv <<agent>>
  component "Timeline Entries (second-brain-private vault)" as timeline <<storage>>
}

package "Rec Workspace Concerns" {
  component "GHE Repo Mgmt (gh)" as gh <<external>>
  component "rapidscribe-meeting Transcription" as rsm <<external>>
  component "EF-412 Feedback Filing" as feedback <<core>>
}

package "Supplied Source (unrelated retrieval)" {
  component "health-prompt-hook.js" as hook <<core>>
  component "workflow/hooks.ts" as whooks <<core>>
  component "usePolledFetch.ts" as poll <<core>>
  component "cli-and-rules-gating.test.mjs" as cli <<cli>>
}

cva ..> cv : "same conceptual\nvalidator (label only)"
cv --> timeline : "enforces conciseness\ncontract"
feedback --> timeline : "files entries"
rsm --> feedback : "produces transcripts"
gh --> feedback : "adjacent workspace concern"

whooks ..> hook : "shares LLM-call poller"
poll ..> whooks : "generic polling base"
cli ..> hook : "unrelated: feature-gating tests"

cva ..> hook : "NO evidence of reference"
cva ..> whooks : "NO evidence of reference"

@enduml