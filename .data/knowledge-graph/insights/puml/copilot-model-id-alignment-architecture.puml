@startuml
!include _standard-style.puml

package "Vendored Dependency" {
  component "@rapid/llm-proxy tarball" as rlp <<external>>
  component "copilot-provider.js (dist)" as provider <<external>>
}

package "Alignment Mechanism" {
  component "align-copilot-model-ids.mjs" as script <<core>>
  component "Dockerfile RUN steps" as dockerfile <<core>>
  component "package.json postinstall" as postinstall <<core>>
}

package "Drift-Guard Test Suite" {
  component "copilot-model-ids.test.mjs" as test <<cli>>
  component "SA_CHECKED_OUT gate" as gate <<agent>>
  component "RETIRED id cross-check" as retiredcheck <<agent>>
  component "Dockerfile order check" as ordercheck <<agent>>
}

rlp --> provider : "ships hardcoded\ncopilot-tier ids"
dockerfile --> script : "invokes after install"
postinstall --> script : "invokes on install"
script --> provider : "patches retired ids\nin dist file"

test --> gate : "skips if submodule absent"
test --> retiredcheck : "parses replacement table"
test --> ordercheck : "asserts script runs\nafter npm install"
ordercheck --> dockerfile : "checks RUN line order"
retiredcheck --> script : "validates dead->live map"
test --> provider : "asserts no retired\nids remain"

@enduml