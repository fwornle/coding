@startuml
!include _standard-style.puml

package "Vendored Dependency" {
  component "@rapid/llm-proxy" as proxy <<external>>
  component "align-copilot-model-ids.mjs" as script <<core>>
}

package "Dual Invocation" {
  component "Dockerfile.coding-services" as docker <<cli>>
  component "package.json postinstall" as postinstall <<cli>>
}

package "Drift Guard" {
  component "copilot-model-ids.test.mjs" as test <<agent>>
  component "SA_CHECKED_OUT gate" as gate <<core>>
}

component "Provider Fallback Chain" as fallback <<core>>

proxy --> script : "hardcoded copilot ids\nrewritten post-install"
docker --> script : "runs after npm install\n--ignore-scripts"
postinstall --> script : "runs on host install"

test --> script : "greps source text\nfor RETIRED id pairs"
test --> docker : "asserts ordering &\nno error swallowing"
test --> postinstall : "asserts postinstall wiring"
gate --> test : "gates 4 tests on\nsubmodule presence"

script --> fallback : "prevents retired id\nfrom reaching provider"
fallback --> proxy : "copilot tier request"

@enduml