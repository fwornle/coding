@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Host/Container Boundary" {
  component "features.yaml (host)" as featyaml <<external>>
  component "features.json snapshot" as featjson <<storage>>
  component "entrypoint.sh" as entry <<core>>
  component "supervisord disabled.conf" as supconf <<storage>>
}

package "Service Lifecycle" {
  component "service-starter.js\n(withDeadline, startServiceWithRetry)" as starter <<core>>
  component "api-service.js" as apisvc <<cli>>
  component "dashboard-service.js" as dashsvc <<cli>>
  component "Process State Manager" as psm <<core>>
}

package "MCP Config Generation" {
  component "generate-docker-mcp-config.sh" as mcpgen <<core>>
  component "code-graph-config.mjs" as cgconfig <<core>>
  component "claude-code-mcp-docker.json" as mcpjson <<storage>>
}

featyaml --> featjson : "flattened snapshot"
featjson --> entry : "read-only mount"
entry --> supconf : "generates"

starter --> apisvc : "spawns & retries"
starter --> dashsvc : "spawns & retries"
apisvc --> psm : "register/unregister PID"
dashsvc --> psm : "register/unregister PID"

mcpgen --> cgconfig : "codegraph feature check"
cgconfig --> mcpjson : "merges graphify entry"
mcpgen --> mcpjson : "writes empty mcpServers{}"

@enduml