@startuml
!include _standard-style.puml

package "LLM Routing Core" {
  component "LLMMockService" as mock <<core>>
  component "getLLMMode()\n(perAgentOverrides>globalMode>legacy)" as mode <<core>>
  component "rapid-llm-proxy" as proxy <<api>>
  component "Provider Clients\n(DMR/Anthropic/OpenAI/Groq)" as providers <<external>>
}

package "Drift & Policy Guards" {
  component "copilot-model-ids.test.mjs" as idtest <<cli>>
  component "align-copilot-model-ids.mjs" as aligner <<cli>>
  component "offload-gates.ts ladder" as ladder <<core>>
}

package "Dashboard Observability" {
  component "cost-model.ts\npriceForModel()" as cost <<core>>
  component "offload-decision.tsx" as offload <<agent>>
  component "use-classifier-judge.ts" as judge <<agent>>
  component "provider.tsx (Redux)" as reduxprov <<external>>
}

mock --> mode : "resolves mode"
mode --> proxy : "mock/live toggle"
proxy --> providers : "tiered fallback\n(max-sub > copilot > groq)"

idtest --> aligner : "verifies rewrite"
aligner ..> providers : "prevents retired-id 400s"

proxy --> cost : "logs calls"
proxy --> offload : "/api/llm/routing/resolve"
ladder ..> offload : "local mirror cross-check"
proxy --> judge : "classifier health"
judge --> reduxprov : "state updates"

@enduml