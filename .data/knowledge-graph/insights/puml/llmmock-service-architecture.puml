@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration" {
  component "Environment Config\n(LLM_PROXY_URL etc)" as envcfg <<external>>
}

package "LLM Mock Layer" {
  component "LLMMockService" as mockservice <<core>>
  component "Mode Router\n(mock/local/public)" as router <<core>>
  database "workflow-progress.json" as progressfile <<storage>>
}

package "Consumers" {
  component "Semantic Analysis MCP" as mcp <<agent>>
  cloud "Real LLM Provider" as realllm <<external>>
}

envcfg --> router : configures mode
router --> mockservice : selects routing behavior
mockservice --> progressfile : reads/writes deterministic state
mcp --> mockservice : requests LLM call
mockservice --> realllm : forwards (local/public mode only)

@enduml