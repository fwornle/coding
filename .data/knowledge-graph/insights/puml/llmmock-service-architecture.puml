@startuml
!include _standard-style.puml

package "Mock Resolution Layer" {
  component "LLMMockService" as mock <<core>>
  component "getLLMMode()" as getmode <<core>>
  component "workflow-progress.json" as progressjson <<storage>>
}

package "Resolution Sources" {
  component "perAgentOverrides" as override <<core>>
  component "globalMode" as global <<core>>
  component "legacy mockLLM boolean" as legacy <<core>>
  component "hardcoded 'public' default" as fallback <<core>>
}

package "Live Routing Context" {
  component "LLM Routing Tiers" as tiers <<external>>
  component "rapid-llm-proxy" as proxy <<external>>
  component "Provider Failure Handling" as failures <<external>>
}

mock --> getmode : "resolves active mode"
getmode --> override : "1st priority"
getmode --> global : "2nd priority"
getmode --> legacy : "3rd priority (legacy)"
getmode --> fallback : "4th priority (default)"
legacy ..> progressjson : "backward compatibility"

mock ..> tiers : "should mirror fallback order (unverified)"
tiers --> proxy : "routes live requests"
proxy --> failures : "provider failures"
failures ..> mock : "risk: masks failures behind stale mock state"

@enduml