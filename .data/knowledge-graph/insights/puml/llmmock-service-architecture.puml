@startuml
!include _standard-style.puml

package "LLMMockService (llm-mock-service.ts)" {
  component "getLLMMode()" as mode <<core>>
  component "Per-agent override" as override <<core>>
  component "Global mode setting" as global <<core>>
  component "Legacy mockLLM boolean" as legacy <<core>>
  component "Default 'public'" as default <<core>>
}

database ".data/workflow-progress.json" as state <<storage>>

package "External Dependencies" {
  component "CODING_ROOT path translation" as root <<core>>
  cloud "proxy-bridge/server.mjs\n(com.coding.llm-cli-proxy)" as proxy <<external>>
}

package "LLM Routing Dashboard (unrelated layer)" {
  component "cost-model.ts" as cost <<core>>
  component "offload-decision.tsx" as offload <<core>>
  component "use-classifier-judge.ts" as judge <<core>>
}

override --> mode : "1st precedence"
global --> mode : "2nd precedence"
legacy --> mode : "3rd precedence"
default --> mode : "fallback"

mode --> state : "persists/reads mode"
mode --> root : "Docker/host path resolution"
mode --> proxy : "live/public mode routes calls"

cost ..> mode : "thematically adjacent\n(no direct call)"
offload ..> mode : "thematically adjacent\n(no direct call)"
judge ..> mode : "thematically adjacent\n(no direct call)"

@enduml