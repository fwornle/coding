@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "LLM Routing" {
  component "LLMMockService\n(getLLMMode)" as mock <<core>>
  component "use-classifier-judge.ts\n(enabled vs reachable)" as judge <<agent>>
  component "use-offload-policy-draft" as offload <<agent>>
  component "prompt-classifier.yaml" as classifierCfg <<external>>
  component "llm-routing.yaml" as routingCfg <<external>>
}

package "Cost & Status Tooling" {
  component "cost-model.ts\n(budgetForMonth/priceForModel)" as cost <<core>>
  component "model-limits.cjs\n(catalogueContextWindow)" as limits <<core>>
  database "Catalogue Cache" as cache <<storage>>
}

package "Dashboard State" {
  component "store/provider.tsx\n(Redux Provider)" as store <<core>>
}

mock --> judge : "same config-vs-runtime\nsplit pattern"
judge --> classifierCfg : "reads/writes"
offload --> routingCfg : "reads/writes"
judge ..> offload : "kept separate\n(no shared save path)"

mock --> cost : "dual-write/overlay\nphilosophy shared"
cost --> limits : "multi-tier fallback\npattern shared"
limits --> cache : "mtime+size\ninvalidation"

store --> mock : "hosts mock state"
store --> judge : "hosts judge state"
store --> cost : "hosts cost state"

@enduml