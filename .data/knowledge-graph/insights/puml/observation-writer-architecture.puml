@startuml
!include _standard-style.puml

package "Producers" {
  component "enhanced-transcript-monitor.js" as etm <<agent>>
  component "extractFileChanges/toolCallArgs" as extract <<core>>
}

package "Observation Pipeline" {
  component "ObservationWriter" as ow <<core>>
  component "ObservationApiClient" as oac <<api>>
  component "ObservationConsolidator" as oc <<core>>
  component "MentionsClassifier" as mc <<core>>
}

package "Persistence & Monitoring" {
  database "Observation DB" as db
  component "health-coordinator.js" as hc <<core>>
}

etm --> extract : normalizes tool-call payloads
extract --> ow : "{modifiedFiles, readFiles}"
etm --> ow : direct write path
etm --> oac : API write path
ow --> oc : "_ensureObservationWriter"
oc --> mc : dirty-parent re-synthesis
ow --> db : persist (dedup/snapshot/\nevidence-floor gated)
oac --> db : persist via API
hc ..> ow : "fetchLastObservationWriterCallAge"

ow ..> db : "[Raw] fallback logs\n'storing' but may silently fail"

@enduml