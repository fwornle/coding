@startuml
!include _standard-style.puml

package "EntityPatternAnalyzer (Layer 1)" {
  component "analyzeEntityPatterns()" as analyze <<core>>
  component "extractArtifacts()" as extract <<core>>
  component "checkLocalArtifact()\n(confidence 0.9)" as localCheck <<core>>
  component "matchArtifactPattern()\n(confidence 0.75)" as patternCheck <<core>>
  component "inferEntityClass()" as inferClass <<core>>
}

package "Hardcoded Team Data" {
  component "teamDirectories Map\n(Coding/RaaS/ReSi/UI)" as teamDirs <<storage>>
  component "artifactPatterns\n(regex per team)" as patterns <<storage>>
  component "teamMappings\n(incl. unregistered Agentic)" as mappings <<storage>>
}

package "External Consumers" {
  component "Merge/Consolidation Step" as merge <<agent>>
  component "report-entity-resolution.mjs\n(audit, unrelated harness)" as audit <<cli>>
}

analyze --> extract : "1. mine artifacts"
extract --> localCheck : "per-artifact candidates"
localCheck --> teamDirs : "prefix match (0.9)"
localCheck --> patternCheck : "fallback if no match"
patternCheck --> patterns : "regex match (0.75)"
analyze --> inferClass : "classify entity"
inferClass --> mappings : "lookup team->class"

analyze --> merge : "team+entity Class+confidence"
audit ..> analyze : "no equivalent audit exists"

@enduml