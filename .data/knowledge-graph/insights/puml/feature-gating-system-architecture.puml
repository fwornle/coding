@startuml
!include _standard-style.puml

package "CLI Entry Points" {
  component "bin/graphify\nbin/semantic\nbin/constraints" as clis <<cli>>
  component "bin/llm" as binllm <<cli>>
  component "require-feature.sh" as guard <<core>>
}

package "Feature Source of Truth" {
  component "catalogue.cjs\n(FEATURE_IDS)" as catalogue <<core>>
}

package "Health Monitoring" {
  component "health-coordinator.js\n(ruleFeatureActive)" as coordinator <<core>>
  database "health-verification-rules.json" as rules
}

component "Statusline UI\n(clickable feature fields)" as statusline <<agent>>

clis --> guard : "invokes gate"
guard --> catalogue : "resolves feature\n(transitive deps)"
guard ..> clis : "fail-open on error"

binllm ..> guard : "exempt, no gate"

rules --> coordinator : "feature tags\n(array per rule)"
coordinator --> catalogue : "validates feature ids"
coordinator ..> coordinator : "fail-open\nif undefined"

statusline --> catalogue : "'constraints' as UI + gate target"

@enduml