package "Agent Layer" {
  component "OntologyClassificationAgent" as agent <<agent>>
}

package "Anti-Corruption Layer" {
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "ontology/types.ts\n(EntityDefinition,\nOntologyType,\nPropertyDefinition)" as types <<core>>
}

package "Core Registry" {
  component "OntologyRegistry\n(@fwornle/km-core)" as registry <<external>>
}

package "Legacy Consumers" {
  component "OntologyValidator" as validator <<core>>
  component "OntologyClassifier" as classifier <<core>>
}

agent --> registry : "constructs"
agent --> adapter : "wraps registry with"
adapter --> registry : "delegates calls to"
adapter --> types : "uses type contracts"

validator --> adapter : "consumes legacy shape"
classifier --> adapter : "consumes legacy shape"

@enduml