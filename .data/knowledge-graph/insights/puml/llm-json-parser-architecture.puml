@startuml
!include _standard-style.puml

package "LLM Provider Layer" {
  component "Anthropic Provider" as anthropic <<external>>
  component "OpenAI Provider" as openai <<external>>
  component "Groq Provider" as groq <<external>>
  component "DMR Provider" as dmr <<external>>
}

package "Routing & Cost (unrelated surface)" {
  component "Offload Decision" as offload <<core>>
  component "Classifier Judge" as classifier <<core>>
  component "Cost Model" as cost <<core>>
}

package "JSON Repair (unverified)" {
  component "LlmJsonParser" as parser <<core>>
}

anthropic ..> parser : "raw output (unconfirmed)"
openai ..> parser : "raw output (unconfirmed)"
groq ..> parser : "raw output (unconfirmed)"
dmr ..> parser : "raw output (unconfirmed)"

offload --> classifier : "routes tier decisions"
classifier ..> groq : "fallback after tiers exhausted"
cost --> offload : "informs budget constraints"

@enduml