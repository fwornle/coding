@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Ownership Layer (OS-uid checks)" {
  component "isOwnedByMe()\n(copilot-events-tail.mjs)" as ownedMe <<core>>
  component "ownedDbPath()\n(opencode-token-rows.mjs)" as ownedDb <<core>>
}

package "Adapter Hash Namespace (token-db.mjs)" {
  component "ADAPTER_USER_HASH_CLAUDE" as hashClaude <<storage>>
  component "ADAPTER_USER_HASH_COPILOT" as hashCopilot <<storage>>
  component "ADAPTER_USER_HASH_OPENCODE" as hashOpencode <<storage>>
  component "insertTokenRow()\n(retry/probe D-08)" as insertRow <<core>>
  component "insertShapeFor()\n(schema probe)" as shapeProbe <<core>>
  database "token_usage.db" as tokenDb
}

package "Process Identity Layer" {
  component "ObservationWriter\n(_runId stamp)" as obsWriter <<core>>
}

ownedMe ..> tokenDb : "gates file read\n(fail-closed uid check)"
ownedDb ..> tokenDb : "gates db access\n(fail-closed uid check)"

hashClaude --> insertRow : "namespaces id space"
hashCopilot --> insertRow : "namespaces id space"
hashOpencode --> insertRow : "namespaces id space"

insertRow --> tokenDb : "MAX(id)+1 per user_hash\n(retry on race)"
shapeProbe --> tokenDb : "PRAGMA table_info\n(degrade to base shape)"
insertRow --> shapeProbe : "uses cached shape"

obsWriter ..> tokenDb : "stamps provenance\n(orthogonal identity)"

@enduml