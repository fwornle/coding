@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Transcript Adapter Layer" {
  component "TranscriptAdapter\n(abstract base)" as base <<core>>
  component "SpecstoryAdapter" as spec <<core>>
  component "ClaudeParser" as claude <<core>>
  component "LSLConverter" as conv <<core>>
}

package "Data Model" {
  component "LSLEntryType Enum\n(6 fixed values)" as enum <<storage>>
  component "LSLSession / LSLEntry" as lsl <<storage>>
}

package "Downstream Consumers" {
  component "lsl-sessions.mjs\n(dashboard)" as dash <<external>>
  database ".specstory/history" as history
}

base ..> spec : "enforced via new.target guard"
base ..> claude : "enforced via new.target guard"

spec --> conv : "delegates redaction/classification"
claude --> conv : "delegates redaction/classification"

conv --> lsl : "produces"
lsl --> enum : "constrained by"

spec --> history : "reads markdown transcripts"
history --> dash : "discoverProjects()"
dash --> lsl : "live in-memory format conversion"

spec ..> dash : "format detection\n(pi vs markdown vs mixed)"

@enduml