@startuml
!include _standard-style.puml

package "Violation Capture Module" {
  component "ViolationCaptureService" as vcs <<core>>
  component "getViolationCaptureService()" as accessor <<core>>
}

package "Shared Aggregator" {
  component "health-prompt-hook.js" as aggregator <<core>>
}

package "Dashboard Consumers" {
  component "Constraint-Monitor Dashboard (Next.js)" as nextDash <<external>>
  component "System-Health Dashboard (Vite)" as viteDash <<external>>
  component "usePolledFetch.ts" as poll <<agent>>
}

component "tmux Statusline 'constraints' Field" as statusline <<cli>>

accessor --> vcs : "lazily constructs / caches instance"
vcs --> aggregator : "provides rolled-up JSON + JSONL history"
aggregator --> nextDash : "feeds"
aggregator --> viteDash : "feeds"
poll --> aggregator : "polls"
statusline --> nextDash : "click opens/focuses tab"

@enduml