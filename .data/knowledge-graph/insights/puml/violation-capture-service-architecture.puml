@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Input Context" {
  component "Hook/Tool Context\n(sessionId, params)" as ctx <<external>>
}

package "ViolationCaptureService" {
  component "getViolationCaptureService()" as factory <<api>>
  component "ViolationCaptureService" as service <<core>>
  component "Redaction Step" as redact <<core>>
  component "Aggregation Logic\n(severity, most-common,\navg-per-session)" as agg <<core>>
}

package "Persistence" {
  database "session-violations.jsonl\n(append-only raw log)" as jsonl <<storage>>
  database "violation-history.json\n(capped at 1000 entries)" as history <<storage>>
}

ctx --> service : "provides raw event data"
factory --> service : "instantiates/returns singleton"
service --> redact : "sanitizes sensitive params"
redact --> jsonl : "appends redacted record"
jsonl --> agg : "feeds raw records"
agg --> history : "writes computed stats\n(bounded growth)"

@enduml