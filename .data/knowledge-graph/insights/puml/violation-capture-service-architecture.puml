@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Hook Dispatch Layer" {
  component "UnifiedHookManager.executeHooks()" as executeHooks <<core>>
  component "registerHandler()\n(priority-sort, dedup)" as registerHandler <<core>>
  component "claude-bridge.js main()\n(fail-open)" as bridge <<agent>>
}

package "Violation Capture Service" {
  component "getViolationCaptureService()" as getter <<api>>
  component "ViolationCaptureService" as service <<core>>
  component "sanitizeParams()" as sanitize <<core>>
  component "updateViolationHistory()\n(1000-entry cap)" as update <<core>>
  component "calculateStatistics()" as stats <<core>>
}

package "Persistence" {
  database ".mcp-sync/violation-history.json" as history <<storage>>
}

bridge --> executeHooks : "invokes"
registerHandler --> executeHooks : "provides sorted handlers"
executeHooks --> getter : "allow:false triggers capture"
getter --> service : "returns singleton"
service --> sanitize : "redacts credentials"
sanitize --> update : "passes clean payload"
update --> history : "writes JSONL, enforces cap"
update --> stats : "triggers recompute"
stats --> history : "reads capped array"

@enduml