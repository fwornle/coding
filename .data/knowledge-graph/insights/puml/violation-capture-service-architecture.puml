@startuml
!include _standard-style.puml

package "Violation Capture Core" {
  component "ViolationCaptureService" as vcs <<core>>
  component "getViolationCaptureService" as accessor <<core>>
}

package "Constraint System" {
  component "ConstraintSystem" as cs <<core>>
}

package "Dashboards" {
  component "constraint-monitor\n(Next.js)" as cm <<external>>
  component "system-health-dashboard\n(Vite)" as shd <<external>>
  component "tmux Statusline" as statusline <<cli>>
}

accessor --> vcs : "lazily instantiate/cache"
cs --> vcs : "produces violation data"
vcs --> cm : "feeds violation records"
statusline --> cm : "click-through opens/focuses"
cm ..> shd : "separate dashboard\n(architecturally distinct)"

@enduml