@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Hook Flow" {
  component "UnifiedHookManager" as hookMgr <<core>>
}

package "Violation Capture" {
  component "ViolationCaptureService" as vcs <<core>>
  component "Statistics Aggregator" as stats <<core>>
}

package "Persistence" {
  component "violation-capture-service.js\n(JSONL Log)" as jsonl <<storage>>
  database "JSON Store\n(cap: 1000 entries)" as jsonStore <<storage>>
}

package "Validation Domain" {
  component "ContentValidationAgent" as cva <<agent>>
  component "ValidationIssue Model" as vim <<core>>
}

hookMgr --> vcs : "pre/post-tool event"
vcs --> jsonl : "append violation event"
vcs --> stats : "compute at write time"
stats --> jsonStore : "update rolling stats"
vcs --> jsonStore : "persist + evict oldest"
cva --> vim : "defines severity taxonomy"
vim ..> vcs : "shared classification"

@enduml