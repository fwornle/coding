@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Backend (lsl-sessions.mjs)" {
  component "discoverProjects()" as discover <<core>>
  component "listSessions()" as listS <<core>>
  component "peekMeta()" as peekMeta <<core>>
  component "chainId()/parseChainId()" as chainId <<core>>
  component "resolveChain()" as resolveChain <<core>>
}

package "Frontend (lsl-sessions.tsx)" {
  component "Session Dashboard UI" as dashboard <<core>>
  component "Auto-Select Logic" as autoSelect <<core>>
  component "Transcript Iframe" as iframe <<core>>
}

package "Storage" {
  database "Hourly Chain Files\n(markdown/pi/mixed parts)" as chains <<storage>>
}

cloud "export.html" as exportHtml <<external>>

discover --> listS : "provides project roots"
listS --> chains : "reads first lines per chain"
peekMeta --> chains : "aggregates across all parts"
chainId --> resolveChain : "encodes/decodes id"
resolveChain --> chains : "resolves to files"

dashboard --> listS : "requests session list"
dashboard --> peekMeta : "requests metadata"
dashboard --> autoSelect : "delegates selection"
autoSelect --> peekMeta : "checks promptSets > 0"
dashboard --> iframe : "renders selected session"
iframe --> exportHtml : "loads with theme param"

@enduml