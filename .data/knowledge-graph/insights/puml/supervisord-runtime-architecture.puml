@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Container Boot" {
  component "entrypoint.sh" as entry <<core>>
  component "features.json snapshot" as snap <<storage>>
  component "features.d/disabled.conf" as disabled <<storage>>
  component "supervisord.conf [include]" as supconf <<core>>
  component "supervisord programs\n(semantic-analysis, graphify, etc.)" as programs <<core>>
  cloud "llm-cli-proxy :12435" as proxy <<external>>
}

package "Host Startup" {
  component "start-services.sh (legacy)" as legacy <<cli>>
  component "start-services-robust.js" as robust <<core>>
  component "SERVICE_CONFIGS + startOneService()" as configs <<core>>
  component "ProcessStateManager (PSM)" as psm <<storage>>
  component "waitForPortBindable / killProcessOnPortAndWait" as portutil <<core>>
}

package "Test Contracts" {
  component "service-gating.test.mjs" as test <<agent>>
  component "lib/features/catalogue.cjs" as catalogue <<storage>>
}

snap --> entry : "read via node -e"
entry --> disabled : "writes autostart=false"
disabled --> supconf : "included directory"
supconf --> programs : "controls autostart"
entry --> proxy : "routes outbound LLM calls\n(secrets filtered from env)"

legacy ..> robust : "ROBUST_MODE=true"
robust --> configs
configs --> psm : "isServiceRunning checks"
configs --> portutil : "port reclamation"
psm --> configs : "self-heal via pgrep fallback"

test --> configs : "asserts feature coverage"
test --> catalogue : "validates FEATURE_IDS"
configs --> catalogue : "feature key lookup"

@enduml