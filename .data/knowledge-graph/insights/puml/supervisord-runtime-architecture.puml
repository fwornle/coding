@startuml
!include _standard-style.puml

package "Host Side" {
  component "Feature Resolution\n(features.yaml)" as hostPolicy <<core>>
  database "features.json\n(snapshot)" as snapshot <<storage>>
  component "Host PSM Orchestrator\n(start-services-robust.js)" as psm <<agent>>
}

package "Container: entrypoint.sh" {
  component "Snapshot Consumer\n(node -e evaluation)" as consumer <<core>>
  component "PROGRAM_FEATURES\nMapping" as mapping <<core>>
  component "features.d/disabled.conf\nGenerator" as overrideGen <<core>>
  component ".env Loader\n(egress lockdown filter)" as envLoader <<core>>
  component "wait_for_service()\n(Qdrant/Redis TCP poll)" as waiter <<core>>
}

package "Supervisord Layer" {
  component "supervisord.conf\n(program definitions)" as supconf <<core>>
  component "supervisord\n(process manager)" as supervisord <<core>>
  cloud "llm-cli-proxy :12435" as proxy <<external>>
}

hostPolicy --> snapshot : "writes"
snapshot ..> consumer : "read-only mount"
consumer --> mapping : "evaluates feature keys"
mapping --> overrideGen : "autostart=false stanzas"
overrideGen --> supconf : "includes features.d/*.conf"
envLoader --> supervisord : "exec \"$@\""
waiter --> supervisord : "defers readiness enforcement"
supconf --> supervisord : "defines programs/commands"
envLoader ..> proxy : "enforces no direct egress"

psm ..> snapshot : "independent gating\n(non-integrated)"

@enduml