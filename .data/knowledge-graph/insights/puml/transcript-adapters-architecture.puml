@startuml
!include _standard-style.puml

package "Monitor Script" {
  component "enhanced-transcript-monitor.js" as monitor <<core>>
  component "toolCallArgs() Normalizer" as normalizer <<core>>
}

package "Transcript Readers (implied Adapters)" {
  component "StreamingTranscriptReader" as streaming <<agent>>
  component "AdaptiveExchangeExtractor" as adaptive <<agent>>
  component "PiSessionReader" as pireader <<agent>>
  component "PiSessionWriter" as piwriter <<agent>>
}

package "Downstream Consumers" {
  component "ObservationWriter" as obswriter <<core>>
  component "ObservationApiClient" as obsapi <<api>>
  database "~/.rapidscribe/meetings/<session-id>/" as sessionstore <<storage>>
}

streaming --> monitor : "raw exchanges"
adaptive --> monitor : "raw exchanges"
pireader --> monitor : "pi tool calls"

monitor --> normalizer : "invokes"
normalizer --> monitor : "normalized args"

monitor --> piwriter : "serializes session"
piwriter --> sessionstore : "writes session-YYYYMMDD-HHMMSS"

monitor --> obswriter : "normalized observations"
obswriter --> obsapi : "writes via"
obsapi ..> obsapi : "single-threaded contention risk"

@enduml