@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "CLI / Lifecycle" {
  component "vkb-cli\n(server start/stop/status)" as cli <<cli>>
  component "VKBServer" as vkbserver <<core>>
  component "restartVKBServer\n(health-remediation)" as restarter <<agent>>
}

package "API Layer" {
  component "ApiRoutes\n(registerRoutes)" as apiroutes <<api>>
  component "KnowledgeQueryService" as kqs <<core>>
  component "db-query-cli.js" as dbcli <<cli>>
}

package "Data Layer" {
  database "GraphDB\n(database Manager.graphDB)" as graphdb <<storage>>
  component "DataProcessor\n(prepareData)" as dataproc <<core>>
  component "memory.json" as memoryjson <<storage>>
}

cloud "VkbApiClient\n(isServerAvailable)" as apiclient <<external>>

cli --> vkbserver : "manages lifecycle"
restarter --> vkbserver : "supervisorctlRestart"
restarter --> restarter : "log"

vkbserver --> apiroutes : "hosts endpoints"
apiroutes --> kqs : "builds from graphDB"
kqs --> graphdb : "queries"
dbcli --> kqs : "shells out to"

apiclient --> apiroutes : "GET /api/health\n(2s timeout probe)"

dataproc --> memoryjson : "deletes & regenerates"
dataproc --> graphdb : "batch/online/combined mode"
apiroutes --> dataproc : "/api/export, /api/query"

@enduml