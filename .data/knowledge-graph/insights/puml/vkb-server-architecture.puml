@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Health Coordination" {
  component "VKBServer" as vkbserver <<core>>
  component "restartVKBServer" as restart <<agent>>
}

package "HTTP Client Layer" {
  component "VkbApiClient\n(isServerAvailable)" as apiclient <<api>>
  component "cli.js\n(isVKBRunning/sendToVKB)" as clicli <<cli>>
}

package "Persistence Layer" {
  database "DatabaseManager\n+ UKBDatabaseWriter" as dbmgr <<storage>>
  database "SQLite / Qdrant /\nGraphDB (.data/knowledge-graph)" as storage <<storage>>
}

package "Dashboard Visualization" {
  component "multi-agent-graph.tsx\n(WAVE_AGENTS)" as graphviz <<external>>
  component "ukb-workflow-modal.tsx\n(calculateDynamicEta)" as etamodal <<external>>
}

restart --> vkbserver : "restarts on failure"
restart --> restart : "supervisorctlRestart, log"

apiclient --> vkbserver : "HTTP GET /api/health\n(lenient check)"
clicli --> vkbserver : "HTTP GET /api/health\n(duplicate lenient check)"

clicli --> dbmgr : "direct write (add-entity/relation)"
clicli --> vkbserver : "HTTP write (update-entity, if running)"
dbmgr --> storage : "initialize()/write"
vkbserver ..> dbmgr : "potential cache/state divergence"

graphviz ..> vkbserver : "stale 'GraphDB+LevelDB' reference"
etamodal ..> vkbserver : "client-side ETA, no backend contract"

@enduml