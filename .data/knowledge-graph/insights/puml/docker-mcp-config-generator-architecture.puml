@startuml
!include _standard-style.puml

package "Host-Side Resolver (external)" {
  component "features.json snapshot" as snapshot <<external>>
}

package "Container Entrypoint" {
  component "docker/entrypoint.sh" as entrypoint <<core>>
  component "PROGRAM_FEATURES mapping" as mapping <<core>>
  component "/etc/supervisor/features.d/disabled.conf" as disabledconf <<storage>>
}

package "Service Orchestration" {
  component "start-services.sh" as startsh <<cli>>
  component "scripts/start-services-robust.js" as robust <<core>>
  component "SERVICE_CONFIGS / SERVICE_ORDER" as configs <<core>>
  component "waitForPortBindable" as waitport <<agent>>
}

package "Validation" {
  component "tests/features/service-gating.test.mjs" as tests <<api>>
  component "lib/features/catalogue.cjs (FEATURE_IDS)" as catalogue <<storage>>
}

snapshot --> entrypoint : "read (read-only mount)"
entrypoint --> mapping : "iterate PROGRAM_FEATURES"
mapping --> disabledconf : "write autostart=false\n(fail-open on missing/unknown)"

startsh --> robust : "ROBUST_MODE dispatch"
robust --> configs : "declares services"
configs --> waitport : "healthCheckFn / retry logic"

tests --> configs : "structural coverage assertions"
tests --> catalogue : "validate feature ids"

@enduml