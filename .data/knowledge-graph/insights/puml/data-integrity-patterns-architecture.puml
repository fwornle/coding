@startuml
!include _standard-style.puml

package "Metadata Merge Bug (Conceptual Target)" {
  component "Manifest-Level Descriptions" as manifest <<core>>
  component "Graph-Level Descriptions" as graph <<core>>
  component "Merge Reconciliation Logic\n(not present in retrieval)" as merge <<core>>
  component "Published Documentation Page" as docpage <<external>>
}

package "Adjacent Retrieved Evidence" {
  component "EntityPatternAnalyzer" as epa <<core>>
  component "checkLocalArtifact()" as local <<core>>
  component "matchArtifactPattern()" as regexmatch <<core>>
  component "verify-patterns.sh" as verify <<cli>>
  database "$SHARED_MEMORY JSON" as sharedmem <<storage>>
}

manifest --> merge : "must sync with"
graph --> merge : "must sync with"
merge --> docpage : "publishes freshly measured figures"

epa --> local : "step 1: directory match"
epa --> regexmatch : "step 2: regex fallback"

verify --> sharedmem : "jq read-modify-write\n(.tmp && mv)"

sharedmem ..> merge : "structurally similar\nread-modify-write pattern"

@enduml