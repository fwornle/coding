}

patterns --> conventions : "defines retroactive taxonomy"
conventions --> readme : "referenced by"
readme --> mgr : "groups files by suffix"
readme --> svc
readme --> adapter
readme --> provider

adapter --> transcript : "manifests as"
mgr --> waveagents : "manifests as"

conventions ..> transcript : "no enforcement,\nname-driven only"
conventions ..> waveagents : "no linter rule"

@enduml