@startuml
!include _standard-style.puml

package "Layer 1: Inference" {
  component "EntityPatternAnalyzer" as epa <<core>>
  component "extractArtifacts()" as extract <<core>>
  component "checkLocalArtifact()\n(0.9 confidence)" as pathmatch <<core>>
  component "matchArtifactPattern()\n(0.75 confidence)" as namematch <<core>>
  component "inferEntityClass()\nteamMappings" as inferclass <<core>>
}

package "Convention Sources" {
  component "artifactPatterns\n(entity ClassMap)" as patterns <<storage>>
  component "Team Sub-dialects\n(LSL, MCP, K8s, ReSi, UI)" as dialects <<storage>>
}

package "Layer: Enforcement" {
  component "verify-patterns.sh" as verify <<cli>>
  database "$SHARED_MEMORY" as sharedmem
}

component "XAML/C# Fixtures\n(*ViewModel/*View)\nUNRECOGNIZED" as xaml <<external>>

epa --> extract : "regex over class names"
extract --> pathmatch : "try direct path"
pathmatch --> namematch : "fallback if no path match"
namematch --> patterns : "matches suffix regex"
namematch --> inferclass : "infers team/entity Class"
inferclass --> dialects : "duplicates mapping"
patterns --> dialects : "overlaps with"

sharedmem --> verify : "supplies TransferablePattern list"
verify --> sharedmem : "writes pattern_compliance_score"
verify ..> patterns : "measures compliance\n(inverse of inference)"

xaml ..> extract : "not matched\n(TS/JS file bias)"

@enduml