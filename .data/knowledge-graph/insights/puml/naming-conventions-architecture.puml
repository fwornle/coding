package "Documentation" {
  component "CodingPatterns" as patterns <<core>>
  component "architecture/README.md" as readme <<core>>
  component "NamingConventions (informal)" as conventions <<core>>
}

package "Suffix Taxonomy" {
  component "*Manager" as mgr <<agent>>
  component "*Service" as svc <<core>>
  component "*Adapter" as adapter <<core>>
  component "*Provider" as provider <<core>>
}

package "Example Classes" {
  component "TranscriptAdapter" as transcript <<core>>
