@startuml
!include _standard-style.puml

package "Drift Guard Testing" {
  component "copilot-model-ids.test.mjs" as testGuard <<cli>>
  component "align-copilot-model-ids.mjs" as alignScript <<core>>
  component "Dockerfile build step" as dockerBuild <<core>>
}

package "Cost Accounting" {
  component "cost-model.ts" as costModel <<core>>
  component "priceForModel()" as priceFn <<core>>
  component "freshInputTokens()" as freshFn <<core>>
}

package "LLM Routing UI" {
  component "offload-decision.tsx" as offloadUI <<agent>>
  component "use-classifier-judge.ts" as judgeHook <<agent>>
  component "offload-gates.ts" as offloadGates <<core>>
}

cloud "rapid-llm-proxy" as proxy <<external>>

testGuard --> alignScript : "asserts rewrite of retired ids"
testGuard --> dockerBuild : "checks script runs after npm install"
alignScript --> proxy : "corrects vendored @rapid/llm-proxy dist"

costModel --> priceFn : "exact -> fast-suffix -> family fallback"
costModel --> freshFn : "no-op (defect removed)"
priceFn --> proxy : "prices routed model"

offloadUI --> offloadGates : "client-side restatement"
offloadUI --> proxy : "GET /api/llm/routing/resolve"
offloadUI --> judgeHook : "composes separate hook"
judgeHook --> proxy : "writes config/prompt-classifier.yaml"

@enduml