@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Semantic Analysis Integration" {
  component "code-graph-agent.ts" as codeGraphAgent <<agent>>
  component "graphify-graph.ts" as graphify <<agent>>
}

package "KnowledgeManagement" {
  component "VKB Server" as vkb <<core>>
  component "ukb-trace-report.ts" as traceReport <<cli>>
  component "migrate-graph-db-entity-types.js" as migrateScript <<core>>
  database "KMCore\n(Graph Database)" as kmcore <<storage>>
  database "LevelDB\n(legacy)" as leveldb <<storage>>
}

package "Test & Validation" {
  component "migrate-leveldb-to-kmcore.test.ts" as migrateTest <<cli>>
}

cloud "Downstream Consumers\n(agents, cross-project sync)" as consumers <<external>>

codeGraphAgent --> graphify : "extracts entities"
graphify --> vkb : "populates graph"

vkb --> kmcore : "query/store"
vkb --> traceReport : "reports decay state"
vkb ..> leveldb : "replaced by"

migrateScript --> kmcore : "migrates schema"
migrateScript --> leveldb : "reads legacy data"
migrateTest --> migrateScript : "validates"
migrateTest --> kmcore : "asserts schema"

consumers --> vkb : "stable query API"

@enduml