@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Consumer Layer" {
  component "CodeGraphAgent" as cga <<agent>>
  component "wave-controller" as wc <<agent>>
}

package "Graph Access Layer" {
  component "GraphifyGraph" as gg <<core>>
  component "kindOf/nameOf" as helpers <<core>>
  component "mapRelation" as mapper <<core>>
}

package "Storage & Migration" {
  database "graph.json" as gjson <<storage>>
  database "GraphDatabaseService\n(Graphology/LevelDB)" as gds <<storage>>
  component "migrate-graph-db-entity-types.js" as mig1 <<cli>>
  component "migrate-leveldb-to-kmcore.mjs" as mig2 <<cli>>
}

cga --> gg : "delegates all calls"
gg --> gjson : "mtime-based lazy load"
gg --> helpers : "derive type/name from label"
gg --> mapper : "normalize edge types"

wc --> gg : "queryIncomingRelations(name, entity Type)"
wc --> gg : "anchor to 'Coding' if orphan"

mig1 --> gds : "consolidate entity types\n(System/Project/Pattern)"
mig2 --> gds : "convert to km-core shape\n(UUIDv7, layer=evidence)"
mig2 --> gjson : "source legacy blobs"

@enduml