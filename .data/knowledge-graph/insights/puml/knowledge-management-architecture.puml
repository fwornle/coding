@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Consumers" {
  component "Agents" as agents <<agent>>
  component "CLI Tools" as cli <<cli>>
}

package "VKB Service" {
  component "VKB Server" as vkb <<api>>
  component "Decay Tracking Subsystem" as decay <<core>>
}

package "Storage Layer" {
  database "KMCore Graph DB" as kmcore <<storage>>
  database "LevelDB (legacy)" as leveldb <<storage>>
}

package "Migration & Lifecycle" {
  component "migrate-leveldb-to-kmcore.test.ts" as migtest <<cli>>
  component "migrate-graph-db-entity-types.js" as migschema <<cli>>
}

agents --> vkb : "CRUD / query"
cli --> vkb : "CRUD / query"

vkb --> kmcore : "graph read/write"
vkb --> decay : "score/filter results"
decay --> kmcore : "reads timestamp/confidence metadata"

migtest --> leveldb : "reads legacy entities"
migtest --> kmcore : "validates transformed entities"
migschema --> kmcore : "in-place schema updates"

migtest ..> vkb : "requires maintenance mode"
migschema ..> vkb : "requires maintenance mode"

@enduml