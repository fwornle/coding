@startuml
!include _standard-style.puml

package "Agents" {
  component "CodeGraphAgent" as cga <<agent>>
  component "GraphifyGraph" as gg <<agent>>
}

package "Migration Scripts" {
  component "migrate-graph-db-entity-types.js" as migTypes <<cli>>
  component "migrate-leveldb-to-kmcore.mjs" as migCore <<cli>>
}

package "Core Storage" {
  component "GraphDatabaseService" as gds <<core>>
  database "LevelDB" as ldb <<storage>>
  component "graph.json (NetworkX export)" as gjson <<external>>
}

component "History Sidebar Viewer" as viewer <<external>>

gg --> gjson : "parses label strings\nfor kind/name"
cga --> gg : "delegates reads\n(compat shim)"

cga --> gds : "queryIncomingRelations /\nstoreRelationship (by type+name)"
gds --> ldb : "_persistGraphToLevel()\nwhen isDirty"

migTypes --> gds : "collapses 6 types\ninto 'Pattern'"
migCore --> ldb : "--dry-run / error-budget\n(5% ok, 10% halts)"

gds ..> viewer : "Insight nodes\n(missing in Wave 4)"

@enduml