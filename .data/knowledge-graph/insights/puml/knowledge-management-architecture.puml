@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Runtime Path" {
  component "code-graph-agent.ts" as agent <<agent>>
  component "VKB Server" as vkb <<api>>
}

package "Storage Layer" {
  database "KMCore Graph DB" as kmcore <<storage>>
  database "LevelDB (legacy)" as leveldb <<storage>>
}

package "Administrative Path" {
  component "migrate-graph-db-entity-types.js" as migscript <<cli>>
  component "migrate-leveldb-to-kmcore.test.ts" as migtest <<cli>>
}

package "Documentation & Ontology" {
  component "cross-project-knowledge.md" as crossdoc <<external>>
  component "RELEASE-2.0.md ontology" as release2 <<external>>
}

agent --> vkb : "entity persistence ops"
vkb --> kmcore : "query / mutate graph"
vkb ..> leveldb : "legacy access (deprecated)"

migscript --> kmcore : "bulk schema updates"
migtest --> leveldb : "validate source data"
migtest --> kmcore : "validate migrated data"

kmcore --> vkb : "decay-aware query results"

crossdoc ..> vkb : "documents consumers"
release2 ..> kmcore : "ontology integration"

@enduml