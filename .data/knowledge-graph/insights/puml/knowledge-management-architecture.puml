@startuml
!include _standard-style.puml

package "Code Graph Layer" {
  component "GraphifyGraph" as graphify <<core>>
  component "CodeGraphAgent" as cgagent <<agent>>
  database "graph.json" as graphjson
}

package "km-core Storage" {
  component "km-core-adapter" as adapter <<core>>
  component "GraphDatabaseService" as gdbservice <<core>>
  database "LevelDB" as leveldb
}

package "Migration Tools" {
  component "migrate-graph-db-entity-types.js" as migtypes <<cli>>
  component "migrate-leveldb-to-kmcore.mjs" as migkmcore <<cli>>
}

component "History UI" as historyui <<api>>

cgagent --> graphify : delegates calls
graphify --> graphjson : "lazy mtime-cached read"

adapter --> leveldb : queryIncomingRelations/\nstoreRelationship (entity Type disambiguation)
adapter --> historyui : creates Insight nodes\n(source=wave-analysis)

migtypes --> gdbservice : consolidates types\n(System/Project/Pattern)
gdbservice --> leveldb : _persistGraphToLevel()

migkmcore --> leveldb : converts to canonical\nkm-core shape (UUIDv7, evidence)
migkmcore ..> migkmcore : "--dry-run validates\n5% error budget"

historyui ..> leveldb : filters entity Type='Insight'

@enduml