@startuml
!include _standard-style.puml

package "Graph Backend" {
  component "GraphifyGraph" as graphify <<agent>>
  component "CodeGraphAgent" as codeagent <<agent>>
  component "graph.json (node-link)" as graphjson <<external>>
}

package "Knowledge Store" {
  component "GraphDatabaseService" as gdbservice <<core>>
  database "LevelDB" as leveldb <<storage>>
  component "Graphology In-Memory Graph" as graphology <<core>>
}

package "Migration & Repair" {
  component "migrate-graph-db-entity-types.js" as migtypes <<cli>>
  component "migrate-leveldb-to-kmcore.mjs" as migkmcore <<cli>>
  component "Viewer / Evidence Panel" as viewer <<api>>
}

component "Wave Controller" as wavectrl <<agent>>

graphjson --> graphify : "mtime-based cache reparse"
graphify --> codeagent : "node ToCodeEntity() inference"

gdbservice --> graphology : "mutates in-memory"
graphology --> leveldb : "_persistGraphToLevel()"

migtypes --> graphology : "rewrite entity Type attrs"
migtypes --> gdbservice : "triggers persistence"

leveldb --> migkmcore : "legacy blob records"
migkmcore --> gdbservice : "km-core canonical entities"

wavectrl --> gdbservice : "storeRelationship(endpointTypes)"
wavectrl ..> viewer : "insight documents (no graph nodes)"

viewer --> gdbservice : "queryIncomingRelations(name, entity Type)"

@enduml