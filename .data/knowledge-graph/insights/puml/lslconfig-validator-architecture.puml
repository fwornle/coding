@startuml
!include _standard-style.puml

package "Config Validation (inferred)" {
  component "LSLConfigValidator" as validator <<core>>
  database ".specstory/config/lsl-config.json" as lslconfig <<storage>>
  component "validateUserEnvironment()" as userhash <<core>>
}

package "Live-Logging Pipeline (adjacent)" {
  component "ObservationWriter" as writer <<core>>
  component "loadConfig()" as loadcfg <<core>>
  database ".observations/config.json" as obsconfig <<storage>>
  component "ObservationConsolidator" as consolidator <<core>>
  component "ObservationExporter" as exporter <<core>>
  component "enhanced-transcript-monitor" as monitor <<cli>>
}

package "Operational Health" {
  component "health-coordinator.js" as health <<core>>
  cloud "obs-api" as obsapi <<external>>
}

validator --> lslconfig : "validates schema"
validator --> userhash : "derives 6-char hash"
validator ..> health : "config feeds (unconfirmed)"

writer --> loadcfg : "loads"
loadcfg --> obsconfig : "defaults/reads"
monitor --> writer : "invokes"
writer --> consolidator : "hands off observations"
consolidator --> exporter : "consolidated data"
consolidator --> obsapi : "km-core writes"
writer --> obsapi : "km-core writes"

health --> obsapi : "PID/heartbeat staleness checks"

@enduml