@startuml
!include _standard-style.puml

package "Validation Layer" {
  component "LSLConfigValidator" as validator <<core>>
  component "lsl-config.json" as lslConfig <<storage>>
  component "redaction-config.yaml" as redactConfig <<storage>>
}

package "Live Logging Consumers" {
  component "ObservationWriter" as obsWriter <<core>>
  component "ConfigurableRedactor" as redactor <<core>>
  component "getLSLWindow" as window <<core>>
}

package "Token Accounting Subsystem" {
  component "token-db.mjs" as tokenDb <<storage>>
  component "copilot-events-tail.mjs" as copilotTail <<agent>>
  component "opencode-token-rows.mjs" as opencodeRows <<agent>>
}

validator --> lslConfig : "validates directory/health/perf"
validator --> redactConfig : "validates redaction schema"

redactConfig --> redactor : "consumed by (implicit contract)"
obsWriter --> redactor : "instantiates for PII redaction"
obsWriter --> window : "session windowing"

validator ..> tokenDb : "userHashLength bound\nprotects user_hash charset"
tokenDb --> opencodeRows : "shares uid-ownership pattern"
copilotTail ..> validator : "degraded parity\noutside validation surface"

lslConfig --> window : "directory structure assumed"

@enduml