@startuml
!include _standard-style.puml

package "Entry Points" {
  component "start-services.sh" as legacy <<cli>>
  component "ROBUST_MODE branch" as robustMode <<cli>>
}

package "Robust Orchestration" {
  component "start-services-robust.js" as robust <<core>>
  component "SERVICE_CONFIGS / SERVICE_ORDER" as configs <<core>>
  component "lib/service-starter.js" as libStarter <<core>>
  component "startServiceWithRetry" as retry <<core>>
  component "waitForPortBindable" as portWait <<core>>
  component "isProcessRunningByScript" as pgrep <<core>>
}

package "Container-Side Gating" {
  component "docker/entrypoint.sh" as entrypoint <<external>>
  component "PROGRAM_FEATURES" as progFeatures <<core>>
  component "supervisord include files" as supervisord <<external>>
}

package "Validation & Policy" {
  component "service-gating.test.mjs" as gatingTest <<agent>>
  component "container-gating.test.mjs" as containerTest <<agent>>
  component "Health Verification Workflow" as healthPolicy <<agent>>
}

legacy --> robustMode : "ROBUST_MODE=true"
robustMode --> robust : "execs"
legacy ..> legacy : "legacy fallback (kill_port)"

robust --> configs : "defines"
robust --> libStarter : "uses"
libStarter --> retry : "drives"
retry --> pgrep : "PSM fallback check"
retry --> portWait : "poll before spawn"
portWait ..> retry : "avoids EADDRINUSE"

configs --> gatingTest : "asserted by"
gatingTest --> configs : "validates SERVICE_ORDER"

entrypoint --> progFeatures : "reads features.json"
progFeatures --> supervisord : "writes autostart=false"
containerTest --> progFeatures : "validates mapping"

healthPolicy --> robust : "governs post-rebuild checks"
healthPolicy --> entrypoint : "governs post-rebuild checks"

@enduml