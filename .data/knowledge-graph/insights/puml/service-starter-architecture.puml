@startuml
!include _standard-style.puml

package "Legacy Path" {
  component "start-services.sh" as legacy <<cli>>
}

package "Robust Path (Node)" {
  component "start-services-robust.js" as robust <<core>>
  component "SERVICE_CONFIGS / SERVICE_ORDER" as svcconf <<core>>
  component "loadFeatures()" as loadfeat <<core>>
  component "waitForPortBindable()" as portbind <<core>>
  component "killProcessOnPortAndWait()" as killport <<core>>
  component "isProcessRunningByScript()" as orphan <<core>>
  component "ProcessStateManager" as psm <<storage>>
}

package "Container Path" {
  component "docker/entrypoint.sh" as entrypoint <<cli>>
  component "PROGRAM_FEATURES mapping" as progfeat <<core>>
  component "features.json snapshot" as snapshot <<storage>>
}

component "transcriptMonitor service" as transcript <<agent>>
component "prompt-classifier-service.mjs" as classifier <<agent>>

legacy --> robust : "ROBUST_MODE=true delegates to"
robust --> svcconf : "iterates"
svcconf --> loadfeat : "checks feature gate"
svcconf --> transcript : "starts (required=true)"
transcript --> orphan : "PSM+pgrep tri-check"
orphan --> psm : "registerService/isServiceRunning"
robust --> portbind : "verify port bindable"
robust --> killport : "SIGTERM->SIGKILL escalation"

entrypoint --> progfeat : "maps features to services"
entrypoint --> snapshot : "reads (fail-open if missing)"
progfeat ..> svcconf : "must stay in sync (manual)"

classifier ..> robust : "shares env-driven fail-open philosophy"

@enduml