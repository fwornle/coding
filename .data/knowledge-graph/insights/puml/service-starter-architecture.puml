@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Wrapper Scripts" {
  component "api-service.js" as api <<cli>>
  component "dashboard-service.js" as dash <<cli>>
}

package "ServiceStarter Core" {
  component "startServiceWithRetry()" as retry <<core>>
  component "withDeadline()" as deadline <<core>>
}

package "Managed Services" {
  component "MCP Service" as mcp <<agent>>
  component "Constraint Monitor" as constraint <<agent>>
  component "Graphify" as graphify <<agent>>
  component "LLM Service" as llm <<agent>>
}

api --> retry : "start + health-check fns"
dash --> retry : "start + health-check fns"

retry --> deadline : "bounds attempt duration"
retry --> retry : "exponential backoff retry"

retry --> mcp : "required/optional start"
retry --> constraint : "required/optional start"
retry --> graphify : "required/optional start"
retry --> llm : "required/optional start"

@enduml