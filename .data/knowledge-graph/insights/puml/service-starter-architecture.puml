@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Service Wrappers" {
  component "api-service.js" as apiSvc <<cli>>
  component "dashboard-service.js" as dashSvc <<cli>>
}

package "Orchestration Layer" {
  component "ServiceStarter\n(startServiceWithRetry)" as starter <<core>>
  component "withDeadline()" as deadline <<core>>
  component "ProcessStateManager" as psm <<core>>
}

package "Container Supervision" {
  component "entrypoint.sh" as entry <<cli>>
  component "supervisord.conf" as supervisord <<external>>
  cloud "Qdrant / Redis" as datastores <<external>>
}

apiSvc --> psm : "register/unregister PID"
dashSvc --> psm : "register/unregister PID"
dashSvc ..> apiSvc : "hardcoded\nNEXT_PUBLIC_API_BASE_URL"

starter --> deadline : "start/health-check\n(deadline-guarded)"
starter --> psm : "tracks spawned pid/port"
starter --> starter : "SIGTERM->SIGKILL\non health-check failure"

entry --> supervisord : "autostart overrides\n(fail-open feature gating)"
entry --> datastores : "wait_for_service()\n(fail-open readiness poll)"

apiSvc ..> starter : "not yet adopted\n(inline spawn logic)"
dashSvc ..> starter : "not yet adopted\n(inline spawn logic)"

@enduml