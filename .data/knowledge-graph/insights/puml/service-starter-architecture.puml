@startuml
!include _standard-style.puml

package "Entry Point" {
  component "start-services.sh" as shim <<cli>>
  component "start-services-robust.js" as orchestrator <<core>>
}

package "Service Starter Core" {
  component "lib/service-starter.js" as libStarter <<core>>
  component "SERVICE_CONFIGS / SERVICE_ORDER" as configs <<core>>
  component "ProcessStateManager (PSM)" as psm <<storage>>
  component "pgrep Orphan Detector" as pgrep <<agent>>
  component "Port Shutdown/Startup Race Logic" as portlogic <<core>>
}

package "Container-Side Gating" {
  component "docker/entrypoint.sh" as entrypoint <<cli>>
  component "features.json snapshot" as features <<storage>>
  component "supervisord.conf overrides" as supervisord <<external>>
}

component "service-gating.test.mjs" as tests <<agent>>

shim --> orchestrator : "execs when ROBUST_MODE=true"
orchestrator --> configs : "declares service map"
orchestrator --> libStarter : "startServiceWithRetry / health checks"
orchestrator --> psm : "isServiceRunning checks"
orchestrator --> pgrep : "fallback reconciliation"
pgrep --> psm : "re-registers orphans"
orchestrator --> portlogic : "SIGTERM->SIGKILL, TCP bind probe"

entrypoint --> features : "reads read-only snapshot"
entrypoint --> supervisord : "generates disabled.conf"

tests --> configs : "validates structural invariants"

orchestrator ..> entrypoint : "parallel container-side gating"

@enduml