@startuml
!include _standard-style.puml

package "Ontology Subsystem" {
  component "createOntologySystem()" as ontsys <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "OntologyValidator" as validator <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "repair-writer-ontology-class.mjs\n(arbitrate())" as repair <<cli>>
}

package "Health & Batch Coordination" {
  component "health-coordinator.js\n(currentState, shouldInject)" as health <<core>>
  component "sub_agent_capture\n(claude, opencode, copilot)" as subagents <<agent>>
  component "batch-progress.tsx" as batch <<external>>
}

package "External Services" {
  component "obs-api (port 12436)" as obsapi <<api>>
  cloud "Batch API (port 3033)" as batchapi <<external>>
}

ontsys --> classifier : "wires"
ontsys --> validator : "wires"
ontsys --> adapter : "requires (no mock fallback)"
repair --> obsapi : "HTTP client"
repair ..> classifier : "resolves conflicts for"

health --> subagents : "tracks heartbeat freshness"
batch --> batchapi : "fetchProgress/fetchHistory"

subagents .. health : "pi entry absent"

@enduml