@startuml
!include _standard-style.puml

package "Missing: AgentLaunchers (unresolved)" {
  component "AgentLaunchers" as launcher <<core>>
}

package "Agent Contract (parent context, not retrieved here)" {
  component "BaseAgent" as base <<agent>>
  component "OntologyClassificationAgent" as ontAgent <<agent>>
  component "SemanticAnalysisAgent" as semAgent <<agent>>
}

package "Adjacent Retrieved Components" {
  component "createOntologySystem()" as ontSys <<core>>
  component "OntologyClassifier" as classifier <<core>>
  component "InferenceEngine" as inference <<external>>
  component "health-coordinator.js" as health <<external>>
  component "repair-writer-ontology-class.mjs" as repair <<external>>
  component "batch-progress.tsx" as dashboard <<external>>
}

launcher ..> base : "expected to instantiate\n(not found)"
base <.. ontAgent : "implements template method"
base <.. semAgent : "implements template method"

launcher ..> ontSys : "closest analog\n(builds infra, not agent)"
ontSys --> classifier : "wires"
ontSys --> inference : "requires"

ontAgent ..> classifier : "uses (per parent context)"

health ..> semAgent : "tracks liveness only"
repair ..> ontAgent : "repairs written data,\nnot a launcher"
dashboard ..> launcher : "polls progress,\nno launch logic"

@enduml