@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Mode & Routing" {
  component "llm-mock-service.ts" as mock <<core>>
  database "workflow-progress.json" as wf
}

package "Providers" {
  component "dmr-provider.ts" as dmr <<core>>
  component "dmr-config.yaml loader" as dmrcfg <<core>>
  cloud "Docker Model Runner" as dockermr <<external>>
}

package "Proxy Wrapper" {
  component "llm-with-process.ts" as proxy <<core>>
  cloud "@rapid/llm-proxy SDK" as sdk <<external>>
  cloud "Anthropic / OpenAI / Groq" as extllm <<external>>
}

package "Response Hardening" {
  component "parse-llm-json.ts" as parser <<core>>
}

mock --> wf : "reads/writes per-agent mode"
mock --> dmr : "routes to local when mode=local"
mock --> proxy : "routes to public when mode=public"

dmr --> dmrcfg : "loadDMRConfig()"
dmr --> dockermr : "health-checked calls"

proxy --> sdk : "wraps, injects 'process' field"
sdk --> extllm : "forwards completion requests"

dmr --> parser : "repairs malformed JSON"
proxy --> parser : "repairs malformed JSON"

@enduml