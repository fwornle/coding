@startuml
!include _standard-style.puml

package "Routing & Mode Resolution" {
  component "getLLMMode()\n(llm-mock-service.ts)" as mode <<core>>
  component "Routing Tier Priority\n(max-sub > work/Copilot > Groq)" as tier <<core>>
}

package "Providers" {
  component "dmr-provider.ts" as dmr <<api>>
  component "loadDMRConfig()\ndmr-config.yaml" as dmrconf <<core>>
  cloud "Docker Model Runner" as dmrsvc <<external>>
  cloud "Anthropic/OpenAI/Groq Clients" as extllm <<external>>
}

package "Proxy & Utilities" {
  component "llm-with-process.ts\n(direct-fetch bypass)" as procfetch <<core>>
  component "@rapid/llm-proxy SDK" as proxy <<api>>
  component "parse-llm-json.ts\n(JSON repair pipeline)" as jsonparse <<core>>
}

mode --> tier : "resolves agent run mode"
tier --> dmr : "last-resort fallback"
tier --> extllm : "primary/high-tier requests"

dmr --> dmrconf : "loads config"
dmrconf --> dmrsvc : "resolves baseUrl (env expansion)"
dmr --> dmrsvc : "cached health check"

procfetch --> proxy : "bypasses missing 'process' field"
procfetch --> extllm : "attributes tokens per pipeline stage"

extllm --> jsonparse : "raw completion text"
dmr --> jsonparse : "raw completion text"

@enduml