@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Mode Resolution" {
  component "LLM Mock Service\n(getLLMMode)" as mockSvc <<core>>
  component "workflow-progress.json" as wfProgress <<storage>>
}

package "Local Provider" {
  component "DMR Provider" as dmrProvider <<core>>
  component "dmr-config.yaml" as dmrConfig <<storage>>
  cloud "Docker Model Runner" as dmr <<external>>
}

package "Proxy & Cost" {
  component "LLM With Process\n(resolveProxyCompleteUrl)" as llmProcess <<core>>
  cloud "rapid-llm-proxy" as proxy <<external>>
  component "Cost Model\n(priceForModel)" as costModel <<core>>
}

mockSvc --> wfProgress : "reads per-agent override"
mockSvc ..> mockSvc : "CODING_ROOT path normalization"

dmrProvider --> dmrConfig : "loadDMRConfig (multi-path)"
dmrProvider --> dmr : "health-checked, cached"

llmProcess --> proxy : "4-tier env var resolution"
llmProcess --> costModel : "normalized token usage"

mockSvc --> dmrProvider : "delegates when mock disabled"
mockSvc --> llmProcess : "delegates to external proxy"

@enduml