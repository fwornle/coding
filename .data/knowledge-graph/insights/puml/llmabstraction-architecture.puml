@startuml
!include _standard-style.puml

package "LLM Abstraction Layer" {
  component "getLLMMode()\n(llm-mock-service.ts)" as modeRes <<core>>
  component "llm-with-process.ts" as wrapper <<core>>
  component "dmr-provider.ts" as dmr <<core>>
  component "parse-llm-json.ts" as parser <<core>>
}

package "State & Catalogue" {
  database "workflow-progress.json" as state
  component "Model Catalogue\n(Endpoint-Gated Rules)" as catalogue <<storage>>
}

package "External Services" {
  cloud "proxy-bridge/server.mjs\n(llm-cli-proxy)" as proxy <<external>>
  component "Docker Model Runner" as dmrClient <<external>>
}

component "@rapid/llm-proxy SDK\n(LLMService)" as sdk <<external>>

modeRes --> state : "reads/writes mode"
wrapper --> proxy : "HTTP /api/complete"
wrapper ..> sdk : "parallel impl, kept in sync"
dmr --> dmrClient : "singleton client"
dmr --> dmr : "healthCheckInterval cache"
wrapper --> catalogue : "validates endpoint/model"
proxy --> catalogue : "gates access"
wrapper --> parser : "repairs malformed JSON"
modeRes --> wrapper : "selects mode"
modeRes --> dmr : "selects local tier"

@enduml