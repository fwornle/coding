@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Mode Management" {
  component "llm-mock-service.ts" as mock <<core>>
  database ".data/workflow-progress.json" as state <<storage>>
}

package "Providers" {
  component "dmr-provider.ts" as dmr <<core>>
  component "dmr-config.yaml" as dmrconfig <<storage>>
  cloud "Docker Model Runner" as dmrhost <<external>>
  component "llm-with-process.ts" as proxywrap <<core>>
  cloud "rapid-llm-proxy" as proxy <<external>>
}

package "Reliability & Metrics" {
  component "parse-llm-json.ts" as parser <<core>>
  component "MetricsTrackerLike" as metrics <<core>>
  component "wave-controller.ts" as wave <<agent>>
}

mock --> state : "reads/writes LLMState\n(globalMode, perAgentOverrides)"
mock --> state : "dual-writes legacy\nprogress.mockLLM"

dmr --> dmrconfig : "loadDMRConfig()\nexpandEnvVars()"
dmr --> dmrhost : "OpenAI-compatible\nrequests"
dmr ..> dmr : "cached checkDMRAvailability()"

proxywrap --> proxy : "resolveProxyCompleteUrl()\nfetch /api/complete"
proxywrap --> metrics : "populates via\nMetricsTrackerLike"

mock --> proxywrap : "getLLMMode() precedence\nresolution"
mock --> dmr : "mode toggle\n(mock/local/public)"

parser --> proxywrap : "repairs JSON-mode\noutput"
wave --> metrics : "getDetailedCalls()\ngetLLMMetrics()"

@enduml