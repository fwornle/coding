@startuml
!include _standard-style.puml

package "Routing Layer" {
  component "LLM Mock Service\n(getLLMMode)" as mock <<core>>
  component "Routing Tier Priority\n(max-sub > work/Copilot > Groq)" as router <<core>>
}

package "Provider Access" {
  component "llm-with-process.ts" as withproc <<core>>
  component "resolveProxyCompleteUrl()" as resolveurl <<core>>
  component "dmr-provider.ts\n(loadDMRConfig/checkDMRAvailability)" as dmr <<core>>
  component "parseLlmJson()" as parser <<core>>
}

package "External Services" {
  cloud "rapid-llm-proxy" as proxy <<external>>
  cloud "Docker Model Runner" as dmrsvc <<external>>
  cloud "Groq Llama-70B" as groq <<external>>
}

mock --> router : "resolves active mode"
router --> withproc : "dispatches by tier"
withproc --> resolveurl : "resolves proxy URL"
resolveurl --> proxy : "POST /api/complete"
withproc --> parser : "normalizes/repairs JSON"
router --> dmr : "checks DMR availability"
dmr --> dmrsvc : "health check (cached)"
router --> groq : "last-resort fallback"
proxy ..> groq : "cleared as timeout source"

@enduml