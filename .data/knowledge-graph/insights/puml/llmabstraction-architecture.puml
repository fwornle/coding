@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Mode Resolution" {
  component "getLLMMode()" as mode <<core>>
  component "isMockLLMEnabled()\ngetLLMState()" as state <<core>>
  database "workflow-progress.json" as progress <<storage>>
}

package "Provider Layer" {
  component "DMRProvider" as dmr <<agent>>
  component "loadDMRConfig()\nexpandEnvVars()" as dmrconfig <<core>>
  component "checkDMRAvailability()" as dmrhealth <<core>>
  cloud "Docker Model Runner" as dmrRuntime <<external>>
}

package "Process-Tagged Path" {
  component "llmWithProcessComplete()" as proc <<agent>>
  cloud "LLM Proxy\n(RAPID/CLI/generic/localhost)" as proxy <<external>>
  component "cost-model.ts\npriceForModel()" as cost <<core>>
}

mode --> state : "resolves mode"
state --> progress : "reads/writes\n(CODING_ROOT aware)"

mode --> dmr : "dispatch to local"
dmr --> dmrconfig : "load YAML config"
dmr --> dmrhealth : "cached availability"
dmrhealth --> dmrRuntime : "models.list()"
dmrconfig --> dmrRuntime : "OpenAI-compatible client"

mode --> proc : "bypasses SDK"
proc --> proxy : "fetch + process tag"
proc --> cost : "normalized token usage"
cost --> cost : "isOpenAIWireProvider()\nmodelFamily() fallback"

@enduml