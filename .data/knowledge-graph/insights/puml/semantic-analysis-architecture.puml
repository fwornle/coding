@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Input Sources" {
  component "Git History\n(diffs/commits)" as git <<external>>
  component "LSL Session Logs" as lsl <<external>>
}

package "Batch Analysis Pipeline" {
  component "base-agent.ts" as base <<core>>
  component "semantic-analysis-agent.ts" as semantic <<agent>>
  component "ontology-classification-agent.ts" as ontology <<agent>>
}

package "Knowledge Storage" {
  database "Ontology / Knowledge Graph Store" as kg <<storage>>
}

git --> semantic : "raw commit/diff data"
lsl --> semantic : "session transcripts"

base --> semantic : "provides LLM invocation,\nprompt templating"
base --> ontology : "provides LLM invocation,\nprompt templating"

semantic --> ontology : "extracted knowledge entities"

ontology --> kg : "persists classified entities"

@enduml