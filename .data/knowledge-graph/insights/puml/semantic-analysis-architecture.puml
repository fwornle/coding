@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Data Sources" {
  component "Git History" as git <<external>>
  component "LSL Session Data" as lsl <<external>>
}

package "Agent Pipeline" {
  component "BaseAgent" as base <<core>>
  component "SemanticAnalysisAgent" as saa <<agent>>
  component "OntologyClassificationAgent" as oca <<agent>>
  component "L2 Subsystem Classifier" as l2 <<agent>>
  component "LLMService" as llm <<external>>
}

package "Ontology & Storage" {
  component "OntologyRegistry" as reg <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  database "Knowledge Graph" as kg <<storage>>
  component "coding.lower.json" as codingjson <<storage>>
}

git --> saa : "code/commit analysis"
lsl --> saa : "vibe/session analysis"
saa --> llm : "generates semantic insights"
base --> saa : "execute() pipeline"
base --> oca : "execute() pipeline"

saa --> oca : "observations"
oca --> reg : "constructs"
reg --> adapter : "wrapped by"
oca --> llm : "LLM-backed classification"
oca --> l2 : "refines L1 classes"
l2 --> codingjson : "loadL2Classes()"
l2 --> llm : "buildL2RefinementPrompt()"

oca --> kg : "persists classified entities"
adapter --> kg : "validates/classifies"

@enduml