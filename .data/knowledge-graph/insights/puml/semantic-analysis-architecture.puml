@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Input Sources" {
  component "Git History" as git <<external>>
  component "LSL Session Data" as lsl <<external>>
}

package "Pipeline Agents" {
  component "base-agent.ts" as base <<core>>
  component "semantic-analysis-agent.ts" as semantic <<agent>>
  component "ontology-classification-agent.ts" as ontology <<agent>>
  component "Hierarchy Root Detection" as hierarchy <<agent>>
}

package "Knowledge Storage" {
  database "Knowledge Graph" as kg <<storage>>
}

git --> semantic : "parsed diffs/commits"
lsl --> semantic : "session logs"

base --> semantic : "LLM invocation utilities"
base --> ontology : "LLM invocation utilities"

semantic --> ontology : "extracted entities"
ontology --> hierarchy : "delegates root detection"

ontology --> kg : "structured knowledge entities"

@enduml