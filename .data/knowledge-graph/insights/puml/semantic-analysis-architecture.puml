@startuml
!include _standard-style.puml

package "Agent Framework" {
  component "BaseAgent" as base <<core>>
  component "SemanticAnalysisAgent" as sem <<agent>>
  component "OntologyClassificationAgent" as onto <<agent>>
}

package "LLM Layer" {
  component "LLMService (llm-proxy)" as llm <<external>>
  component "TokenLogger" as tokenlog <<core>>
}

package "Classification Data" {
  component "HIERARCHY_ROOTS (@fwornle/km-core)" as roots <<storage>>
  component "coding.lower.json (L2 Classes)" as l2json <<storage>>
}

component "Debug Trace Logs" as trace <<storage>>
component "KB Injection A/B Script" as kbscript <<external>>
component "CodingLowerOntologySource Bug" as bug <<external>>

base --> sem : "template method"
base --> onto : "template method"

sem --> llm : "ensureLLMInitialized()"
sem --> tokenlog : "attachTokenLogger()"
sem --> trace : "writes debug trace JSON"

onto --> roots : "hard-root-guard check"
onto --> llm : "classifier.classify()"
onto --> l2json : "loadL2Classes() / L2 refinement"
l2json ..> bug : "mismatch: emits despite doc ban"

kbscript ..> sem : "planned merge: batch missing-data capture"

@enduml