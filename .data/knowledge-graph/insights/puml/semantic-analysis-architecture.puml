@startuml
!include _standard-style.puml

package "Agent Framework" {
  component "BaseAgent" as base <<core>>
  component "SemanticAnalysisAgent" as sema <<agent>>
  component "OntologyClassificationAgent" as ocla <<agent>>
}

package "Ontology Loading" {
  component "upper.json" as upper <<storage>>
  component "coding-ontology.json" as coding <<storage>>
  component "coding.lower.json" as lower <<storage>>
  component "OntologyRegistry" as registry <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  component "OntologyValidator" as validator <<core>>
  component "OntologyClassifier" as classifier <<core>>
}

package "L2 Refinement (pure functions)" {
  component "loadL2Classes" as l2load <<core>>
  component "buildL2RefinementPrompt" as l2prompt <<core>>
  component "extractL2FromLLMResponse" as l2extract <<core>>
}

base --> sema : "execute() envelope"
base --> ocla : "execute() envelope"

upper --> registry : "loads L1 categories"
coding --> registry : "loads L1 categories"
lower --> registry : "loads L2 classes"

registry --> adapter : "wrapped by"
adapter --> validator : "unmodified API"
adapter --> classifier : "unmodified API"

ocla --> classifier : "classify()"
ocla --> validator : "validate"
ocla --> l2load : "filter REFINABLE_L1_PARENTS"
l2load --> l2prompt : "build prompt"
l2prompt --> l2extract : "parse LLM output"
l2extract --> ocla : "L2 class or fallback"

sema --> ocla : "output feeds taxonomy validation"

@enduml