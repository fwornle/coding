@startuml
!include _standard-style.puml

package "Agent Pipeline" {
  component "BaseAgent" as base <<core>>
  component "SemanticAnalysisAgent" as saa <<agent>>
  component "OntologyClassificationAgent" as oca <<agent>>
}

package "Classification Logic" {
  component "Hard-Root-Guard" as hrg <<core>>
  component "L2 Refinement\n(buildL2RefinementPrompt)" as l2ref <<core>>
  component "extractL2FromLLMResponse" as l2extract <<core>>
  component "OntologyClassifier" as classifier <<core>>
}

package "Data & Ontology Sources" {
  database "coding.lower.json\n(L2 Classes)" as l2json <<storage>>
  database "HIERARCHY_ROOTS\n(@fwornle/km-core)" as roots <<external>>
  database "Trace Logs\n(logs/semantic-analysis-trace-*.json)" as trace <<storage>>
}

cloud "LLM Service" as llm <<external>>

base --> saa : "template method\nexecute()"
base --> oca : "template method\nexecute()"

saa --> trace : "writes input snapshot"
saa --> llm : "requests semanticInsights"
saa --> saa : "merge heuristic +\nLLM patterns"

oca --> hrg : "checks observation name"
hrg --> roots : "matches root set"
oca --> classifier : "delegates if no guard match"
classifier --> l2ref : "builds closed-vocab prompt"
l2ref --> l2json : "reads REFINABLE_L1_PARENTS"
l2ref --> llm : "sends prompt"
llm --> l2extract : "free-text response"
l2extract --> classifier : "regex-matched L2 name\nor fallback to L1"

@enduml