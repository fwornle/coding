@startuml
!include _standard-style.puml

package "Docker Container Boundary" {
  component "docker/entrypoint.sh" as entrypoint <<core>>
  component "features.json snapshot" as snapshot <<storage>>
  component "supervisord features.d overlay" as overlay <<core>>
}

package "Service Launcher Layer" {
  component "scripts/start-services-robust.js\n(SERVICE_CONFIGS)" as launcher <<core>>
  component "ProcessStateManager" as psm <<core>>
  component "tests/features/service-gating.test.mjs" as tests <<cli>>
}

package "Dashboard Wrapper (inferred)" {
  component "DashboardServiceWrapper\n(not found in supplied files)" as dsw <<agent>>
  component "scripts/api-service.js\n(spawns dashboard-server.js)" as api <<core>>
  component "scripts/dashboard-service.js\n(wraps npm run dev)" as dashsvc <<core>>
}

snapshot --> entrypoint : "read-only mount"
entrypoint --> overlay : "generates autostart=false\nwhen health:false"
overlay --> dsw : "gates supervised dashboard\n(if registered)"

launcher --> psm : "registerService"
launcher ..> dsw : "structurally same\nwrapper-process pattern"
tests --> launcher : "asserts feature gating\nSERVICE_CONFIGS/SERVICE_ORDER"

dsw ..> api : "possible wrapper alias"
dsw ..> dashsvc : "possible wrapper alias"

snapshot ..> dsw : "drift causes silent\noutage (unresolved)"

@enduml