@startuml
!include _standard-style.puml

package "Ontology Types" {
  component "LayerResult" as lr <<core>>
  component "ArtifactMatch" as am <<core>>
}

package "EntityPatternAnalyzer.ts" {
  component "analyzeEntityPatterns()" as analyze <<core>>
  component "extractArtifacts()" as extract <<core>>
  component "checkLocalArtifact()" as local <<core>>
  component "matchArtifactPattern()" as regex <<core>>
  component "inferEntityClass()" as infer <<core>>
}

package "Hardcoded Rule Tables" {
  component "teamDirectories Map\n(Coding/RaaS/ReSi/UI)" as dirs <<storage>>
  component "artifactPatterns Array\n(RegExp + entity ClassMap)" as patterns <<storage>>
}

analyze --> extract : "1. extract candidates"
extract --> analyze : "Set<string> (ordered)"
analyze --> local : "2. try exact match"
local --> dirs : "lookup prefix"
local --> analyze : "0.9 confidence"
analyze --> regex : "3. fallback fuzzy match"
regex --> patterns : "lookup regex"
regex --> analyze : "0.75 confidence"
analyze --> infer : "classify team/entity"
infer --> patterns : "teamMappings"

analyze ..> lr : "returns"
analyze ..> am : "returns"

@enduml