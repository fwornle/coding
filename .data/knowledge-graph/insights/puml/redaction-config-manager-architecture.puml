@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Config Validation Stage" {
  component "LSLConfigValidator" as validator <<core>>
  database "redaction-config.yaml" as yamlcfg <<storage>>
}

package "Observation Write Path" {
  component "ObservationWriter" as writer <<core>>
  component "ConfigurableRedactor" as redactor <<core>>
  component "GraphKMStore\n(legacy-ingest adapters)" as kmstore <<storage>>
}

package "Secondary LSL Producers" {
  component "copilot-events-tail\n(200-char slice)" as copilot <<agent>>
  component "opencode-token-rows\n(240-char snip)" as opencode <<agent>>
  component "token-db\n(isolated user_hash)" as tokendb <<storage>>
}

validator --> yamlcfg : "validates schema"
yamlcfg ..> redactor : "assumed already loaded"
writer --> redactor : "constructs at init (projectRoot from dbPath)"
writer --> kmstore : "writes via legacyObservationToEntity"
redactor --> kmstore : "redacted content persisted"

copilot ..> writer : "no redactor import (asymmetric coverage)"
opencode --> tokendb : "insertTokenRow (no redaction)"
tokendb ..> kmstore : "separate SQLite store\n(external proxy schema)"

@enduml