@startuml
!include _standard-style.puml

package "Wave Analysis Pipeline" {
  component "Wave 4 Batch Analysis" as wave4 <<core>>
  component "WaveInsightPersistence" as wip <<core>>
  component "km-core-adapter.ts\n(findEntityByName fix)" as kmadapter <<core>>
}

package "Persistence Targets" {
  database "Insight Document Store" as docstore <<storage>>
  database "Knowledge Graph\n(Insight nodes)" as graph <<storage>>
}

package "Consumer Surfaces" {
  component "History UI\n(entity Type='Insight' filter)" as historyui <<external>>
  component "UKB Workflow Modal\n(HISTORY_PAGE_SIZE=50)" as ukbmodal <<external>>
  component "hierarchy-parents.test.ts\n(deriveParents)" as hierarchytest <<external>>
}

wave4 --> wip : "produces 73 insights"
wip --> docstore : "writes insight documents"
wip --> graph : "explicitly creates Insight nodes\n(source/subsystem='wave-analysis')"
kmadapter --> graph : "type-qualified queryIncomingRelations\n/storeRelationship"

graph --> historyui : "filtered by entity Type='Insight'"
docstore ..> historyui : "invisible without graph node"
graph --> hierarchytest : "975 Insight nodes\nneed parent derivation"
docstore --> ukbmodal : "workflow reports\n(paginated)"

@enduml