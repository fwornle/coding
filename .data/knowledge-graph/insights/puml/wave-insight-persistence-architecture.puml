@startuml
!include _standard-style.puml

package "Write Path (Persistence - not in retrieval)" {
  component "Insight Document Writer" as docwriter <<core>>
  component "findEntityByName" as findentity <<core>>
  component "queryIncomingRelations(entity Type)" as queryrel <<core>>
  component "storeRelationship(endpointTypes)" as storerel <<core>>
  database "Graph Database" as graphdb <<storage>>
}

package "Read Path (Retrieved Files)" {
  component "History Sidebar (entity Type filter)" as sidebar <<api>>
  component "attribution.ts\ncategoriseUnattributed/rootOf" as attribution <<core>>
  component "assert-graph-density.ts\n(deriveParents)" as density <<cli>>
  component "D3GraphCanvas / SigmaCanvas" as canvas <<core>>
  component "ukb-workflow-modal.tsx" as modal <<api>>
}

docwriter --> graphdb : "writes documents\n(no Insight node)"
findentity --> queryrel : "resolves duplicate names"
queryrel --> storerel : "threads entity Type/endpointTypes"
storerel --> graphdb : "writes typed edges"

graphdb --> sidebar : "queried by entity Type='Insight'"
graphdb --> canvas : "consumed via useGraphData"
graphdb --> attribution : "reads entities for hierarchy"
graphdb --> density : "audits graph density"
modal --> graphdb : "reads workflow progress"

sidebar ..> docwriter : "73 docs invisible\n(zero Insight nodes)"
density ..> attribution : "thematically adjacent\n(Insight placement gap)"

@enduml