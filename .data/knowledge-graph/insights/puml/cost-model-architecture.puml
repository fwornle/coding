@startuml
!include _standard-style.puml

package "Cost Model (cost-model.ts)" {
  component "budgetForMonth" as budget <<core>>
  component "priceForModel" as price <<core>>
  component "cellCostUsd" as cellcost <<core>>
  component "freshInputTokens\n(identity, documentary)" as fresh <<core>>
  component "isOpenAIWireProvider\n(documentary)" as wire <<core>>
  component "isSynthetic" as synth <<core>>
  component "budgetProvider\n(bucketing)" as bucket <<core>>
}

package "Config & Data" {
  component "CostConfig\n(monthlyEurByMonth)" as config <<storage>>
  component "CostRow" as rows <<storage>>
}

package "External Systems" {
  component "rapid-llm-proxy\nusage-cache.ts" as proxy <<external>>
  component "Routing / Tier Selector" as router <<external>>
}

config --> budget : "per-month override\nvs standing cap"
rows --> synth : "filter fake/demo rows"
synth --> cellcost : "clean rows only"
rows --> price : "model key lookup"
price --> cellcost : "line-item pricing"
cellcost --> bucket : "aggregate by provider"
bucket --> budget : "monthlySeries totals"

fresh ..> proxy : "documents moved-upstream\ncache_read subtraction"
wire ..> proxy : "documents wire protocol\n(Anthropic vs OpenAI)"
proxy --> rows : "corrected cache split\n(backfill script)"

price ..> router : "mirrors fallback chain\n(exact->fast->family->none)"

@enduml