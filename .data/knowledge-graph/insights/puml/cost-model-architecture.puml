@startuml
!include _standard-style.puml

package "Budget Resolution" {
  component "budgetForMonth()" as budgetForMonth <<core>>
  component "DEFAULT_COST_CONFIG.budgets" as budgetConfig <<storage>>
  component "budgetProvider()" as budgetProvider <<core>>
}

package "Pricing Cascade" {
  component "priceForModel()" as priceForModel <<core>>
  component "scalePrice() / FAST_MODE_MULTIPLIER" as scalePrice <<core>>
  component "modelFamily() / FAMILY_REPRESENTATIVE" as modelFamily <<core>>
}

package "Aggregation Layer" {
  component "cellCostUsd()" as cellCostUsd <<core>>
  component "monthlySeries()" as monthlySeries <<core>>
  component "freshInputTokens()" as freshInputTokens <<core>>
  component "isOpenAIWireProvider()" as wireProvider <<core>>
  component "isSynthetic()" as isSynthetic <<core>>
}

component "Dashboard Components" as dashboard <<external>>
component "rapid-llm-proxy usage-cache.ts" as proxy <<external>>
component "LLM Routing Layer" as routing <<external>>

budgetForMonth --> budgetConfig : "resolves monthly cap override"
budgetProvider --> budgetForMonth : "maps copilot/claude-max"
routing ..> budgetProvider : "informs two-bucket split"

priceForModel --> scalePrice : "fast-mode 2x fallback"
priceForModel --> modelFamily : "family fallback"

cellCostUsd --> freshInputTokens : "computes fresh input tokens"
freshInputTokens ..> proxy : "compensation now obsolete"
wireProvider ..> proxy : "documents cache semantics"
cellCostUsd --> wireProvider : "reference for wire distinction"
monthlySeries --> cellCostUsd : "aggregates per-cell cost"
monthlySeries --> isSynthetic : "filters demo/test rows"
monthlySeries --> budgetForMonth : "compares spend to cap"
priceForModel --> cellCostUsd : "supplies per-model price"

dashboard --> monthlySeries : "GET /api/token-usage/cost"
dashboard --> budgetConfig : "GET /api/llm/settings"

@enduml