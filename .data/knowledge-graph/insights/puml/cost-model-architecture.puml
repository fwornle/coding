@startuml
!include _standard-style.puml

package "cost-model.ts (pure module)" {
  component "priceForModel()" as price <<core>>
  component "modelFamily() /\nFAMILY_REPRESENTATIVE" as family <<core>>
  component "freshInputTokens()" as fresh <<core>>
  component "budgetForMonth()" as budget <<core>>
  component "budgetProvider()" as bucket <<core>>
  component "isSynthetic()" as synth <<core>>
  component "monthlySeries()" as series <<core>>
}

package "External Config / Data" {
  component "CostRow[]" as rows <<external>>
  component "CostConfig /\nBudgetConfig.monthlyEurByMonth" as config <<external>>
}

package "Upstream Systems" {
  component "rapid-llm-proxy\nopenAIFreshInputTokens()" as proxy <<external>>
  component "Model Catalogue\n(endpoint gating)" as catalogue <<external>>
}

price --> family : "fallback when\nexact key misses"
price ..> family : "fast-mode suffix\nstripping (FAST_MODE_MULTIPLIER)"

series --> synth : "filter synthetic rows"
synth --> rows : "reads CostRow[]"
series --> price : "compute cost per row"
series --> budget : "aggregate vs cap"

budget --> config : "reads monthlyEurByMonth"
bucket --> budget : "bucket provider →\ncopilot / claude-max"

fresh ..> proxy : "compensation now\nlives upstream"

price ..> catalogue : "parallel correctness\nconstraint (not enforced here)"

@enduml