@startuml
!include _standard-style.puml

package "Upstream Services" {
  component "LLM CLI Proxy\n(launchd service)" as proxy <<external>>
  component "GET /api/token-usage/cost" as costApi <<api>>
  component "GET /api/llm/settings" as settingsApi <<api>>
}

package "cost-model.ts (Pure Module)" {
  component "budgetForMonth()" as budgetFn <<core>>
  component "priceForModel()" as priceFn <<core>>
  component "freshInputTokens()" as freshFn <<core>>
  component "isSynthetic()" as syntheticFn <<core>>
  component "budgetProvider()/\nisOpenAIWireProvider()" as providerFn <<core>>
  component "cellCostUsd()" as cellFn <<core>>
  component "monthlySeries()" as monthlyFn <<core>>
}

package "Consumer" {
  component "Token Usage → Cost Tab" as dashboard <<agent>>
}

proxy --> costApi : "usage logs"
costApi --> cellFn : "CostRow[]"
settingsApi --> budgetFn : "CostConfig / BudgetConfig"
settingsApi --> priceFn : "DEFAULT_COST_CONFIG.prices"

priceFn --> cellFn : "ResolvedPrice"
freshFn --> cellFn : "fresh input tokens"
providerFn --> cellFn : "providerScale key"
providerFn --> budgetFn : "budget bucket"

cellFn --> monthlyFn : "per-row EUR cost"
syntheticFn --> monthlyFn : "filters demo/probe rows"
budgetFn --> monthlyFn : "monthly cap check"

monthlyFn --> dashboard : "aggregated series"

@enduml