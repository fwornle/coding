@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Host Startup (start-services-robust.js)" {
  component "SERVICE_CONFIGS / SERVICE_ORDER" as configs <<core>>
  component "startOneService()" as starter <<core>>
  component "loadFeatures()" as features <<core>>
  component "transcriptMonitor startFn" as tm <<core>>
  component "killProcessOnPortAndWait()" as killer <<core>>
  component "waitForPortBindable()" as tcpprobe <<core>>
  component "isProcessRunningByScript() (pgrep)" as pgrep <<external>>
  database "ProcessStateManager (PSM)" as psm <<storage>>
}

package "Container Startup" {
  component "docker/entrypoint.sh" as entrypoint <<cli>>
  component "PROGRAM_FEATURES mapping" as progfeat <<core>>
  database "features.json snapshot" as snapshot <<storage>>
}

package "Independent Services" {
  component "prompt-classifier-service.mjs" as classifier <<agent>>
}

configs --> starter : "iterates SERVICE_ORDER"
starter --> features : "checks feature enabled"
features --> starter : "gates required/optional logic"
starter --> tm : "invokes startFn"

tm --> psm : "global + per-project check"
tm --> pgrep : "OS-level orphan check"
tm --> tcpprobe : "verify port bindable"
tm --> killer : "reclaim stale port"
killer --> psm : "update process state"

entrypoint --> snapshot : "reads read-only snapshot"
entrypoint --> progfeat : "maps program -> feature"
progfeat --> entrypoint : "sets autostart=false"

classifier ..> configs : "shares config-table/dispatch pattern"
starter ..> entrypoint : "structurally parallel gating\n(kept in sync via drift tests)"

@enduml