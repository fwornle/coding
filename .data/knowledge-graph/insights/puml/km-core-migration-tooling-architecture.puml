@startuml
!include _standard-style.puml

package "KmCoreMigrationTooling (parent context, unverified)" {
  component "migrate-graph-db-entity-types.js" as typeMigrate <<core>>
  component "migrate-leveldb-to-kmcore.mjs" as levelMigrate <<core>>
  component "GraphDatabaseService\n(isDirty flag)" as gdbService <<core>>
  component "findEntityByName\n(anchor pass)" as anchorPass <<core>>
  database "LevelDB" as leveldb <<storage>>
  database "km-core store" as kmcore <<storage>>
}

package "Unified Viewer (retrieved code, different layer)" {
  component "D3GraphCanvas.tsx" as d3canvas <<core>>
  component "SigmaCanvas.tsx" as sigmacanvas <<core>>
  component "assert-graph-density.ts" as densityCheck <<cli>>
  component "attribution.test.ts" as attrTest <<agent>>
  component "History sidebar\n(Batch badge)" as historySidebar <<core>>
}

package "System Health Dashboard" {
  component "ukb-workflow-modal.tsx" as workflowModal <<core>>
}

typeMigrate --> kmcore : "consolidates entity types\n(permissive unknown->Pattern)"
levelMigrate --> leveldb : "reads records\n(5%/10% error budget, --dry-run)"
levelMigrate --> kmcore : "writes migrated data"
gdbService --> kmcore : "manual isDirty persistence"
anchorPass --> kmcore : "queryIncomingRelations /\nstoreRelationship (name+type)"
anchorPass --> anchorPass : "fallback projectAnchorName='Coding'"

kmcore ..> historySidebar : "insight docs written,\nbut zero 'Insight' nodes"
historySidebar --> workflowModal : "gates Batch badge\non entity Type"

sigmacanvas --> d3canvas : "shared graph rendering"
densityCheck ..> d3canvas : "node-count budget check"
attrTest ..> sigmacanvas : "categoriseUnattributed"

@enduml