@startuml
!include _standard-style.puml

package "Source of Truth" {
  component "rapid-llm-proxy :12435" as proxy <<external>>
  database "token_usage.db" as tokendb <<storage>>
}

package "Foreground Agents" {
  component "Claude Code" as claude <<agent>>
  component "Copilot CLI\n(events.jsonl)" as copilot <<agent>>
  component "OpenCode\n(opencode.db)" as opencode <<agent>>
}

package "TokenUsageAdapters" {
  component "token-db.mjs\n(insertTokenRow, insertShapeFor)" as tokendbmjs <<core>>
  component "copilot-events-tail.mjs\n(buildStubObservation, onTokenRow)" as copiloptail <<core>>
  component "opencode-token-rows.mjs\n(BYPASS_PROVIDERS)" as opencoderows <<core>>
}

proxy --> tokendb : "primary writer"
claude --> proxy : "routed calls"

copilot --> copiloptail : "tails events.jsonl"
copiloptail --> tokendbmjs : "onTokenRow (session.shutdown)"

opencode --> opencoderows : "reads opencode.db"
opencoderows --> tokendbmjs : "reconstructed rows\n(excl. BYPASS_PROVIDERS)"

tokendbmjs --> tokendb : "compensating INSERT\n(id-space: cladpt/copadt/opnadt)"

opencoderows ..> proxy : "assumes anthropic\nalready proxy-routed"

@enduml