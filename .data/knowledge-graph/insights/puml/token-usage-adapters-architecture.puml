@startuml
!include _standard-style.puml

package "Registry Core" {
  component "STOP_ADAPTERS" as registry <<core>>
  component "fallbackProcessFor" as fallback <<core>>
  component "SUBAGENT_PROCESS" as subagent <<core>>
  component "encodeCwd (registry)" as encodeReg <<core>>
}

package "Locators" {
  component "locateMainSessionJsonl" as locClaude <<agent>>
  component "locateCopilotSessionForSpan" as locCopilot <<agent>>
  component "locateOpencodeStoreForSpan" as locOpencode <<agent>>
}

package "Downstream / External" {
  component "captureForegroundTokens" as capture <<core>>
  component "buildOpencodeTokenRows" as buildOpencode <<external>>
  database "token_usage" as tokenDb <<storage>>
  component "claude-jsonl-tree.mjs\nencodeCwd" as encodeTree <<external>>
}

capture --> registry : "reads mode per agent"
registry --> locClaude : "claude: build/locate"
registry --> locCopilot : "copilot: build/locate"
registry --> locOpencode : "opencode: build/locate"
registry ..> fallback : "tags unmatched rows"
registry ..> subagent : "tags sub-agent rows"

locClaude --> tokenDb : "writes transcript rows\n(GRACE_MS window)"
locCopilot --> tokenDb : "writes transcript rows\n(GRACE_MS window)"
locOpencode --> buildOpencode : "provider-gated\n(BYPASS_PROVIDERS)"
buildOpencode --> tokenDb : "writes non-proxied rows"

fallback --> tokenDb : "token-adapter-<agent>-fallback"
subagent --> tokenDb : "token-adapter-claude-subagent"

encodeReg ..> encodeTree : "duplicated rule\n(kept identical)"

@enduml