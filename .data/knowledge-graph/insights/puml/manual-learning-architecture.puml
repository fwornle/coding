@startuml
!include _standard-style.puml

package "ukb-workflow-modal.tsx" {
  component "HISTORY_PAGE_SIZE" as hps <<core>>
  component "calculateDynamicEta" as dynEta <<core>>
  component "calculateStepAwareEta" as legacyEta <<core>>
}

package "multi-agent-graph.tsx" {
  component "WAVE_AGENTS" as waveAgents <<core>>
  component "KG_OPERATOR_CHILDREN" as kgChildren <<core>>
}

package "unified-viewer.D3GraphCanvas" {
  component "D3GraphCanvas" as d3canvas <<core>>
  component "deriveAncestryFromStorePath" as ancestry <<core>>
  component "color-fallback.ts" as colorFallback <<core>>
  component "node FillColor" as node FillColor <<core>>
  component "_classHue" as classHue <<deprecated>>
}

database "Redux Store (ukbSlice.ts)" as store <<storage>>

legacyEta --> dynEta : "delegates to (Strangler Fig)"
dynEta --> hps : "shares in-run learning philosophy"

waveAgents --> kgChildren : "co-located guardrail constants"

d3canvas --> ancestry : "reconciles inline BFS"
ancestry --> store : "authoritative pathToSelected"
d3canvas --> store : "subscribes via selectors"

d3canvas --> colorFallback : "uses"
colorFallback --> node FillColor : "canonical resolver"
colorFallback --> classHue : "retained for regression contract"

@enduml