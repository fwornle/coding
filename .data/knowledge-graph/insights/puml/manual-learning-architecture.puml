@startuml
!include _standard-style.puml

package "KnowledgeManagement Neighborhood" {
  component "ManualLearning" as ml <<core>>
  component "ontology.classification\n(Layer0-Layer4)" as classification <<core>>
  component "embeddings.local/remote" as embeddings <<core>>
}

package "Unified Viewer" {
  component "D3GraphCanvas" as canvas <<agent>>
  component "learning-source\n(isOnlineLearned)" as learningSource <<external>>
  component "hierarchy-parents\n(deriveParents)" as hierarchy <<core>>
}

package "System Health Dashboard" {
  component "ukb-workflow-modal" as ukbModal <<agent>>
  component "ukbSlice (Redux)" as ukbSlice <<core>>
}

database "Graph Database" as graphdb <<storage>>

canvas ..> learningSource : "resolves online-vs-manual\nlearning provenance (unconfirmed)"
canvas --> graphdb : "renders nodes from"
hierarchy --> graphdb : "derives parent chain"
ml ..> classification : "no confirmed link"
ml ..> embeddings : "no confirmed link"
ml ..> hierarchy : "not present in\nHIERARCHY_CLASSES"
ukbModal --> ukbSlice : "dispatches batch workflow"
ukbSlice ..> graphdb : "writes UKB entities\n(entity Type discipline required)"

@enduml