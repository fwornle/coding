@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "CLI Entry Points" {
  component "ukb-database/cli.js" as dbcli <<cli>>
  component "ukb-unified/cli.js" as unicli <<cli>>
  component "WorkflowOrchestrator" as orchestrator <<core>>
  component "TeamCheckpointManager" as checkpoint <<core>>
  component "GapAnalyzer" as gap <<core>>
}

package "Knowledge Store Access" {
  component "UKBDatabaseWriter" as writer <<core>>
  component "VkbApiClient" as vkbclient <<api>>
  database "SQLite + Qdrant" as db <<storage>>
  cloud "VKB Server :8080" as vkbserver <<external>>
}

package "Dashboard UI" {
  component "ukb-workflow-modal.tsx\n(calculateDynamicEta)" as modal <<agent>>
  component "multi-agent-graph.tsx\n(WAVE_AGENTS)" as graph <<agent>>
}

dbcli --> writer : "storeEntity/storeRelation"
dbcli ..> vkbserver : "isVKBRunning() check\n(update only)"
writer --> db : "direct writes"

unicli --> checkpoint : "load .data/ukb-last-run.json"
unicli --> gap : "getGapSummary"
unicli --> orchestrator : "executeIncrementalWorkflow"
orchestrator --> vkbclient : "createEntity/updateEntity"
vkbclient --> vkbserver : "HTTP /api/health, /api/entity"
vkbserver --> db : "server-mediated writes"

modal --> vkbserver : "GET /api/ukb/history"
graph --> orchestrator : "reads execution steps"

@enduml