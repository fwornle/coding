@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Manual Authoring" {
  component "cli.js" as cli <<cli>>
  component "UKBDatabaseWriter" as writer <<core>>
}

package "VKB Server" {
  component "ApiRoutes" as api <<api>>
  component "_getWriter(team)" as getWriter <<core>>
}

package "Storage Backends" {
  database "SQLite (analytics)" as sqlite
  database "Qdrant (vector)" as qdrant
  database "GraphDB" as graphdb
}

component "data-processor.js" as dataProcessor <<core>>

cli --> writer : "add/update/import/export"
cli --> api : "sendToVKB() if running"
cli --> writer : "fallback direct write"

api --> getWriter : "per-team lookup"
getWriter --> writer : "creates instance"

writer --> sqlite : "writes analytics"
writer --> qdrant : "optional vector index"
writer --> graphdb : "writes graph data"

writer --> dataProcessor : "manual entities (source != 'auto')"
dataProcessor --> dataProcessor : "tag as 'batch'"

@enduml