@startuml
!include _standard-style.puml

package "Insight Persistence (Wave 4)" {
  component "Insight Documents\n(73 written)" as docs <<storage>>
  component "Insight Graph Nodes\n(0 created)" as nodes <<storage>>
  component "Anchor Pass\nfindEntityByName" as anchor <<core>>
  component "queryIncomingRelations /\nstoreRelationship" as relations <<core>>
  component "projectAnchorName='Coding'\n(fallback anchor)" as fallback <<core>>
}

package "Unified Viewer" {
  component "History Sidebar\n(filters entity Type=='Insight')" as history <<api>>
  component "D3GraphCanvas.tsx\nVisibilityFilters.learningSource" as d3 <<agent>>
  component "SigmaCanvas.tsx" as sigma <<agent>>
  component "isOnlineLearned\n(learning-source.ts)" as learningsrc <<core>>
}

package "CI / Quality Gates" {
  component "assert-graph-density.ts\nDEFAULT_FILTERS" as density <<cli>>
  component "attribution.test.ts\ncategoriseUnattributed" as attribution <<cli>>
}

docs --> nodes : "expected but missing"
nodes --> history : "Batch badge decision"
docs ..> history : "no trace in UI"

anchor --> relations : "disambiguate by (name,type)"
relations --> fallback : "orphan prevention"
anchor ..> nodes : "name-only collision risk"

d3 --> learningsrc : "isOnlineLearned()"
density --> d3 : "mirrors DEFAULT_FILTERS"
density --> sigma : "shared visibility predicate"
attribution ..> nodes : "unrooted node checks"

@enduml