@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Manual Entry Path" {
  component "Human Editor" as human <<agent>>
  component "VKB Mutation Interface" as mutation <<api>>
}

package "VKB Server" {
  component "Entity Persistence Operations" as persist <<core>>
  component "Provenance/Source Field" as provenance <<core>>
}

package "Graph Storage" {
  database "Knowledge Graph Schema" as graph <<storage>>
  component "Decay Tracking Logic" as decay <<core>>
}

package "Auto-Extraction Path" {
  component "Batch Analysis Pipeline" as batch <<core>>
}

human --> mutation : "manual edits"
mutation --> persist : "bypasses batch pipeline"
persist --> provenance : "tags source"
provenance --> graph : "manual entities"

batch --> persist : "auto-extracted entities"
persist --> decay : "applies to online-learned only"
decay --> graph : "prunes stale auto entities"

graph --> provenance : "distinguishes manual vs. online-learned"

@enduml