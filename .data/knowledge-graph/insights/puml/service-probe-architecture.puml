@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Health Coordination" {
  component "Health Coordinator" as coordinator <<core>>
}

package "Service Probe (lib/utils/service-probe.js)" {
  component "probeHttpHealth()" as httpProbe <<core>>
  component "probeTcpPort()" as tcpProbe <<core>>
}

package "Probed Services" {
  component "MCP Service" as mcp <<external>>
  component "Dashboard Service" as dashboard <<external>>
  component "Graphify Service" as graphify <<external>>
}

coordinator --> httpProbe : "invokes for HTTP-enabled services"
coordinator --> tcpProbe : "invokes for non-HTTP services"

httpProbe --> mcp : "checks health endpoint"
httpProbe --> dashboard : "checks health endpoint"

tcpProbe --> graphify : "checks port open"

httpProbe ..> coordinator : "returns boolean/status"
tcpProbe ..> coordinator : "returns boolean/status"

@enduml