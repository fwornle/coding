@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Service Orchestration" {
  component "startServiceWithRetry()" as retry <<core>>
  component "withDeadline()" as deadline <<core>>
  component "startServicesParallel()" as parallel <<core>>
}

package "Service Wrappers" {
  component "api-service.js" as apisvc <<cli>>
  component "dashboard-service.js" as dashsvc <<cli>>
  component "ProcessStateManager" as psm <<core>>
}

package "Container Startup" {
  component "entrypoint.sh" as entry <<cli>>
  component "wait_for_service()" as waitsvc <<core>>
  component "Feature Gate (PROGRAM_FEATURES)" as featgate <<core>>
  component "env-file loader (denylist)" as envloader <<core>>
  component "supervisord" as supervisor <<external>>
}

retry --> deadline : "guards start/healthcheck calls"
parallel --> retry : "Promise.allSettled bucketing"

apisvc --> retry : "uses to start child process"
dashsvc --> retry : "uses to start child process"
apisvc --> psm : "registerService('constraint-api-child')"
dashsvc --> psm : "registerService()"
dashsvc ..> apisvc : "hardcoded NEXT_PUBLIC_API_BASE_URL:3031"

entry --> envloader : "imports .env, filters credentials"
entry --> waitsvc : "polls Qdrant/Redis TCP ports"
entry --> featgate : "reads features.json snapshot"
featgate --> supervisor : "writes disabled.conf overrides"
entry --> supervisor : "exec supervisord (handoff)"
waitsvc ..> supervisor : "fail-open: return 0 on timeout"

@enduml