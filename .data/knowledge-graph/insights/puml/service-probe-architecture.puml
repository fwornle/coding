@startuml
!include _standard-style.puml

package "Service Startup & Gating" {
  component "entrypoint.sh" as entrypoint <<core>>
  component "PROGRAM_FEATURES" as progfeat <<core>>
  component "features.json (snapshot)" as snapshot <<storage>>
  component "supervisord" as supervisord <<external>>
}

package "Health Checking Layer" {
  component "start-services-robust.js" as startrobust <<core>>
  component "SERVICE_CONFIGS.healthCheckFn" as healthfn <<core>>
  component "service-starter.js\n(createHttpHealthCheck/createPidHealthCheck)" as starter <<core>>
  component "ServiceProbe\n(lib/utils/service-probe.js)\n[NOT RETRIEVED]" as probe <<core>>
}

package "Analog & Test Patterns" {
  component "prompt-classifier-service.mjs\ncurrentNetwork()" as classifier <<agent>>
  cloud "llm-cli-proxy /health" as proxyhealth <<external>>
  component "service-gating.test.mjs" as gatingtest <<cli>>
}

snapshot --> entrypoint : "read at startup"
entrypoint --> progfeat : "maps feature->program"
entrypoint --> supervisord : "generate autostart=false includes"

startrobust --> healthfn : "SERVICE_CONFIGS entries"
healthfn --> starter : "createPidHealthCheck() / createHttpHealthCheck()"
starter ..> probe : "expected to delegate to\n(unconfirmed - file absent)"

classifier --> proxyhealth : "poll with NETWORK_TTL_MS cache"
classifier ..> probe : "structurally analogous pattern"

gatingtest --> startrobust : "tests startOneService() gating"

@enduml