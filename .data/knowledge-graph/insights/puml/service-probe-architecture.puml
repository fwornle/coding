@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Health Probing Core" {
  component "ServiceProbe\n(service-probe.js)" as probe <<core>>
}

package "Container Path" {
  component "entrypoint.sh" as entrypoint <<core>>
  component "wait_for_service()\n(/dev/tcp probe)" as tcpprobe <<core>>
  component "PROGRAM_FEATURES\n+ supervisord gating" as progfeat <<core>>
  component "container-gating.test.mjs" as ctest <<agent>>
}

package "Host Path" {
  component "start-services-robust.js" as robust <<core>>
  component "SERVICE_CONFIGS /\nSERVICE_ORDER" as svcconf <<core>>
  component "waitForPortBindable()" as bindable <<core>>
  component "killProcessOnPortAndWait()" as killport <<core>>
  component "service-gating.test.mjs" as stest <<agent>>
}

package "Legacy Path" {
  component "start-services.sh\n(ROBUST_MODE toggle)" as legacy <<external>>
  component "lsof/docker-compose\nhealth polling" as legacyhealth <<external>>
}

database "features.json\n(FEATURES_SNAPSHOT)" as snapshot

entrypoint --> tcpprobe : "ad-hoc TCP check"
entrypoint --> progfeat : "reads"
progfeat --> snapshot : "reads (fail-open)"
progfeat ..> ctest : "verified against\nsupervisord.conf"

robust --> svcconf : "enforces feature gating"
robust --> bindable : "avoids false EADDRINUSE"
robust --> killport : "SIGTERM/SIGKILL escalation"
svcconf ..> stest : "structural drift checks"

probe ..> entrypoint : "reused by (containerized)"
probe ..> robust : "reused by (host subprocess)"

legacy --> legacyhealth : "duplicate health semantics"
legacy ..> robust : "ROBUST_MODE=false fallback"

svcconf --> snapshot : "mirrors container gating"

@enduml