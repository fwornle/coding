@startuml
!include _standard-style.puml

package "graph/attribution (canonical module)" {
  component "rootOf" as rootOf <<core>>
  component "categoriseUnattributed" as categorise <<core>>
  component "CATEGORY_LABEL" as labels <<core>>
}

package "Category Buckets" {
  component "recordedParent" as recordedParent <<core>>
  component "wrongClass" as wrongClass <<core>>
  component "danglingRef" as danglingRef <<core>>
  component "unclaimed" as unclaimed <<core>>
}

package "Consumers" {
  component "assert-graph-density.ts" as ci <<cli>>
  component "attribution.test.ts" as tests <<agent>>
  component "hierarchy-parents.ts (deriveParents)" as hierarchy <<external>>
}

ci --> rootOf : "calls (cycle-safe walk)"
ci --> categorise : "CI gate check"
ci --> labels : "reporting"

categorise --> recordedParent : "exclusive bucket"
categorise --> wrongClass : "exclusive bucket"
categorise --> danglingRef : "exclusive bucket"
categorise --> unclaimed : "exclusive bucket"

categorise --> hierarchy : "consults placement rule"
wrongClass ..> hierarchy : "Project/has_insight/non-Insight refusal"

recordedParent ..> unclaimed : "ambiguous twin name\nfalls back rather than guesses"

tests --> rootOf : "verifies cycle-safety"
tests --> categorise : "verifies exclusivity & priority"

@enduml