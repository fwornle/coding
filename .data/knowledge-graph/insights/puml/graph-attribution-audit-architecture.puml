@startuml
!include _standard-style.puml

package "Shared Attribution Module" {
  component "@/graph/attribution" as attrib <<core>>
  component "rootOf" as rootOf <<core>>
  component "categoriseUnattributed" as categorise <<core>>
  component "CATEGORY_LABEL" as labels <<core>>
}

package "CI Gate" {
  component "assert-graph-density.ts" as gate <<cli>>
  component "isEntityVisible / deriveParents" as viewerPreds <<core>>
}

package "Viewer" {
  component "Graph Quality Panel" as panel <<agent>>
}

component "attribution.test.ts" as tests <<core>>

attrib --> rootOf
attrib --> categorise
attrib --> labels

gate --> attrib : "imports rootOf, categoriseUnattributed, CATEGORY_LABEL"
gate --> viewerPreds : "reuses visibility & hierarchy walk"
gate --> gate : "unrootedByCategory report,\noverBudget on unrooted>0"

panel --> attrib : "consumes same categorisation"

tests --> attrib : "exercises 4 categories\n(recordedParent, wrongClass,\ndanglingRef, unclaimed)"

categorise --> categorise : "recordedParent wins on ambiguity"
rootOf --> rootOf : "cycle-safe walk (a->b->a => null)"

@enduml