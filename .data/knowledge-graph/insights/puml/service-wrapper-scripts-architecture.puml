@startuml
!include _standard-style.puml

package "Legacy/Fallback Layer" {
  component "start-services.sh" as legacy <<cli>>
}

package "Robust Starter Core" {
  component "SERVICE_CONFIGS\n(transcriptMonitor, liveLoggingCoordinator...)" as configs <<core>>
  component "startOneService" as starter <<core>>
  component "killProcessOnPortAndWait()" as killport <<core>>
  component "waitForPortBindable()" as waitport <<core>>
  component "Process State Manager (PSM)" as psm <<core>>
}

package "Feature Gating" {
  component "loadFeatures\n(host-side)" as loadfeat <<core>>
  component "lib/features/catalogue.cjs" as catalogue <<core>>
  component "docker/entrypoint.sh" as entrypoint <<external>>
  database "features.json snapshot" as snapshot
}

component "service-gating.test.mjs" as tests <<cli>>
component "prompt-classifier-service.mjs" as promptclassifier <<agent>>

legacy --> starter : "ROBUST_MODE exec"
starter --> configs : "reads"
configs --> psm : "orphan check (isServiceRunning)"
configs --> killport : "reclaim port"
configs --> waitport : "verify bindable"
starter --> loadfeat : "gate by feature id"
loadfeat --> catalogue : "resolve FEATURE_IDS"
entrypoint --> snapshot : "reads flat JSON"
entrypoint --> catalogue : "same feature contract"
tests --> configs : "structural invariants"
tests --> catalogue : "feature id validation"
promptclassifier ..> configs : "same env-loading discipline"

@enduml