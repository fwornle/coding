@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Process Supervisor" {
  component "Supervisor\n(SIGTERM/SIGINT)" as supervisor <<core>>
  component "ProcessStateManager" as psm <<core>>
}

package "Wrapper Scripts" {
  component "api-service.js" as apiWrapper <<cli>>
  component "dashboard-service.js" as dashWrapper <<cli>>
}

package "Child Services" {
  component "dashboard-server.js\n(constraint-monitor)" as apiChild <<api>>
  component "Next.js Dev Server\n(dashboard)" as dashChild <<api>>
}

supervisor --> apiWrapper : "sends SIGTERM/SIGINT"
supervisor --> dashWrapper : "sends SIGTERM/SIGINT"

apiWrapper --> apiChild : "spawn node src/dashboard-server.js\n(PORT, DASHBOARD_PORT env)"
dashWrapper --> dashChild : "spawn npm run dev\n(NEXT_PUBLIC_API_BASE_URL hardcoded)"

apiWrapper --> apiChild : "forwards signal via child.kill()"
dashWrapper --> dashChild : "forwards signal via child.kill()"

apiWrapper --> psm : "register 'constraint-api-child'\n(type:'global')"
dashWrapper --> psm : "register 'constraint-dashboard-child'\n(type:'global')"

apiChild ..> psm : "unregister on 'exit'"
dashChild ..> psm : "unregister on 'exit'"

psm ..> apiWrapper : "registration failure\n(logged, non-fatal)"
psm ..> dashWrapper : "registration failure\n(logged, non-fatal)"

@enduml