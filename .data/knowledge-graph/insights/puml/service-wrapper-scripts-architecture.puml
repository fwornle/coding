@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Wrapper Scripts" {
  component "api-service.js" as api <<cli>>
  component "dashboard-service.js" as dash <<cli>>
}

package "Runtime Support" {
  component "CODING_REPO Path Resolver" as pathres <<core>>
  component "Path Existence Checker" as checker <<core>>
  component "Signal Forwarder\n(SIGTERM/SIGINT)" as sig <<core>>
}

package "Process Management" {
  component "Spawned Target Process" as target <<external>>
  component "ProcessStateManager" as psm <<core>>
  database "Docker stdout/stderr" as stdio <<storage>>
}

api --> pathres : "resolve paths"
dash --> pathres : "resolve paths"

pathres --> checker : "verify existence"
checker --> target : "spawn if valid"

target --> stdio : "inherited stdio"

api --> sig : "install handlers"
dash --> sig : "install handlers"
sig --> target : "forward signals"

api --> psm : "register/unregister"
dash --> psm : "register/unregister"
psm --> target : "track lifecycle"

@enduml