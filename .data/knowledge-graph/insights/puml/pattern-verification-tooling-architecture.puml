@startuml
!include _standard-style.puml

package "Shell-based Verification" {
  component "verify-patterns.sh" as vps <<cli>>
  component "install.sh (target)" as install <<external>>
  component "Markdown Compliance Report" as report <<storage>>
}

package "Ontology Heuristics" {
  component "EntityPatternAnalyzer.ts" as epa <<core>>
  component "teamDirectories Map" as teamdir <<storage>>
  component "artifactPatterns Map" as artpat <<storage>>
  component "checkLocalArtifact()" as localcheck <<agent>>
  component "matchArtifactPattern()" as patmatch <<agent>>
}

package "Unimplemented Verification Discipline" {
  component "Post-Rewrite Baseline Diff (missing)" as baseline <<external>>
}

vps --> install : "greps for patterns"
vps --> report : "generates score"

epa --> teamdir : "hardcoded lookup"
epa --> artpat : "regex fallback"
epa --> localcheck : "step 1: local match (0.9)"
epa --> patmatch : "step 2: pattern match (0.75)"
localcheck ..> patmatch : "fallback if no match"

vps ..> epa : "independent (no coupling)"
baseline ..> vps : "no baseline-diff logic found"

@enduml