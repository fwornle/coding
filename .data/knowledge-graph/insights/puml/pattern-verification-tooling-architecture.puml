@startuml
!include _standard-style.puml

package "Pattern Verification Tooling (Gap Analysis)" {
  component "verify-patterns.sh" as vps <<cli>>
  component "EntityPatternAnalyzer.ts" as epa <<core>>
  database "pattern-verification-*.md report" as report <<storage>>
  database "Shared-memory Knowledge File" as knowledge <<storage>>
}

package "Missing / Unimplemented Logic" {
  component "Render-Error Triage Logic" as triage <<agent>>
  component "Diagram Verification Logic" as diagcheck <<agent>>
}

package "Unrelated Fixtures" {
  component "DesignViewModel.cs / DesignView.xaml" as xamlfix <<external>>
}

vps --> report : "generates compliance score"
vps --> knowledge : "mutates via jq"
epa --> knowledge : "hardcoded team/pattern mappings"

triage ..> vps : "not implemented here"
diagcheck ..> vps : "not implemented here"

xamlfix ..> vps : "keyword collision only"

@enduml