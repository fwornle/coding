@startuml
!include _standard-style.puml

package "Pattern Verification Tooling" {
  component "verify-patterns.sh" as script <<cli>>
  component "Conditional Checks\n(rg-based)" as checks <<core>>
  component "Compliance Score\nCalculator" as score <<core>>
  component "Markdown Report\n(heredoc)" as report <<core>>
}

package "Knowledge Base" {
  database "SHARED_MEMORY JSON" as mem <<storage>>
}

package "Project Under Analysis" {
  component "package.json / install.sh" as project <<external>>
}

package "Unrelated Heuristic Layer" {
  component "EntityPatternAnalyzer.ts" as epa <<core>>
}

script --> checks : "invokes"
checks --> project : "inspects for react/install.sh"
checks --> score : "PASSED/TOTAL_CHECKS"
score --> report : "writes summary"
script --> mem : "reads TransferablePattern (sig>=8)"
score --> mem : "writes back pattern_compliance_score\n(jq)"

epa ..> mem : "unrelated: classifies entities\n(no direct link)"

@enduml