@startuml
!include _standard-style.puml

package "Wrapper Scripts" {
  component "api-service.js" as apiWrapper <<core>>
  component "dashboard-service.js" as dashWrapper <<core>>
  component "dashboard-server.js" as dashServer <<core>>
}

package "Process Management" {
  component "ProcessStateManager" as psm <<core>>
  component "service-starter.js\n(withDeadline)" as starter <<core>>
  component "supervisord" as supervisor <<external>>
}

package "Health & Config" {
  component "service-probe.js\n(running/stopped/unknown)" as probe <<api>>
  component "llm-mock-service.ts\n(CODING_ROOT override)" as mockService <<agent>>
}

cloud "Docker Compose\nContainer Runtime" as docker <<external>>

apiWrapper --> dashServer : "spawns child process"
apiWrapper --> psm : "registers PID\n'constraint-api-child'"
dashWrapper --> dashServer : "wraps 'npm run dev'"
dashWrapper --> apiWrapper : "hardcoded\nNEXT_PUBLIC_API_BASE_URL:3031"

supervisor --> apiWrapper : "manages lifecycle"
supervisor --> dashWrapper : "manages lifecycle"
docker --> supervisor : "docker-compose up -d"

starter --> probe : "invokes health checks"
probe --> supervisor : "reports health state"

mockService ..> docker : "reconciles host vs\ncontainer paths"

docker --> probe : "post-restart\nverification baseline"

@enduml