@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Docker Layer" {
  component "docker-compose.yml" as compose <<core>>
  component "entrypoint.sh / supervisord.conf" as entry <<core>>
}

package "Service Wrappers" {
  component "api-service.js" as apiSvc <<core>>
  component "dashboard-service.js" as dashSvc <<core>>
  component "llm-mock-service.ts" as mockSvc <<core>>
}

package "Lifecycle & Health" {
  component "ProcessStateManager" as psm <<core>>
  component "service-starter.js\n(startServiceWithRetry)" as starter <<core>>
  component "service-probe.js\n(probeHttpHealth/probeTcpPort)" as probe <<core>>
  component "health-coordinator.js" as coord <<core>>
}

component "dashboard-server.js (port 3031)" as dashServer <<api>>
component "Next.js Dashboard" as nextjs <<api>>
database "workflow-progress.json" as wfjson <<storage>>

entry --> compose : "orchestrates containers"
compose --> apiSvc : "runs"
compose --> dashSvc : "runs"

apiSvc --> dashServer : "spawns child process"
apiSvc --> psm : "register/unregister"
dashSvc --> nextjs : "npm run dev"
dashSvc --> psm : "register/unregister"
nextjs --> dashServer : "NEXT_PUBLIC_API_BASE_URL"

apiSvc --> starter : "uses for startup"
dashSvc --> starter : "uses for startup"
starter --> probe : "health-check fn"

coord --> probe : "polls every 5s"
probe --> coord : "status: running|stopped|unknown"

mockSvc --> wfjson : "reads/writes llmState"
apiSvc ..> mockSvc : "mock-mode LLM calls"

@enduml