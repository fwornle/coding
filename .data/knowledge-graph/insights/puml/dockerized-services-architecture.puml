@startuml
!include _standard-style.puml

package "Orchestration" {
  component "ServiceStarter" as starter <<core>>
  component "ServiceProbe" as probe <<core>>
  component "Coding Copilot Launcher" as launcher <<cli>>
}

package "Supervised Services" {
  component "API Service" as api <<core>>
  component "Dashboard Service" as dashboard <<core>>
  component "Semantic Analysis MCP" as semantic <<agent>>
  component "Constraint Monitor" as constraint <<agent>>
  component "obs-api" as obsapi <<api>>
  component "llm-proxy / llm-cli-proxy" as llmproxy <<external>>
}

package "Observability" {
  component "System Health Dashboard" as healthdash <<core>>
  component "Multi-project Statusline" as statusline <<core>>
}

cloud "LLM Mock Service" as mock <<external>>

starter --> api : "spawns"
starter --> dashboard : "spawns"

probe --> semantic : "health-check poll"
probe --> constraint : "health-check poll"
probe --> obsapi : "health-check poll"
probe --> llmproxy : "health-check poll"

launcher --> probe : "reuses health checks"

llmproxy ..> mock : "swappable via env config"

probe --> healthdash : "surfaces timeouts"
probe --> statusline : "surfaces timeouts"

@enduml