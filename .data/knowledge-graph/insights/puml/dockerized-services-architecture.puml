@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Host Orchestration" {
  component "CLI Bootstrap / Agent Init" as cli <<cli>>
  component "service-probe.js" as probe <<core>>
  component "Task Gating (GATES/RUNG_OFFLOADED)" as gating <<core>>
}

package "Dockerized Containers" {
  component "Semantic Analysis MCP" as sem <<core>>
  component "Constraint Monitor" as cmon <<core>>
  component "Graphify" as graphify <<core>>
  database "Postgres/Neo4j/Redis" as dbs <<storage>>
}

package "LLM Backend Access" {
  cloud "LLM Proxy Layer\n(LLM_CLI_PROXY_URL, RAPID_LLM_PROXY_URL, LLM_PROXY_URL)" as proxy <<external>>
  cloud "Qwen Local/Laptop APIs" as qwen <<external>>
  component "llm-mock-service.ts" as mock <<agent>>
}

cli --> probe : "polls readiness"
probe --> sem : "health check"
probe --> cmon : "health check"

sem --> dbs : "reads/writes state"
cmon --> dbs : "monitors state"
graphify --> dbs : "stores graph data"

sem --> proxy : "routes LLM calls"
proxy --> qwen : "forwards requests"

sem ..> mock : "test substitution"

gating --> sem : "assigns offloaded work"
gating --> cli : "routes foreground/background"

@enduml