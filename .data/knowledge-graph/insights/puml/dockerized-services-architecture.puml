@startuml
!include _standard-style.puml

package "Wrapper Layer" {
  component "api-service.js" as apiSvc <<core>>
  component "dashboard-service.js" as dashSvc <<core>>
  component "ProcessStateManager" as psm <<core>>
}

package "Implementation Services" {
  component "dashboard-server.js\n(port 3031)" as dashServer <<api>>
  component "Next.js Dashboard" as nextDash <<api>>
  component "llm-mock-service.ts" as mockSvc <<agent>>
}

package "Health Verification Stack" {
  component "service-probe.js" as probe <<core>>
  component "service-starter.js" as starter <<core>>
  component "health-coordinator.js" as coordinator <<core>>
  database "health-verification-rules.json" as rules
}

apiSvc --> dashServer : spawns child process
apiSvc --> psm : registers 'constraint-api-child'
dashSvc --> nextDash : npm run dev
dashSvc --> psm : registers/unregisters
nextDash --> dashServer : NEXT_PUBLIC_API_BASE_URL:3031

starter --> probe : uses probeHttpHealth/probeTcpPort
coordinator --> starter : retry-with-backoff startup
coordinator --> rules : reads declarative rules
coordinator --> apiSvc : verifies health endpoint
coordinator --> dashSvc : verifies health endpoint

mockSvc ..> dashServer : provides mock LLM responses

@enduml