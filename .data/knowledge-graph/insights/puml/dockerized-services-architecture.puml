@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Container Runtime" {
  component "docker-compose.yml" as compose <<external>>
  component "supervisord" as supervisord <<core>>
  component "entrypoint.sh" as entrypoint <<core>>
}

package "Service Wrappers" {
  component "api-service.js" as apiSvc <<api>>
  component "dashboard-service.js" as dashSvc <<api>>
  component "service-starter.js" as starter <<core>>
  component "service-probe.js" as probe <<core>>
  component "process-state-manager.js" as psm <<core>>
}

package "Shared State" {
  component "llm-mock-service.ts" as llmMock <<core>>
  database "workflow-progress.json" as progress <<storage>>
  database "Redis / Memgraph" as datastores <<storage>>
}

entrypoint --> supervisord : "launches"
supervisord --> apiSvc : "manages process"
supervisord --> dashSvc : "manages process"
compose --> entrypoint : "configures container"

starter --> apiSvc : "startServiceWithRetry()"
starter --> dashSvc : "startServiceWithRetry()"
starter --> probe : "delegates liveness checks"

apiSvc --> psm : "registers/unregisters child"
dashSvc --> psm : "registers/unregisters child"
probe --> psm : "combined with process state"

dashSvc --> apiSvc : "NEXT_PUBLIC_API_BASE_URL"

apiSvc --> datastores : "connects"
dashSvc --> datastores : "connects"

llmMock --> progress : "reads/writes CODING_ROOT path"
apiSvc ..> llmMock : "queries LLM mode"
dashSvc ..> llmMock : "queries LLM mode"

@enduml