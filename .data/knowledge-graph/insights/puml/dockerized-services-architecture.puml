@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Container Mode" {
  component "docker-compose.yml" as compose <<core>>
  component "supervisord.conf" as supervisor <<core>>
  component "Dockerfile.coding-services" as dockerfile <<core>>
}

package "Host Mode" {
  component "service-starter.js" as starter <<core>>
  component "ProcessStateManager" as psm <<core>>
  component "Wrapper Scripts\n(api-service.js, dashboard-service.js)" as wrappers <<agent>>
}

package "Health & State" {
  component "service-probe.js" as probe <<core>>
  component "llm-mock-service.ts" as llmmock <<core>>
  database ".data/workflow-progress.json" as progressjson
}

component "Dashboard (Next.js)" as dashboard <<agent>>
component "API Service" as api <<api>>

supervisor --> dockerfile : "managed inside container"
compose --> supervisor : "orchestrates"

starter --> psm : "registers PID / tracks state"
wrappers --> psm : "registerService()"
starter --> wrappers : "spawns child process"

probe --> starter : "health check (agnostic)"
probe --> supervisor : "health check (agnostic)"

llmmock --> progressjson : "reads/writes llmState"
llmmock --> compose : "CODING_ROOT override"

wrappers --> dashboard : "wraps npm run dev"
wrappers --> api : "wraps Express process"

dashboard --> api : "hardcoded localhost:3031"

@enduml