@startuml
!include _standard-style.puml

package "Startup Layer" {
  component "start-services.sh\n(legacy path)" as legacy <<cli>>
  component "start-services-robust.js\nSERVICE_CONFIGS" as robust <<cli>>
  component "service-gating.test.mjs" as gatetest <<core>>
}

package "Supervised Programs\n(container)" {
  component "constraint-monitor" as cm <<core>>
  component "constraint-dashboard\n(port 3030)" as dash <<core>>
  component "constraint-dashboard-api\n(port 3031)" as api <<api>>
  component "entrypoint.sh\nPROGRAM_FEATURES" as entry <<core>>
}

package "Dependencies & Health" {
  database "Qdrant\n(6333/6334)" as qdrant <<storage>>
  database "Redis\n(6379)" as redis <<storage>>
  component "docker-compose /\ndocker run fallback" as compose <<external>>
  component "lib/service-probe.js" as probe <<core>>
  component "features.json\ncatalogue.cjs" as features <<external>>
}

legacy --> compose : "clone/install/bootstrap"
compose --> qdrant : "poll Up.*healthy"
compose --> redis : "poll Up.*healthy"
legacy --> dash : "npm run dashboard"
legacy --> api : "npm run api"

entry --> cm : "gated by 'constraints'"
entry --> dash : "gated by 'constraints'"
entry --> api : "gated by 'constraints'"
entry --> features : "reads snapshot\n(fail-open)"

robust --> gatetest : "declares feature field"
gatetest --> features : "FEATURE_IDS"

probe ..> compose : "consecutive-failure\npattern (not reused)"

@enduml