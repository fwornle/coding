@startuml
!include _standard-style.puml

package "LLM Routing UI" {
  component "OffloadDecision" as decision <<core>>
  component "useClassifierJudge" as judge <<agent>>
  component "OffloadGates (GATES ladder)" as gates <<core>>
  component "offload-replay" as replay <<core>>
}

package "Proxy / Config Backends" {
  component "rapid-llm-proxy /resolve" as proxy <<api>>
  database "llm-routing.yaml" as routingYaml <<storage>>
  database "prompt-classifier.yaml" as classifierYaml <<storage>>
}

package "Supporting Data" {
  component "cost-model.ts" as cost <<core>>
  component "copilot-model-ids drift guard" as drift <<cli>>
}

decision --> gates : "config mode: evaluateOffload()"
decision --> replay : "recorded mode: totalsByRoute()"
decision --> proxy : "queryFor() /api/llm/routing/resolve"
decision ..> proxy : "verify configRungs vs live resolve"

judge --> proxy : "PATCH /api/llm/classifier"
judge --> classifierYaml : "save() diffed backends/rubric/strategy"

proxy --> routingYaml : "reads tier priority order"

decision --> cost : "route cost context"
drift ..> decision : "guards vendored model ids"

@enduml