@startuml
!include _standard-style.puml

package "Container Gating Layer" {
  component "docker/entrypoint.sh\nPROGRAM_FEATURES" as entrypoint <<core>>
  component "service-gating.test.mjs" as gatingtest <<core>>
}

package "Service Wrappers" {
  component "api-service.js\n(APIServiceWrapper)" as apiwrapper <<api>>
  component "dashboard-server.js" as dashboard <<api>>
  component "start-services-robust.js\nSERVICE_CONFIGS" as robust <<core>>
  component "enhanced-transcript-monitor.js" as transcriptmon <<agent>>
}

package "Process & Health Infrastructure" {
  component "ProcessStateManager" as psm <<core>>
  component "service-probe.js\n(probeHttpHealth/probeTcpPort)" as probe <<core>>
}

entrypoint --> apiwrapper : "autostart gating\n(supervisord override)"
gatingtest ..> robust : "asserts feature/service\ntable invariants"

apiwrapper --> dashboard : "spawns as child process"
apiwrapper --> psm : "registers PID\n(type=global,\nname=constraint-api-child)"

robust --> transcriptmon : "spawn(detached)"
robust --> psm : "registers PID\n(transcript-monitor,global)"

psm --> probe : "state queried via"
probe --> apiwrapper : "running/stopped/unknown"

@enduml