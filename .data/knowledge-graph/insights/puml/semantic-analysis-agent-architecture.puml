@startuml
!include _standard-style.puml

package "Agent Execution Layer" {
  component "BaseAgent" as base <<core>>
  component "SemanticAnalysisAgent" as sem <<agent>>
  component "OntologyClassificationAgent" as onto <<agent>>
}

package "Ontology Plumbing" {
  component "createOntologySystem" as factory <<core>>
  component "LegacyOntologyAdapter" as adapter <<core>>
  database "km-core OntologyRegistry" as registry <<storage>>
}

package "Validation & Data Quality" {
  component "Taxonomy Stability Validation" as taxval <<external>>
  component "KB Injection A/B Experiment" as kbab <<external>>
  component "CodingLowerOntologySource Emission Bug" as bug <<external>>
}

base --> sem : "execute() envelope\n(process/confidence/issues/routing)"
base --> onto : "execute() envelope"

sem --> factory : "constructs ontology system"
onto --> factory : "constructs ontology system"
factory --> adapter : "requires pre-built adapter"
adapter --> registry : "wraps"

sem --> taxval : "output validated by"
sem ..> kbab : "feeds batch KB quality task"
registry ..> bug : "emits unexpected source"
onto --> registry : "classification decisions"

@enduml