@startuml
!include _standard-style.puml

package "CLI / Routing Layer" {
  component "rapid-llm-proxy" as proxy <<core>>
  component "Routing Tier Priority Logic" as tierlogic <<core>>
  component "CLI / UKB Runner" as cli <<cli>>
}

package "Provider Clients" {
  component "DMRProvider (dmr-provider.ts)" as dmr <<agent>>
  component "Anthropic Client" as anthropic <<agent>>
  component "OpenAI Client" as openai <<agent>>
  component "Groq Client" as groq <<agent>>
}

package "Dashboard / Observability (unrelated files)" {
  component "offload-decision.tsx" as offload <<external>>
  component "use-classifier-judge.ts" as classifier <<external>>
  component "cost-model.ts" as cost <<external>>
  component "copilot-model-ids.test.mjs" as guard <<external>>
}

cli --> proxy : "invokes"
proxy --> tierlogic : "resolves fallback order"
tierlogic --> dmr : "selects/promotes"
tierlogic --> anthropic : "max-subscription first"
tierlogic --> openai : "work/Copilot tier"
tierlogic --> groq : "last resort"

cli ..> dmr : "timeout traced to"

offload ..> proxy : "reads resolved routing"
classifier ..> proxy : "reads classifier health"
guard ..> openai : "drift-guards Copilot ids"
cost ..> tierlogic : "pricing input"

@enduml