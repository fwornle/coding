@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "LLM Mode Resolution" {
  component "getLLMMode()" as mode <<core>>
  component "isMockLLMEnabled()" as mock <<core>>
}

package "Offload Decision Layer" {
  component "OffloadDecision" as decision <<core>>
  component "evaluateOffload()" as evaluate <<core>>
  component "OffloadTarget.provider" as target <<core>>
}

package "Inference Providers" {
  component "DMRProvider" as dmr <<agent>>
  component "OpenAI-Compatible Client Interface" as iface <<api>>
  cloud "Remote Provider" as remote <<external>>
}

mock --> mode : "resolves mode"
mode --> decision : "non-mock local mode"
decision --> evaluate : "requireNetwork gate"
evaluate --> target : "selects local target"
target --> dmr : "references as local target"
dmr --> iface : "implements"
iface ..> remote : "substitutable without\nchanging call sites"
evaluate --> remote : "requires network egress"
dmr --> evaluate : "no network egress needed"

@enduml