@startuml
!include _standard-style.puml

package "Local Inference Tier (unverified)" {
  component "DMRProvider" as dmr <<core>>
  component "dmrClient" as dmrclient <<external>>
}

package "LLM CLI Proxy" {
  component "proxy-bridge/server.mjs" as proxy <<api>>
  component "Model Catalogue" as catalogue <<core>>
}

package "System Health Dashboard (sibling, not DMR)" {
  component "ReduxProvider (store/provider.tsx)" as redux <<core>>
  component "OffloadDecision" as offload <<agent>>
  component "cost-model.ts" as cost <<core>>
  component "useClassifierJudge" as judge <<agent>>
}

dmr --> dmrclient : "manages"
dmr ..> proxy : "would sit behind\n(local-inference tier)"
proxy --> catalogue : "endpoint-gated\nmodel listing"

redux --> offload : "mounts /\nerror boundary"
offload --> proxy : "resolve() calls\n/api/llm/routing/resolve"
offload --> judge : "uses"
cost --> offload : "priceForModel\nbudgetProvider"

offload ..> dmr : "NOT verified:\nno route resolves\nto DMR/local target"

@enduml