@startuml
!include _standard-style.puml

package "Backend Selection Layer" {
  component "llm-mock-service\ngetLLMMode()" as mockSvc <<core>>
  database "workflow-progress.json" as progressFile <<storage>>
}

package "DMR Provider" {
  component "DMRProvider" as dmr <<agent>>
  component "checkDMRAvailability()" as health <<core>>
  component "loadDMRConfig()" as config <<core>>
  database "dmr-config.yaml" as cfgFile <<storage>>
  cloud "Docker Model Runner\n(OpenAI-compatible API)" as dockerMR <<external>>
}

package "Shared LLM Utilities" {
  component "parse-llm-json.ts\n(repair pipeline)" as jsonRepair <<core>>
  component "llm-with-process.ts\nresolveProxyCompleteUrl()" as proxyResolver <<core>>
}

mockSvc --> progressFile : "dual-write\nllmState + mockLLM"
mockSvc --> dmr : "routes calls when\nmode = local/DMR"

dmr --> config : "load config"
config --> cfgFile : "multi-path search +\nexpandEnvVars()"
dmr --> health : "cached liveness\nprobe"
health --> dockerMR : "periodic\nhealth check"
dmr --> dockerMR : "OpenAI-shape\nrequest/response"

dmr ..> jsonRepair : "JSON-mode output\nrepair"
config ..> proxyResolver : "shared env-var\nprecedence pattern"

@enduml