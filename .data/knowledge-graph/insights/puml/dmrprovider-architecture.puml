package "Mode Resolution" {
  component "LLMMockService" as mock <<core>>
}

package "Local Inference" {
  component "DMRProvider" as dmr <<agent>>
  component "OpenAI-Compatible Client Shape" as shape <<api>>
}

package "External Runtime" {
  cloud "Docker Model Runner API" as runner <<external>>
