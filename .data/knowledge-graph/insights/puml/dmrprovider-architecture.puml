@startuml
!include _standard-style.puml

package "DMR Provider Module" {
  component "DMRProvider" as dmr <<core>>
  component "loadDMRConfig()" as cfg <<core>>
  component "checkDMRAvailability()" as health <<core>>
}

package "Config Resolution" {
  component "cwd/config/dmr-config.yaml" as path1 <<external>>
  component "cwd/integrations/.../dmr-config.yaml" as path2 <<external>>
  component "__dirname-relative path" as path3 <<external>>
  component "DEFAULT_CONFIG (in-code)" as defcfg <<core>>
}

package "Routing & Policy Layer" {
  component "Tiered Provider Fallback\n(max-subscription > Copilot-tier > Groq Llama-70B)" as tiers <<core>>
  component "rapid-llm-proxy" as proxy <<external>>
  component "cost-model.ts\n(no DMR pricing entry)" as cost <<storage>>
}

cfg --> path1 : "search order 1"
cfg --> path2 : "search order 2"
cfg --> path3 : "search order 3"
cfg --> defcfg : "fallback if none found"
dmr --> cfg : "loads config"
dmr --> health : "time-windowed cache check"

tiers --> dmr : "last resort in fallback chain"
proxy --> tiers : "routes requests (proxy cleared of timeout issue)"
tiers --> cost : "usage cost lookup (unpriced for DMR)"

@enduml