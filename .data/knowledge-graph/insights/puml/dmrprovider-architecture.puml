}

mock --> dmr : "mode == 'local'"
dmr --> shape : "reuses"
shape --> runner : "OpenAI-style requests"
runner --> qwen : "hosts"
dmr ..> runner : "QWEN_LOCAL_API_KEY /\nQWEN_LAPTOP_API_BASE_URL"

@enduml