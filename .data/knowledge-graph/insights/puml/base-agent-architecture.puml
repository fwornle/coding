@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "CLI Agent Launch Configs" {
  component "copilot.sh" as copilot <<cli>>
  component "opencode.sh" as opencode <<cli>>
  component "pi.sh" as pi <<cli>>
  component "launch-agent-common.sh\nconfigure_proxy_routing()" as common <<core>>
}

package "pi Extensions" {
  component "no-unbounded-fs-scan.ts\ntool_call guard" as fsguard <<agent>>
}

package "Shared Infrastructure" {
  cloud "rapid-llm-proxy\n(port 12435)" as proxy <<external>>
}

package "System Health Dashboard" {
  component "agent-badge.tsx\nAGENT_COLORS map" as badge <<external>>
}

copilot ..> common : "defers BYOK wiring"
opencode --> common : "sourced lifecycle hooks"
pi --> common : "sourced lifecycle hooks"

copilot --> proxy : "routes LLM calls"
opencode --> proxy : "routes LLM calls"
pi --> proxy : "routes LLM calls"

pi --> fsguard : "installs extension"
fsguard ..> pi : "blocks unbounded find (fail-open)"

badge ..> copilot : "renders badge (fallback color)"
badge ..> opencode : "renders badge (fallback color)"
badge ..> pi : "renders badge (fallback color)"

@enduml