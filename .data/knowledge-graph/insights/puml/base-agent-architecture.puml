@startuml
!include _standard-style.puml

package "TypeScript Agent Pipeline" {
  component "BaseAgent.execute()" as baseAgent <<core>>
  component "OntologyClassificationAgent\n(hard-root-guard)" as ontologyAgent <<agent>>
  component "SemanticAnalysisAgent\n(extractL2FromLLMResponse)" as semanticAgent <<agent>>
}

package "Shell Agent Launch Layer" {
  component "launch-agent-common.sh" as launcher <<cli>>
  component "opencode.sh\n(agent_pre_launch)" as opencode <<cli>>
  component "copilot.sh\n(agent_pre_launch)" as copilot <<cli>>
  component "pi.sh\n(thinkingLevelMap)" as pi <<cli>>
}

package "Config & Safety Gates" {
  database "llm-routing.yaml" as routingConfig <<storage>>
  database "coding.lower.json" as ontologyConfig <<storage>>
  component "no-unbounded-fs-scan.ts\n(offendingRoot gate)" as fsGuard <<core>>
  component "batch-provenance.mjs\n(selectBatchesForReport)" as provenance <<core>>
}

baseAgent --> ontologyAgent : "hook: detectIssues()"
baseAgent --> semanticAgent : "hook: calculateConfidence()"

launcher --> opencode : "invokes hooks"
launcher --> copilot : "invokes hooks"
launcher --> pi : "invokes hooks"

opencode ..> routingConfig : "bypasses via CODING_OPENCODE_MODEL"
ontologyAgent ..> ontologyConfig : "bypasses via hard-root-guard"

pi --> routingConfig : "reasoning_effort banding"
copilot --> routingConfig : "BYOK health-check gated"

fsGuard ..> baseAgent : "PreToolUse deterministic gate"
provenance ..> semanticAgent : "conservative degrade-not-fail"

baseAgent -- launcher : "parallel template-method pattern"

@enduml