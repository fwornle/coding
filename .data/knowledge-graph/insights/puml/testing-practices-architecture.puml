@startuml
!include _standard-style.puml

package "Test Inventory & Suite Enforcement" {
  component "Test Inventory Discovery" as inventory <<core>>
  component "node:test Compatibility" as nodetest <<core>>
  component "suiteOwnership() Guard" as guard <<core>>
}

package "CI/Build Gate" {
  component "Unified Viewer Build/Test Gate" as buildgate <<cli>>
  component "CI npm ci / .gitignore Handling" as cigate <<cli>>
}

package "Unrelated / Non-Grounding Evidence" {
  component "EntityPatternAnalyzer" as epa <<external>>
  component "verify-patterns.sh" as vps <<external>>
  component "graphify XAML Fixtures" as fixtures <<external>>
}

nodetest --> inventory : "must be recognized by"
inventory --> guard : "feeds visibility into"
guard --> buildgate : "prevents silent exclusion in"
buildgate --> cigate : "gates CI pipeline"

epa ..> guard : "no actual coupling\n(unrelated ownership heuristics)"
vps ..> guard : "thematically close,\nbut no suite-inventory logic"
fixtures ..> inventory : "inert fixture data,\nunrelated subsystem"

@enduml