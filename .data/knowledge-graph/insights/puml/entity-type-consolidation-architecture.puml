@startuml
!include _standard-style.puml

package "Migration Layer (absent from code graph)" {
  component "migrate-graph-db-entity-types.js" as migration <<core>>
  component "ENTITY_TYPE_MAPPING\n(folds 6 types -> Pattern)" as mapping <<core>>
}

package "Graph Database" {
  database "GraphDB" as gdb <<storage>>
  component "queryIncomingRelations" as queryRel <<api>>
  component "storeRelationship" as storeRel <<api>>
  component "findEntityByName" as findByName <<api>>
}

package "Consumers (ad hoc handling)" {
  component "assert-graph-density.ts" as density <<cli>>
  component "attribution.test.ts\n(categoriseUnattributed)" as attribution <<cli>>
  component "History Sidebar\n(Batch badge filter)" as sidebar <<external>>
}

migration --> mapping : "defines"
mapping --> gdb : "collapses entity Type values"
gdb --> queryRel : "reads entity Type"
gdb --> storeRel : "writes entity Type"
findByName --> gdb : "name-only lookup"
mapping ..> findByName : "increases collision risk\n(fallback to Pattern)"

gdb --> density : "entity Type / ontologyClass"
density ..> density : "disagreement not reconciled"
gdb --> attribution : "ontologyClass"
gdb --> sidebar : "entity Type drives visibility"

sidebar ..> mapping : "same taxonomy-fragility theme"

@enduml