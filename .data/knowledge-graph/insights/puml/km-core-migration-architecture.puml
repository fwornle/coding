@startuml
!include _standard-style.puml

package "Migration Scripts (named, not retrieved)" {
  component "migrate-graph-db-entity-types.js" as typeMap <<cli>>
  component "migrate-leveldb-to-kmcore.mjs" as legacyMigrate <<cli>>
  component "ENTITY_TYPE_MAPPING" as typeTable <<core>>
}

package "km-core Storage Layer" {
  component "GraphDatabaseService" as gds <<core>>
  component "km-core-adapter.ts" as adapter <<core>>
  database "graphology-level\n(.data/knowledge-graph)" as store <<storage>>
}

package "Data Integrity Concerns" {
  component "Document Store\n(Insight docs)" as docStore <<storage>>
  component "Graph Node Layer\n(Insight nodes)" as graphNodes <<storage>>
  component "findEntityByName\n(bare-name lookup)" as nameResolve <<core>>
}

typeMap --> typeTable : "consolidates legacy types"
typeMap --> gds : "calls _persistGraphToLevel()"
legacyMigrate --> gds : "dry-run / production migrate"
legacyMigrate --> store : "enforces 5% error budget"

gds --> store : "persists graph"
adapter --> nameResolve : "must bind entity Type/endpointTypes"
nameResolve ..> store : "unsafe: oldest-wins on duplicate names"

legacyMigrate --> docStore : "writes converted documents"
legacyMigrate --> graphNodes : "must verify node write too"
docStore ..> graphNodes : "NOT jointly guaranteed"

@enduml