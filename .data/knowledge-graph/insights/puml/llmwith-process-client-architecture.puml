@startuml
!include _standard-style.puml

package "CLI / Client Layer" {
  component "LLMWithProcessClient" as client <<core>>
  component "resolveProxyCompleteUrl()" as resolver <<core>>
}

package "Proxy Layer" {
  component "@rapid/llm-proxy" as proxy <<external>>
  component "copilot-model-ids (vendored)" as modelids <<external>>
}

package "Routing & Cost Infrastructure" {
  component "JudgeBackend (enabled/reachable)" as judge <<agent>>
  component "cost-model.ts (priceForModel/freshInputTokens)" as cost <<core>>
  component "LLM Routing Tier Priority" as tierpriority <<core>>
}

client --> resolver : "resolve URL fallback (4-tier)"
client --> proxy : "direct-fetch, tags process telemetry"
proxy --> modelids : "uses vendored model IDs"
modelids ..> proxy : "postinstall alignment guards drift"

client --> judge : "should check reachable, not just enabled"
client --> cost : "must normalize token/response shape"
client --> tierpriority : "must respect fallback ordering"

proxy ..> client : "response schema drift risk"
judge ..> client : "blind spot if only checks enabled"

@enduml