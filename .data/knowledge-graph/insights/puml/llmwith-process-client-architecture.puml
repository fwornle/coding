@startuml
!include _standard-style.puml

package "LLM Client Layer" {
  component "LLMWithProcessClient\n(llm-with-process.ts)" as client <<core>>
  component "llmWithProcessComplete()" as complete <<core>>
}

package "Proxy / Provider Fallback" {
  component "rapid-llm-proxy\n(proxy-bridge/server.mjs)" as proxy <<api>>
  component "Tiered Provider Fallback Chain" as fallback <<external>>
  component "LLM Model Catalogue\n(endpoint-gated)" as catalogue <<storage>>
}

package "Downstream Consumers (unrelated subsystems)" {
  component "cost-model.ts" as cost <<external>>
  component "use-classifier-judge.ts" as judge <<external>>
  component "offload-decision.tsx" as offload <<external>>
  component "model-limits.cjs\n(statusline, unrelated)" as statusline <<external>>
}

client --> complete : "builds process tag"
complete --> proxy : "calls /api/complete\n(env-var precedence resolution)"
proxy --> fallback : "routes via network-mode-aware\nfallback chain"
fallback --> catalogue : "checks endpoint-gated\nmodel access"

proxy ..> cost : "flat/object tokens shape\n(circumstantial)"
proxy ..> judge : "polls routing surface\n(circumstantial)"
offload ..> proxy : "observes routing decisions"

@enduml