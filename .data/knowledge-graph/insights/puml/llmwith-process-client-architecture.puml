@startuml
!include _standard-style.puml

package "Client Layer" {
  component "LLMWithProcessClient" as client <<core>>
  component "dmr-provider.ts / Anthropic-OpenAI-Groq Clients" as providers <<agent>>
}

package "Shared Routing Proxy" {
  component "rapid-llm-proxy" as proxy <<api>>
  component "Tier Priority Logic\n(max-subscription > Copilot > Groq)" as tiers <<core>>
  component "Classifier / Offload Policy" as classifier <<core>>
}

package "Dashboard & Observability" {
  component "cost-model.ts" as cost <<core>>
  component "offload-decision.tsx" as offload <<agent>>
  component "use-classifier-judge.ts" as judge <<agent>>
  component "copilot-model-ids.test.mjs" as drift <<cli>>
}

client --> proxy : "/api/complete"
proxy --> tiers : "resolves fallback order"
tiers --> providers : "delegates provider calls"
proxy --> classifier : "routing decisions"

client ..> providers : "process-tagged telemetry"
providers --> cost : "token-usage rows"

offload --> proxy : "/api/llm/routing/resolve"
judge --> proxy : "/api/llm/classifier"
cost --> proxy : "/api/token-usage/cost"

drift ..> proxy : "drift-guard vendored ids"

@enduml