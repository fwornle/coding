@startuml
!include _standard-style.puml

package "Health Prompt Hook (Actual)" {
  component "health-prompt-hook.js" as hook <<core>>
  component "outputHealthContext/outputEnvelope" as envelope <<core>>
  component "Health Coordinator /health/state" as coordinator <<external>>
}

package "Validation (Adjacent, Not Injection)" {
  component "ContentValidationAgent" as cva <<agent>>
}

package "Unrelated 'Hook' Sense (React UI)" {
  component "usePolledFetch.ts" as poll <<core>>
  component "workflow/hooks.ts" as whooks <<core>>
}

hook --> envelope : "builds additionalContext"
coordinator --> hook : "health state data"
envelope --> hook : "injects health text (not KB)"

cva ..> hook : "no structural link found"

poll ..> whooks : "React data fetching (different hook type)"

hook .. Gap
cva .. Gap

@enduml