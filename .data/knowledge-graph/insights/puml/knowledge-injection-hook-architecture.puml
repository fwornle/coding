@startuml
!include _standard-style.puml

package "Unresolved Component" {
  component "KnowledgeInjectionHook" as kih <<core>>
}

package "Hook Infrastructure" {
  component "UnifiedHookManager" as manager <<core>>
  component "HookConfigLoader" as loader <<core>>
  database "hooks.json (user/project)" as config <<storage>>
}

package "Adjacent Analogous Component" {
  component "health-prompt-hook.js" as healthhook <<agent>>
  component "SPEC R8 Envelope\n(hookSpecificOutput)" as envelope <<api>>
}

package "Unrelated Dashboard Hooks" {
  component "usePolledFetch.ts" as polled <<external>>
  component "hooks.ts (useWorkflowDefinitions,\nuseRecentCalls)" as dashhooks <<external>>
}

kih ..> manager : "presumed registerHandler()\n(unconfirmed)"
manager --> loader : "loads merged config"
loader --> config : "project overrides user\n(no append)"

healthhook --> envelope : "produces"
envelope ..> kih : "structurally analogous\npattern (not same)"

polled ..> dashhooks : "shares polling pattern"
dashhooks ..> kih : "no relationship\n(false match on 'hooks')"

@enduml