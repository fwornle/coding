@startuml
!include _standard-style.puml

package "Documentation Conventions" {
  component "Style Guide (docs/puml)" as styleGuide <<core>>
  component "Post-Rewrite Render Triage" as renderTriage <<core>>
}

package "Test Integrity Patterns" {
  component "suiteOwnership() Guard" as suiteGuard <<agent>>
  component "Test Inventory (node:test)" as testInventory <<agent>>
  component "Metadata Merge Bug Discipline" as mergeBug <<core>>
}

package "CI Pipeline Patterns" {
  component "Build/Test Gate Wiring" as ciGate <<cli>>
  component ".gitignore / Lockfile Check" as gitignoreCheck <<cli>>
}

component "CodingPatterns" as codingPatterns <<component>>

codingPatterns ..> styleGuide : "aggregates"
codingPatterns ..> renderTriage : "aggregates"
codingPatterns ..> suiteGuard : "aggregates"
codingPatterns ..> testInventory : "aggregates"
codingPatterns ..> mergeBug : "aggregates"
codingPatterns ..> ciGate : "aggregates"
codingPatterns ..> gitignoreCheck : "aggregates"

suiteGuard --> testInventory : "prevents silent exclusion"
ciGate --> gitignoreCheck : "diagnoses CI-only failures"
mergeBug --> renderTriage : "requires re-measurement discipline"

@enduml