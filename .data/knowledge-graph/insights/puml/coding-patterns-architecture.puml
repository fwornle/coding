@startuml
!include _standard-style.puml

package "Test Coverage Guards" {
  component "suiteOwnership() Guard" as suiteGuard <<core>>
  component "Test Inventory Discovery" as testInv <<core>>
  component "CI Build/Test Gate Wiring" as ciGate <<core>>
}

package "Docs Pipeline Rules" {
  component "Docs Style Guide" as docStyle <<core>>
  component ".puml Placement Rule" as pumlRule <<core>>
  component "Post-Rewrite Render Triage" as renderTriage <<core>>
}

package "Data Integrity Rules" {
  component "Metadata Merge Guard" as mergeGuard <<core>>
}

suiteGuard --> testInv : "requires sync with runners"
testInv ..> ciGate : "prevents silent skips"
ciGate --> mergeGuard : "surfaces failures visibly"

docStyle --> pumlRule : "defines placement contract"
pumlRule ..> renderTriage : "misplacement breaks rendering"

mergeGuard ..> renderTriage : "stale data risks regressions"
renderTriage --> ciGate : "baseline before blame"

@enduml