@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "bin/ CLI Layer" {
  component "bin/ckb" as ckb <<cli>>
  component "bin/graphify" as graphify <<cli>>
  component "bin/status" as status <<cli>>
}

package "Agent Adapter Layer" {
  component "claude.sh" as claude <<agent>>
  component "copilot.sh" as copilot <<agent>>
  component "opencode.sh" as opencode <<agent>>
  component "pi.sh" as pi <<agent>>
  component "agent-profiles.json" as profiles <<storage>>
}

package "Configuration & Orchestration" {
  component "wave-controller.ts" as wave <<core>>
  component "feature-profiles.yaml\nfeatures.yaml\ntask-taxonomy.yaml" as configs <<storage>>
  component "OntologyClassifier" as ontology <<core>>
}

cloud "Vendor LLM CLIs" as vendors <<external>>

ckb ..> configs : reads
graphify ..> configs : reads
status ..> profiles : queries

wave --> claude : invokes (env-driven)
wave --> copilot : invokes (env-driven)
wave --> opencode : invokes (env-driven)
wave --> pi : invokes (env-driven)

claude --> vendors : normalizes CLI
copilot --> vendors : normalizes CLI
opencode --> vendors : normalizes CLI
pi --> vendors : normalizes CLI

wave --> profiles : consults metadata
profiles --> claude : declarative capabilities
profiles --> copilot : declarative capabilities
profiles --> opencode : declarative capabilities
profiles --> pi : declarative capabilities

configs --> ontology : drives classification
ontology --> wave : informs dispatch

@enduml