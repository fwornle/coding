@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "CLI Entry Layer" {
  component "bin/ckb" as ckb <<cli>>
  component "bin/graphify" as graphify <<cli>>
  component "bin/codegraph" as codegraph <<cli>>
  component "docker/entrypoint.sh" as entrypoint <<cli>>
}

package "Agent Adapter Layer" {
  component "claude.sh" as claude <<agent>>
  component "opencode.sh" as opencode <<agent>>
  component "copilot.sh" as copilot <<agent>>
  component "pi.sh" as pi <<agent>>
  component "LLM Routing (env-based)" as llmrouting <<core>>
}

package "Config & Docs Layer" {
  database "features.yaml" as features <<storage>>
  database "task-taxonomy.yaml" as taxonomy <<storage>>
  database "health-verification-rules.json" as healthrules <<storage>>
  component "supervisord.conf" as supervisord <<core>>
  component "docs/architecture/*" as archdocs <<external>>
}

ckb --> llmrouting : "delegates to modules"
graphify --> llmrouting : "delegates to modules"
codegraph --> llmrouting : "delegates to modules"

llmrouting --> claude : "invokes"
llmrouting --> opencode : "invokes"
llmrouting --> copilot : "invokes"
llmrouting --> pi : "invokes"

entrypoint --> supervisord : "delegates process mgmt"
supervisord --> codegraph : "manages codegraph-index.sh"
supervisord --> graphify : "manages graphify-serve.sh"

llmrouting ..> features : "reads config"
llmrouting ..> taxonomy : "reads config"
supervisord ..> healthrules : "health polling"

archdocs ..> claude : "documents pattern"
archdocs ..> features : "documents pattern"
archdocs ..> supervisord : "documents pattern"

@enduml