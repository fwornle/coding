@startuml
!include _standard-style.puml

package "Root Level (Onboarding)" {
  component "CLAUDE.md" as claude <<cli>>
  component "README.md" as readme <<cli>>
  component "INSTALL_WINDOWS.md" as install <<cli>>
  component "docker/README.md" as dockerreadme <<cli>>
}

package "docs/architecture (Deep Concepts)" {
  component "architecture/README.md (index)" as archindex <<core>>
  component "llm-routing.md" as llmrouting <<core>>
  component "memory-systems.md" as memsys <<core>>
  component "system-overview.md" as sysoverview <<core>>
}

package "Diagram Source/Output Pairing" {
  component "docs/puml/*.puml" as pumlsrc <<storage>>
  component "docs/images/*.png" as pngout <<storage>>
  component "docs-content/images/" as mkdocsimg <<storage>>
}

claude --> archindex : "points to deep docs"
readme --> claude : "references guidelines"

archindex --> llmrouting : "indexes"
archindex --> memsys : "indexes"
archindex --> sysoverview : "indexes"

pumlsrc --> pngout : "rendered into"
pngout ..> mkdocsimg : "distinct from (not mixed)"
archindex ..> pumlsrc : "diagrams embedded via"

@enduml