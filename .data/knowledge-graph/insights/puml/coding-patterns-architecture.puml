@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Naming & Config Conventions" {
  component "ProviderRegistryManager" as prm <<core>>
  component "GraphDatabaseManager" as gdm <<core>>
  component "config/features.yaml" as feat <<external>>
  component "config/agent-profiles.json" as agentcfg <<external>>
}

package "Resilience Wrappers" {
  component "CircuitBreakerManager" as cbm <<core>>
  component "CachingMechanism" as cache <<core>>
  component "LLMServiceProvider" as llm <<api>>
}

package "Monitoring & Constraints" {
  component "ConstraintMonitoringService" as cms <<core>>
  component "egress-lint-allowlist.json" as lint <<external>>
  component "health-verification-rules.json" as health <<external>>
}

prm --> gdm : "manages"
feat --> prm : "configures"
agentcfg --> prm : "configures"

cbm --> llm : "wraps"
cache --> llm : "wraps"
llm --> gdm : "queries"

cms --> lint : "enforces"
cms --> health : "validates"
cms --> cbm : "monitors"

@enduml