@startuml
!include _standard-style.puml

package "GraphDatabaseService (write side)" {
  database "Graphology/LevelDB Store" as store
  component "Anchor Pass\n(findEntityByName)" as anchor <<core>>
  component "queryIncomingRelations /\nstoreRelationship (name+type)" as typedlookup <<core>>
  component "projectAnchorName = 'Coding'\nfallback" as fallback <<core>>
}

package "obs-api HTTP Boundary" {
  component "OBS_API :12436\n/api/v1/entities\n/api/v1/relations" as api <<api>>
}

package "Viewer / Dashboard Clients" {
  component "useGraphData(apiClient, system)" as usegraph <<core>>
  component "D3GraphCanvas.tsx" as d3 <<external>>
  component "SigmaCanvas.tsx" as sigma <<external>>
  component "assert-graph-density.ts" as density <<cli>>
  component "attribution.ts\n(rootOf / categoriseUnattributed)" as attribution <<core>>
  component "ukb-workflow-modal.tsx\n/api/ukb/history" as ukb <<external>>
}

anchor --> typedlookup : "disambiguates by (name, type)"
typedlookup --> store : "writes Insight nodes"
fallback --> store : "attaches orphans to anchor"

store --> api : "exposes entities/relations"

api --> density : "fetch entities/relations"
api --> usegraph : "fetch entities/relations/ontology"

usegraph --> d3 : "render graph"
usegraph --> sigma : "render graph"

density --> attribution : "ontologyClass ?? entity Type\nfallback mapping"
attribution --> usegraph : "shared read-side\nparent resolution"

ukb ..> api : "separate report store\n(not GraphDatabaseService)"

@enduml