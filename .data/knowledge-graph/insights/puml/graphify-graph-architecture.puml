@startuml
!include _standard-style.puml

package "Semantic Analysis (described, unverified)" {
  component "GraphifyGraph" as gg <<agent>>
  component "graph.json (static)" as gjson <<storage>>
  component "EntityKind (label inference)" as ekind <<core>>
}

package "Knowledge Management Core" {
  database "LevelDB (.data/knowledge-graph)" as kgdb <<storage>>
  component "GraphDatabaseService" as gds <<core>>
  component "km-core-adapter (typed findEntityByName)" as adapter <<core>>
}

package "Unified Viewer (live consumer)" {
  component "D3GraphCanvas" as d3 <<agent>>
  component "ontologyClass-typed Entities" as ontology <<core>>
}

gg --> gjson : "lazy mtime-cached read"
gjson --> ekind : "infer type from label string"

gds --> kgdb : "graphology-level writes"
adapter --> gds : "queryIncomingRelations / storeRelationship"

d3 --> ontology : "expects explicit ontologyClass"

ekind ..> ontology : "structural mismatch:\nlabel-inference vs explicit type"
gjson ..> kgdb : "parallel, unrelated graph stores"

@enduml