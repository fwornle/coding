@startuml
!include _standard-style.puml

package "Documentation Pipeline" {
  component "Documentation Style Guide" as styleGuide <<core>>
  component ".puml Source Files" as pumlSrc <<storage>>
  folder "docs/puml/" as pumlDir <<storage>>
  component "Docs Rendering Pipeline" as renderPipe <<core>>
}

package "Governance Rules" {
  component "Placement Rule\n(File Location = Config Signal)" as placementRule <<core>>
  component "Formatting & Naming Rules" as formatRules <<core>>
  component "VCS vs Build-Output Rule" as vcsRule <<core>>
}

package "Adjacent Tooling (Not Style Guide)" {
  component "EntityPatternAnalyzer" as epa <<agent>>
  component "verify-patterns.sh" as verify <<cli>>
}

styleGuide --> placementRule : "defines"
styleGuide --> formatRules : "defines"
styleGuide --> vcsRule : "defines"

placementRule --> pumlDir : "mandates location"
pumlSrc --> pumlDir : "must reside in"
pumlDir --> renderPipe : "enables correct rendering"

vcsRule ..> renderPipe : "prevents ephemeral artifact commits"

epa ..> styleGuide : "unrelated (team classification)"
verify ..> styleGuide : "unrelated (pattern audit)"

@enduml