@startuml
!include _standard-style.puml

package "Documentation Governance" {
  component "Documentation Style Guide" as guide <<core>>
  component "docs/puml/ Source Location" as pumlDir <<storage>>
  component "Rendered Diagram Artifacts" as artifacts <<storage>>
  component "Render Error Triage Practice" as triage <<agent>>
}

package "Unrelated Retrieved Code (No Enforcement Link)" {
  component "EntityPatternAnalyzer.ts" as epa <<core>>
  component "verify-patterns.sh" as verify <<cli>>
  component "Team Directories Map" as teamMap <<storage>>
  database "Shared Memory JSON" as sharedMem
}

guide --> pumlDir : "mandates .puml source location"
guide --> artifacts : "defines VCS vs build-output policy"
guide --> triage : "informs render-error classification"

epa --> teamMap : "regex-based ownership lookup"
verify --> sharedMem : "reads/writes compliance score"

guide ..> epa : "no coupling (false retrieval match)"
guide ..> verify : "no coupling (false retrieval match)"

@enduml