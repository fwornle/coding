@startuml
!include _standard-style.puml

package "Health Prompt Hook (unrelated to HookConfigLoader)" {
  component "health-prompt-hook.js" as hook <<core>>
  component "deriveSummary()" as summary <<core>>
  component "outputEnvelope()" as envelope <<core>>
  cloud "health-coordinator\n:3034 /health/state" as coordinator <<external>>
}

package "Feature Gating (separate system)" {
  component "require-feature.sh" as guard <<cli>>
  component "ruleFeatureActive()" as ruleCheck <<core>>
}

package "Dashboards & Client Hooks" {
  component "constraint-monitor dashboard" as cmDash <<external>>
  component "system-health-dashboard" as shDash <<external>>
  component "usePolledFetch.ts" as poll <<agent>>
}

hook --> coordinator : "fetches /health/state"
hook --> summary : "reduces status"
summary --> envelope : "wraps in fixed JSON shape (SPEC R8)"
hook --> envelope : "guarantees on error"

guard --> ruleCheck : "must agree on feature state"

hook --> cmDash : "statusline click-report"
hook --> shDash : "statusline click-report"
shDash --> poll : "visibility-aware polling"

@enduml