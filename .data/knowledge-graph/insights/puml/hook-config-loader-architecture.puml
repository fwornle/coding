@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Config Layer" {
  component "HookConfigLoader" as loader <<core>>
  component "DEFAULT_CONFIG" as defcfg <<storage>>
  component "MigrationTool" as migtool <<core>>
}

package "Hook Managers (Parallel, No Inheritance)" {
  component "UnifiedHookManager" as uhm <<core>>
  component "HooksManager (abstract)" as hm <<core>>
}

package "Agent Bridges" {
  component "ClaudeBridge" as bridge <<agent>>
  component "EVENT_MAPPINGS" as evmap <<storage>>
}

loader --> defcfg : "exports"
migtool --> defcfg : "JSON deep-clone template"
migtool --> uhm : "produces hooks.json\n(id/type/path/priority/agents)"

uhm ..> hm : "structurally similar,\nno shared code"

bridge --> uhm : "getHookManager()\n(deferred init)"
bridge --> loader : "manager.initialize()"
bridge --> evmap : "translateEvent()"

uhm --> evmap : "agents[] filtering,\nstopOnError"

bridge ..> bridge : "fail-open:\nalways exit 0,\ndecision:allow"

@enduml