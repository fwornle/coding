@startuml
!include /Users/Q284340/Agentic/coding/docs/puml/_standard-style.puml

package "Configuration Layer" {
  component "HookConfigLoader" as loader <<core>>
  database "DEFAULT_CONFIG" as defaultCfg <<storage>>
  database "~/.coding-tools/hooks.json" as userCfg <<storage>>
  database ".coding/hooks.json" as projectCfg <<storage>>
}

package "Runtime Hook Registries" {
  component "HooksManager\n(hooks-api.js)" as hooksApi <<core>>
  component "UnifiedHookManager\n(hook-manager.js)" as hookMgr <<core>>
}

package "Bridge & Execution" {
  component "claude-bridge.js\n(main)" as bridge <<agent>>
}

defaultCfg --> loader : "tier 1"
userCfg --> loader : "tier 2"
projectCfg --> loader : "tier 3"

loader --> hooksApi : "merged config (uncertain)"
loader --> hookMgr : "merged config feeds initialize()"

bridge --> hookMgr : "getHookManager()/initialize()"
hookMgr --> bridge : "executeHooks()"

bridge ..> bridge : "fail-open catch\n(decision: allow)"

hooksApi --> hooksApi : "registerHook()\npriority re-sort"
hookMgr --> hookMgr : "registerHook()\npriority re-sort"

@enduml