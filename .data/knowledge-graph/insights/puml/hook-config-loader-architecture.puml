@startuml
!include _standard-style.puml

package "Hooks Subsystem" {
  component "HookConfigLoader\n(hook-config.js, not retrieved)" as loader <<core>>
  component "HooksManager\n(hooks-api.js, abstract)" as manager <<core>>
  component "UnifiedHookManager\n(hook-manager.js)" as unified <<core>>
}

package "Bridge Layer" {
  component "ClaudeBridge\n(claude-bridge.js)" as bridge <<agent>>
}

package "External / Session Layer" {
  component "Claude Code Native Hooks" as claude <<external>>
  component "HookManagementSystem\n(statusline, ETM)" as hms <<agent>>
}

claude --> bridge : "PreToolUse/PostToolUse events"
bridge --> manager : "translates to unified vocabulary"
manager --> loader : "config-driven registration (inferred)"
manager --> unified : "shares push-then-sort idiom"
loader --> unified : "validateConfig() fail-soft pattern"
bridge --> unified : "fail-open philosophy (bridge layer)"
hms --> unified : "monitors constraint/session state"

@enduml