@startuml
!include _standard-style.puml

package "Agent API Hooks (lib/agent-api/hooks)" {
  component "HookConfigLoader" as loader <<core>>
  database "CONFIG_PATHS.user" as userCfg <<storage>>
  database "CONFIG_PATHS.project" as projCfg <<storage>>
  component "mergeConfigs()" as merge <<core>>
}

package "Adjacent Hook Tooling (env-driven, not config-loaded)" {
  component "health-prompt-hook.js" as promptHook <<agent>>
  component "health-prompt-hook-stall.test.mjs" as testHook <<external>>
}

package "Unrelated 'hooks' Namespace (React UI)" {
  component "workflow/hooks.ts" as reactHooks <<external>>
  component "usePolledFetch.ts" as pollHook <<external>>
}

userCfg --> merge : "loaded"
projCfg --> merge : "loaded"
merge --> loader : "produces final config"

loader ..> promptHook : "architecturally adjacent\n(not actually invoked)"
testHook ..> promptHook : "tests via stdout envelope"

reactHooks ..> loader : "false positive\n(filename collision)"
pollHook ..> loader : "false positive\n(filename collision)"

@enduml