# Dedicated container for Graphify — the code-knowledge-graph engine that
# replaces code-graph-rag + Memgraph. Builds from the vendored submodule
# (integrations/graphify) so all Python lives here; the host only ever talks to
# it via `docker exec` (see bin/graphify) or the HTTP MCP endpoint.
#
# Build context is the repo root (see docker-compose.yml `build.context: ..`) so
# we can COPY both the submodule and our entrypoint.
FROM python:3.12-slim

# git: graphify records `built_at_commit` (git rev-parse HEAD) into graph.json —
#      that is the "commits behind" anchor the dashboard reads.
# curl: healthcheck against the HTTP MCP endpoint.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY integrations/graphify /app

# [mcp]    -> Streamable-HTTP MCP transport (mcp + starlette)
# [pdf]    -> docs/PDF semantic pass (pypdf + markdownify)
# [office] -> docx/xlsx semantic pass
# [openai] -> OpenAI-compatible backend, routed at the host llm-cli-proxy
# NOT [all] — avoids boto3/whisper/yt-dlp/matplotlib bloat we don't need.
RUN pip install --no-cache-dir ".[mcp,pdf,office,openai]"

COPY docker/graphify-entrypoint.sh /usr/local/bin/graphify-entrypoint.sh
RUN chmod +x /usr/local/bin/graphify-entrypoint.sh

# Run as root: the graph.json output lands on the bind-mounted host .data dir,
# so a fixed non-root uid would hit permission errors on write.

EXPOSE 3851
ENTRYPOINT ["/usr/local/bin/graphify-entrypoint.sh"]
