{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "CODING_GUARD_MODE=box CODING_GUARD_KEYS=/etc/coding-guard CONSTRAINT_CONFIG_PATH=/opt/coding-guard/config/constraints/constraint-monitor.yaml node /opt/coding-guard/integrations/constraint-monitor/src/hooks/pre-tool-hook-wrapper.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
