{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin CODING_GUARD_MODE=box CODING_GUARD_KEYS=/etc/coding-guard CODING_GUARD_AGENT=claude CONSTRAINT_CONFIG_PATH=/opt/coding-guard/config/constraints/constraint-monitor.yaml /usr/local/bin/node /opt/coding-guard/integrations/constraint-monitor/src/hooks/pre-tool-hook-wrapper.js",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin CODING_GUARD_MODE=box CODING_GUARD_KEYS=/etc/coding-guard CODING_GUARD_AGENT=claude CONSTRAINT_CONFIG_PATH=/opt/coding-guard/config/constraints/constraint-monitor.yaml /usr/local/bin/node /opt/coding-guard/integrations/constraint-monitor/src/hooks/post-tool-hook.js",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin CODING_GUARD_MODE=box CODING_GUARD_KEYS=/etc/coding-guard CODING_GUARD_AGENT=claude CONSTRAINT_CONFIG_PATH=/opt/coding-guard/config/constraints/constraint-monitor.yaml /usr/local/bin/node /opt/coding-guard/integrations/constraint-monitor/src/hooks/post-tool-hook.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
