# Docker Environment Configuration for Coding Infrastructure
# Copy this file to .env and customize as needed

# ===========================================
# API Keys (required for AI services)
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ===========================================
# Host Paths (customize for your system)
# ===========================================
# Path to the coding repository on the host
CODING_REPO=/Users/yourname/Agentic/coding

# Home directory for workspace mounts
HOME=/Users/yourname

# ===========================================
# Service Ports (can be customized)
# ===========================================
SEMANTIC_ANALYSIS_PORT=3848
CONSTRAINT_MONITOR_PORT=3849
GRAPHIFY_MCP_PORT=3851
VKB_PORT=8080
HEALTH_DASHBOARD_PORT=3032
HEALTH_DASHBOARD_WS_PORT=3033

# ===========================================
# Database Ports (can be customized)
# ===========================================
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

