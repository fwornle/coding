# Linux end-to-end test for ./install.sh — runnable from macOS.
#
# WHY: the reported corporate-Ubuntu failure was invisible to CI because
# .github/workflows/cross-platform-lite.yml only *sources* install.sh and calls
# three functions; it never runs install_node_dependencies, so the npm and proxy
# paths were unreachable on every OS. Sourcing also leaves `set -euo pipefail`
# inactive, so it tested different shell semantics than a real run. This image
# actually executes the installer on a clean Debian-family box.
#
# BUILD CONTEXT: this Dockerfile expects a PRUNED context, not the repo root.
# scripts/test-install-linux.sh prepares it (tracked files only, minus docs/,
# .data/, .planning/, tests/) into a temp dir and builds from there.
#
# Do not bind-mount the repo instead: reading the working tree over macOS
# VirtioFS took minutes and dominated the runtime, and an earlier attempt that
# tar'd from a bind mount pulled in ~10.5G because `git ls-files` emits
# submodule gitlinks as paths that tar then recursed into. Copying a 44MB
# prepared context is ~9s on native FS and cached by Docker across runs.
#
# Assertions live on the host side in scripts/test-install-linux.sh.
#
# Deliberately installs ONLY the hard dependencies (git node npm python3 curl).
# plantuml, tmux and jq are omitted on purpose: their absence must NOT stop the
# install any more. If this image ever starts installing them, the regression
# this test exists to catch becomes invisible again.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        python3 \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node 22 from NodeSource, NOT Ubuntu's `nodejs` package.
#
# Ubuntu 24.04 ships Node 18, which is past end-of-life (2025-04-30) and below
# this project's floor: services run on node:22-bookworm and mastra-opencode
# requires >= 22.13.0. Testing the installer on 18 meant the harness was
# certifying a runtime the product does not support — and it showed up as a
# "Node.js version too old" warning that read like a finding about the user's
# machine rather than about this image.
#
# The base stays ubuntu:24.04 rather than node:22: the failure this harness was
# built to reproduce was on a corporate *Ubuntu* box, and swapping the base for
# a Node image would change the distro, the apt layout and the CA bundle along
# with the Node version.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# Non-root: the installer writes to $HOME and must never need sudo for its core
# path. Running as root would hide permission problems real users hit.
RUN useradd -m -s /bin/bash tester

# Create AND chown the directory before COPY. WORKDIR alone creates it as root,
# and --chown on COPY only affects the copied entries, not the parent — so the
# installer could not create its own install.log inside it and died with a bare
# "Permission denied".
RUN mkdir -p /home/tester/coding && chown tester:tester /home/tester/coding
WORKDIR /home/tester/coding
COPY --chown=tester:tester . /home/tester/coding/

USER tester

# node_modules is necessarily absent from the context (it is gitignored), so the
# npm path is genuinely exercised on a clean tree.
CMD ["bash", "scripts/test-install-linux.sh", "--in-container"]
