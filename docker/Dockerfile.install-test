# Linux end-to-end test for ./install.sh — runnable from macOS.
#
# WHY: the reported corporate-Ubuntu failure was invisible to CI because
# .github/workflows/cross-platform-lite.yml only *sources* install.sh and calls
# three functions; it never runs install_node_dependencies, so the npm/proxy
# path was unreachable on every OS. This image actually executes the installer
# on a clean Debian-family box.
#
# Build only — the assertions live in scripts/test-install-linux.sh, which drives
# three network shapes (direct / proxy-only / no-egress) against this image.
#
# Deliberately installs ONLY the hard dependencies (git node npm python3 curl).
# plantuml, tmux and jq are omitted on purpose: their absence must NOT stop the
# install any more. If this image ever starts installing them, the regression
# this test exists to catch becomes invisible again.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        python3 \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

# Non-root: the installer writes to $HOME and must never need sudo for its
# core path. Running as root would hide permission problems real users hit.
RUN useradd -m -s /bin/bash tester
USER tester
WORKDIR /home/tester

# The repo is bind-mounted read-only at /src and copied in, so a failed test run
# can never mutate the developer's working tree.
#
# Obtain the tree with a shallow git clone, NOT a filesystem copy.
#
# A copy is not viable: the live working tree carries ~17G of .data, 5.6G of
# .git, 3.8G of .specstory history, 2.4G of submodule node_modules and 2G of
# logs. An earlier `cp -a` / tar version spent longer copying than the install
# under test took, and looked like a hang.
#
# A shallow clone gives exactly the tracked files at HEAD — which is also a
# more faithful test subject, since it is precisely what a new user gets. Note
# this therefore tests COMMITTED state; commit before running the harness.
# node_modules is necessarily absent, so the npm path is genuinely exercised.
CMD ["/bin/bash", "-lc", "\
    set -e; \
    git clone --depth 1 --quiet file:///src /home/tester/coding; \
    cd /home/tester/coding; \
    exec bash scripts/test-install-linux.sh --in-container \
"]
