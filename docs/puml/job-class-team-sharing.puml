@startuml job-class-team-sharing
!include _standard-style.puml
skinparam defaultFontSize 15
skinparam componentFontSize 15
skinparam arrowFontSize 13
skinparam shadowing false
skinparam componentStyle rectangle
hide stereotype
title A team shares one taxonomy

package "a team member's learning repo  (e.g. coding-history)" {
  component "**job-classes/taxonomy.yaml**\nname, version, classes,\ngroups, prompt" as tax <<storage>>
  component "**job-classes/CHANGELOG.md**\none line per version" as log <<storage>>
  component "next (P3, P4): proposals/<member>/,\nevidence/<class>.json" as later <<external>>
}

component "**first member**\ncoding job-classes init --team <id>\nwrites the package, commits locally;\ncoding sync --push shares it" as first <<cli>>
component "**each other member**\ncoding job-classes join ~--team <id> ~--repo <url>\nbinds the team in $HOME/.coding/teams.yaml,\nclones the repo; coding sync pulls it" as member <<cli>>
component "**bindings index**\nvar/job-classes/bindings.json\nproject -> team -> taxonomy file" as index <<storage>>
component "**LLM proxy**\nlabels a project's turns with its\nteam's taxonomy, the rest with the\ndefault; a project two teams claim\nis not labelled" as proxy <<core>>

first -[#9C27B0,thickness=2]right-> tax : creates
first -[#9C27B0,thickness=2]right-> log
tax -[#FF9800,thickness=2]down-> member : pull
member -[#9C27B0,thickness=2]right-> index : rewritten on join\nand on every pull
index -[#FF9800,thickness=2]right-> proxy : read by mtime
tax -[#FF9800,thickness=2]down-> proxy : the file it names
tax -[hidden]right- log
log -[hidden]right- later

legend right
  all built (P2, the read side) except gray: next
endlegend
@enduml
