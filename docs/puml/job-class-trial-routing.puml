@startuml job-class-trial-routing
!include _standard-style.puml
skinparam defaultFontSize 16
skinparam componentFontSize 16
skinparam arrowFontSize 14
skinparam shadowing false
skinparam componentStyle rectangle
hide stereotype
title A class earns a cheaper model with evidence (replay: built · routing by class: next)

component "**turns labelled 'status'**\nanswered as usual; the proxy keeps\nthe prompt, the conversation before it,\nthe answer read, and the repo as it was" as turns <<core>>
component "**current model, replayed**\nsame agent, same repo state,\nin a sandbox" as inc <<agent>>
component "**candidate, replayed**\nthe cheaper model,\nsame turn, same sandbox" as cand <<agent>>
component "**judge, blind, both orders**\nthe same core answer?\ncontradictions? complete?" as judge <<core>>
component "**verdict per class, agent, model**\n>= 20 pairs · 90 % the same core" as verdict <<core>>
component "**the maintainer records it**\njob-classes replay evidence" as accept <<cli>>
file "**evidence/status.json**\nin the team repo\ncounts and models, no prompts" as ev <<storage>>
component "**next 'status' turn**\n-> the cheaper model\n(next: the proxy's class floor)" as next <<external>>

turns -[#9C27B0,thickness=2]right-> inc
turns -[#9C27B0,thickness=2]down-> cand
inc -[#FF9800,thickness=2]right-> judge
cand -[#FF9800,thickness=2]right-> judge
judge -[#FF9800,thickness=2]right-> verdict
verdict -[#9C27B0,thickness=2]down-> accept
accept -[#FF9800,thickness=2]left-> ev : shared with the team
ev -[#757575,thickness=1,dotted]left-> next : every member
@enduml
