@startuml network-aware-agent-selection
!include _standard-style.puml
top to bottom direction
skinparam defaultFontSize 14
skinparam componentFontSize 14
skinparam arrowFontSize 12
skinparam shadowing false
skinparam componentStyle rectangle
hide stereotype
title Same agents on every network — only the egress changes

package "coding launcher (once, at start)" {
  component "detect: dig PAC host\n(else ask the coordinator)" as detect <<cli>>
  component "pin the session to :3128\nHTTPS_PROXY · NO_PROXY=localhost,…,.bmwgroup.net" as pin <<cli>>
  component "wire the agent into the LLM proxy\n(health-gated: no proxy → no launch)" as wire <<cli>>
}

package "Agents" {
  component "claude\nANTHROPIC_BASE_URL" as claude <<agent>>
  component "copilot\nBYOK provider" as copilot <<agent>>
  component "opencode · pi\nprovider config" as ocpi <<agent>>
}

component "LLM proxy :12435\nroute → account · fallback · offload" as llm <<core>>

package "Egress, decided by the network" {
  component "home / public\ndirect" as home <<external>>
  component "VPN / corporate\n:3128 proxydetox → corporate proxy\n(Kerberos ticket)" as corp <<infra>>
  component "VPN / corporate, small calls\non-prem Qwen cluster, direct" as qwen <<external>>
}

component "Claude subscription\napi.anthropic.com" as anth <<api>>
component "GitHub Copilot\ncopilot-api.<tenant>.ghe.com" as cop <<api>>

detect CONTROL_LINE pin
pin CONTROL_LINE wire
wire CONTROL_LINE claude
wire CONTROL_LINE copilot
wire CONTROL_LINE ocpi
claude SYNC_LINE llm : /v1/messages\n(passthrough)
copilot SYNC_LINE llm : /v1/copilot
ocpi SYNC_LINE llm : /v1/opencode · /v1
llm SYNC_LINE home
llm SYNC_LINE corp
llm SYNC_LINE qwen
home SYNC_LINE anth
home SYNC_LINE cop
corp SYNC_LINE anth
corp SYNC_LINE cop
@enduml
