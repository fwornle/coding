@startuml experiment-run-sequence
!include _standard-style.puml

title Experiment Run — describe → run → compare → dashboard

box "Operator" #E8F4F8
    actor "Operator" as op
    participant "/experiment skill" as skill
end box

box "Runner (runCell per cell)" #F0E6FF
    participant "experiment-run.mjs" as runner
    participant "preflight + restore\n+ rules-strip + inject" as prep
    participant "agent (sandbox worktree)" as agent
    participant "measurement-stop\n(+ escape guard)" as mstop
end box

box "Scoring & Store" #E6F7E6
    participant "evidence + Opus judge" as judge
    participant "rapid-llm-proxy\n:12435 + token-usage.db" as proxy
    database "experiments store\n(Run · Score · Outcome)" as store
end box

box "Compare & Dashboard" #FFE6E6
    participant "experiments-compare.mjs" as compare
    participant "Performance tab (:3032)" as dash
end box

== Describe & confirm (natural-language mode) ==
op -> skill: plain-English description
skill -> skill: synthesize goal / variants / class / draft test
skill -> op: preview + drafted gate
op -> skill: confirm (Run it / ungated / edit)
skill -> skill: write config/experiments/<id>.yaml\ncompute task_hash = sha256(goal_sentence)

== Run the matrix (UNATTENDED) ==
skill -> runner: --spec <id>.yaml  [--parallel --max-parallel N]

alt serial (default)
    note over runner
      Cells run one at a time (await each).
      One global span slot; execution_mode = serial.
    end note
else parallel (opt-in — bounded worker pool)
    note over runner
      Cells overlap. SLOTLESS per-cell spans (no global slot).
      Setup mutex serializes restore; store mutex serializes
      measurement-stop. execution_mode = parallel.
    end note
end

loop each (variant × repeat) cell  —  serial: awaited · parallel: pooled
    runner -> proxy: preflight — one-token /api/complete
    group setup lock  (parallel: serialized — git worktree not concurrency-safe)
        runner -> prep: restore snapshot -> worktree,\nstrip rules, (kb-on) inject; open cells/<taskId>.log
        prep -> proxy: (kb-on) /api/retrieve — gated, fail-CLOSED
    end
    runner -> agent: drive goal in sandbox\n(per-request binding: x-task-id / config splice)\nstdout+stderr -> cells/<taskId>.log
    agent -> proxy: LLM calls (task-bound)
    proxy -> proxy: record token_usage(task_id, fg/bg)
    runner -> mstop: cell complete (exit code = terminal state)
    mstop -> mstop: escape guard — diff real repo dirty-set
    group store lock  (parallel: serialized — single-owner LevelDB)
        mstop -> judge: gate (test_command) + 5-dim rubric (forceScore)
        judge -> proxy: POST /api/complete (Opus 4.8)
        mstop -> proxy: aggregate tokens by task_id
        mstop -> store: writeRun + writeScore + writeOutcome (execution_mode)
    end
end

note over runner, proxy
  Parallel caveat: opencode (rapid-proxy provider → its own session id)
  and mastracode (task_id='') are ambient-slot-bound — with no global
  slot they measure ~0 tokens. claude (x-task-id) and copilot
  (task-scoped adapter) stay per-request bound. Run serially to measure them.
end note

== Compare & surface ==
skill -> compare: --task-hash <hash> --rank-by composite
compare -> store: readRuns join
compare -> compare: buildComparison (honesty spine)
compare -> dash: reports/<hash>.json (live source)
op -> dash: read ranked variant columns

note over compare,dash
  Same buildComparison feeds the CLI table
  and GET /api/experiments/comparison — no drift.
end note

@enduml
