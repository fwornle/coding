@startuml installation-flow
!include _standard-style.puml

title ./install.sh — what it asks, in order, and what each answer decides

start

:Impact manifest;
note right
  Lists every file, hook and daemon this run would touch,
  BEFORE the first change. ""--dry-run"" stops here.
end note

partition "Question 1 — agent scope" {
  if (Observe bare agents too? [y/N]) then (n — default)
    #E8F5E8:wrapper-scoped;
    note right: only sessions started via ""coding""\nare logged and get knowledge injected
  else (y)
    #FFF2E6:global;
    note right: hooks + MCP written into &#126;/.claude,\n&#126;/.config/opencode (reversible)
  endif
}

partition "Question 2 — tier" {
  switch (Choice [1-4] (default: harness))
  case (1)
    #E8F4FD:harness;
  case (2)
    #E8F4FD:learning;
  case (3)
    #E8F4FD:learning-perf;
  case (4)
    #E8F4FD:everything;
  endswitch
  :write &#126;/.coding/features.yaml;
  note right
    The ONE answer every later step, the launcher,
    the container, the status line and the dashboard
    read. Change it later: ""coding-features profile <tier>""
    or the dashboard's Features tab.
  end note
}

:Network first: proxy detection + preflight;
:System dependencies (each one asks y / N / skip-all);
:Question 3 — machine scope\n(name of the runtime home &#126;/.coding/data/<scope>/);

partition "Install steps — each gated by the tier" {
  :npm dependencies, LLM proxy (rapid-llm-proxy) — every tier;
  :session logging, observations, knowledge base,\nviewer, UKB — learning and up;
  :performance measurement — learning-perf and up;
  :constraints + code graph — everything;
}

if (platform?) then (macOS)
  :launchd LaunchAgents\n(only the tier's daemons);
elseif (Linux / WSL with systemd) then
  :systemd --user units + timers\n(only the tier's daemons);
else (WSL without systemd)
  #FFFACD:no daemons + the /etc/wsl.conf fix;
endif

:Verify, report warnings / failures;
:""source .activate"" → ""coding"" is on PATH;

stop

note right
  Learned data is set up per repo on the first
  ""coding"" launch in it (see learning-repo-setup) —
  only the coding checkout's own is asked here
  (learning tiers: ""setup_history_repo"").
end note

@enduml
