@startuml launcher-startup-sequence
!include _standard-style.puml
skinparam defaultFontSize 13
skinparam shadowing false

title Coding Launcher Startup Sequence

actor User as user
participant "bin/coding" as launcher
participant "launch-agent-\ncommon.sh" as common
participant "detect-\nnetwork.sh" as network
participant "health\ncoordinator :3034" as coord
participant "agent config\n(config/agents/*.sh)" as agent
participant "LLM proxy\n:12435" as llm
participant "tmux-session-\nwrapper.sh" as tmux

user -> launcher: coding --opencode
activate launcher
launcher -> common: launch_agent()
activate common

== Environment ==
common -> common: resolve project · load .env files · resolve features

== Network (detect_network_and_configure_proxy) ==
common -> network: detect_corporate_network()
activate network
network -> network: dig PAC host / cc-github\n(DNS — needs no proxy)
opt neither resolves
  network -> coord: GET /health/state → network.location
end
network -> network: INSIDE_CN, PROXY_REQUIRED
network -> network: configure_proxy_if_needed()
alt :3128 answers (ensure_proxydetox_up)
  network -> network: pin HTTP(S)_PROXY=127.0.0.1:3128\nNO_PROXY=localhost,…,.bmwgroup.net\n(on every network)
else :3128 broken
  network -> coord: network.proxy_heal_cause?
  alt restarting / network-change / no-ticket
    network -> network: defer to the coordinator\n(wait ≤ 20 s for a restart in progress)
  else daemon, or no answer
    network -> network: one local heal attempt
  end
  network -> network: still dead → leave the session direct
end
network -> network: test_proxy_connectivity() → PROXY_WORKING
network --> common
deactivate network

== Services (enabled features only) ==
common -> common: start services · verify monitoring\ninject knowledge context

== Agent ==
common -> agent: check requirements · agent_pre_launch()
activate agent
agent -> network: validate_agent_connectivity()\n(warning only)
agent --> common
deactivate agent
common -> common: agent_common_init()\nLSL, hooks, status line

== Route through the LLM proxy (configure_proxy_routing) ==
common -> llm: GET /health (5 × 2 s)
alt proxy answers
  common -> common: wire the agent's seam\n(base URL / BYOK / provider config)
else never answers
  common --> user: stop, with the restart command
end

== Launch ==
common -> tmux: tmux_session_wrapper()
tmux --> user: agent running in tmux
deactivate common
deactivate launcher
@enduml
