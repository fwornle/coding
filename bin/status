#!/usr/bin/env node

/**
 * Status Command: show detailed system status and open the dashboard
 *
 *   status             features, status line, constraint details, dashboard links; opens
 *                      the system health dashboard
 *   status --no-open   the same, without opening a browser
 */

import { execSync, spawn } from 'child_process';
import { readFileSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const rootDir = join(__dirname, '..');

async function showDetailedStatus() {
  console.log('🎯 System Status Dashboard');
  console.log('═'.repeat(50));

  // Which features are on, first: everything below reports on a subset of the
  // system, and reading "VKB Server: offline" without knowing the knowledge base
  // was switched off is how a working install gets diagnosed as broken.
  try {
    const { loadFeatures } = await import('../lib/features/index.mjs');
    const f = loadFeatures();
    console.log(`\n🎛️  Features${f.profile ? ` (profile: ${f.profile})` : ''}: ${f.enabled.join(', ') || '(none)'}`);
    if (f.disabled.length) console.log(`   off: ${f.disabled.join(', ')}`);
    for (const w of f.warnings) console.log(`   ⚠️  ${w}`);
  } catch (error) {
    console.log(`\n🎛️  Features: unreadable — ${error.message}`);
  }

  let features = null;
  try {
    const { loadFeatures } = await import('../lib/features/index.mjs');
    features = new Set(loadFeatures().enabled);
  } catch { /* reported above; show everything below (fail open, like every display) */ }
  const on = (id) => !features || features.has(id);

  try {
    const output = execSync('node ./scripts/combined-status-line.js', {
      encoding: 'utf8',
      timeout: 5000,
      cwd: rootDir
    });
    console.log(`\n📊 Current Status: ${output.trim()}`);
  } catch (error) {
    console.error(`❌ Status line failed: ${error.message}`);
  }

  if (on('constraints')) {
    try {
      const constraintOutput = execSync('node ./integrations/constraint-monitor/src/status/constraint-status-line.js', {
        encoding: 'utf8',
        timeout: 5000,
        cwd: rootDir
      });
      console.log('\n🛡️  CONSTRAINT MONITOR DETAILS:');
      console.log(JSON.parse(constraintOutput).tooltip);
    } catch (error) {
      console.error(`❌ Constraint status failed: ${error.message}`);
    }
  }

  // The dashboards that exist today (ports from .env.ports): the system health
  // dashboard, and the constraint monitor's own frontend. The old standalone
  // constraint dashboard on :3001 and its launcher are gone.
  const dashboards = [
    { feature: 'health', name: 'System health dashboard', url: `http://localhost:${port('SYSTEM_HEALTH_DASHBOARD_PORT', 3032)}/` },
    { feature: 'constraints', name: 'Constraint monitor', url: `http://localhost:${port('CONSTRAINT_DASHBOARD_PORT', 3030)}/` },
  ].filter((d) => on(d.feature));

  if (!dashboards.length) return;
  console.log('\n🌐 Web Dashboards:');
  for (const d of dashboards) {
    d.up = await reachable(d.url);
    console.log(`• ${d.name}: ${d.url}${d.up ? '' : '  (not answering — check: coding-features status, docker ps)'}`);
  }

  const main = dashboards[0];
  if (process.argv.includes('--no-open') || !main.up) return;
  console.log(`\n🚀 Opening ${main.name}...`);
  openUrl(main.url);
}

/** A port from the environment, else .env.ports, else the documented default. */
function port(name, fallback) {
  if (process.env[name]) return process.env[name];
  try {
    const m = readFileSync(join(rootDir, '.env.ports'), 'utf8').match(new RegExp(`^${name}=(\\d+)`, 'm'));
    if (m) return m[1];
  } catch { /* no .env.ports: use the default */ }
  return fallback;
}

async function reachable(url) {
  try {
    const res = await fetch(url, { signal: AbortSignal.timeout(3000) });
    return res.status < 500;
  } catch {
    return false;
  }
}

/** Same per-platform opener as bin/vkb; prints the URL where there is none. */
function openUrl(url) {
  const opener = process.platform === 'darwin' ? ['open', [url]]
    : process.platform === 'win32' ? ['cmd', ['/c', 'start', '', url]]
    : isWsl() && hasCommand('wslview') ? ['wslview', [url]]
    : hasCommand('xdg-open') ? ['xdg-open', [url]]
    : null;
  if (!opener) { console.log(url); return; }
  spawn(opener[0], opener[1], { stdio: 'ignore', detached: true }).unref();
}

function isWsl() {
  try { return /microsoft/i.test(readFileSync('/proc/version', 'utf8')); } catch { return false; }
}

function hasCommand(cmd) {
  try { execSync(`command -v ${cmd}`, { stdio: 'ignore' }); return true; } catch { return false; }
}

showDetailedStatus();