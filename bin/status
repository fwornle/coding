#!/usr/bin/env node

/**
 * Status Command: Show detailed system status and open dashboard
 */

import { execSync } from 'child_process';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const rootDir = join(__dirname, '..');

async function showDetailedStatus() {
  console.log('🎯 System Status Dashboard');
  console.log('═'.repeat(50));

  // Which features are on, first: everything below reports on a subset of the
  // system, and reading "VKB Server: offline" without knowing the knowledge base
  // was switched off is how a working install gets diagnosed as broken.
  try {
    const { loadFeatures } = await import('../lib/features/index.mjs');
    const f = loadFeatures();
    console.log(`\n🎛️  Features${f.profile ? ` (profile: ${f.profile})` : ''}: ${f.enabled.join(', ') || '(none)'}`);
    if (f.disabled.length) console.log(`   off: ${f.disabled.join(', ')}`);
    for (const w of f.warnings) console.log(`   ⚠️  ${w}`);
  } catch (error) {
    console.log(`\n🎛️  Features: unreadable — ${error.message}`);
  }

  try {
    // Get status line output
    const output = execSync('node ./scripts/combined-status-line.js', { 
      encoding: 'utf8', 
      timeout: 5000,
      cwd: rootDir
    });
    
    console.log(`\n📊 Current Status: ${output.trim()}`);
    
    // Get constraint details
    const constraintOutput = execSync('node ./integrations/constraint-monitor/src/status/constraint-status-line.js', {
      encoding: 'utf8',
      timeout: 5000,
      cwd: rootDir
    });
    
    const constraintData = JSON.parse(constraintOutput);
    
    console.log('\n🛡️  CONSTRAINT MONITOR DETAILS:');
    console.log(constraintData.tooltip);
    
    // Offer to open dashboard
    console.log('\n🌐 Web Dashboard Available:');
    console.log('• URL: http://localhost:3001/dashboard');
    console.log('• Command: ./bin/dashboard');
    
    // Auto-open dashboard
    console.log('\n🚀 Opening dashboard...');
    execSync(`"${join(rootDir, 'integrations/constraint-monitor/bin/dashboard')}"`, {
      stdio: 'inherit',
      timeout: 10000,
      cwd: rootDir
    });
    
  } catch (error) {
    console.error('❌ Failed to get status:', error.message);
    console.log('\n💡 Try running: ./bin/dashboard');
  }
}

showDetailedStatus();