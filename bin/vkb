#!/bin/bash
# Universal vkb wrapper

# Feature gate. Without it this command fails with whatever its backend happens
# to say — "connection refused", "no such container", a timeout — none of which
# mention that the feature is switched off. See docs/architecture/features.md.
if [ -z "${CODING_REPO:-}" ]; then
  CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
  export CODING_REPO
fi
# shellcheck source=/dev/null
. "$CODING_REPO/lib/features/require-feature.sh"
require_feature knowledge

CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
export CODING_REPO
exec "$CODING_REPO/knowledge-management/vkb" "$@"
