#!/usr/bin/env bash
# Open the knowledge viewer — no dev server.
#
#   vkb               build if needed, then open the coding graph
#   vkb okb           the operational knowledge base instead
#   vkb --no-open     just print the URL
#   vkb --build       rebuild even if the build looks current
#
# obs-api (:12436, the host service the viewer reads from anyway) serves the
# built viewer under /viewer/ (lib/viewer/mount.mjs). This command makes sure
# that build exists and is not older than the viewer's sources, then opens it.
# Replaces the vkb command that went with vkb-server (2026-09-08).
set -euo pipefail

if [ -z "${CODING_REPO:-}" ]; then
  CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
  export CODING_REPO
fi
# shellcheck source=/dev/null
. "$CODING_REPO/lib/features/require-feature.sh"
require_feature knowledge

VIEWER="$CODING_REPO/integrations/unified-viewer"
DIST="$VIEWER/dist"
PORT="${OBSERVATIONS_API_PORT:-12436}"
LOG="$CODING_REPO/.logs/vkb-build.log"

system=coding open_it=true force=false
for arg in "$@"; do
  case "$arg" in
    coding|okb)  system="$arg" ;;
    --no-open)   open_it=false ;;
    --build)     force=true ;;
    -h|--help)   sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)           echo "vkb: unknown argument: $arg (try --help)" >&2; exit 2 ;;
  esac
done

# Stale = no build, or any source the build is made from is newer than it.
needs_build() {
  [ "$force" = true ] && return 0
  [ -f "$DIST/index.html" ] || return 0
  [ -n "$(find "$VIEWER/src" "$VIEWER/index.html" "$VIEWER/vite.config.ts" "$VIEWER/package.json" \
            -newer "$DIST/index.html" -print -quit 2>/dev/null)" ]
}

if needs_build; then
  mkdir -p "$(dirname "$LOG")"
  if [ ! -d "$VIEWER/node_modules" ]; then
    echo "vkb: installing the viewer's dependencies (once)…"
    (cd "$VIEWER" && npm ci --no-audit --no-fund) >>"$LOG" 2>&1 \
      || { echo "vkb: npm ci failed — see $LOG" >&2; exit 1; }
  fi
  echo "vkb: building the viewer…"
  # vite only, not `npm run build`: that also type-checks, and a type error
  # somewhere in the viewer should not stop anyone from opening it.
  (cd "$VIEWER" && npx --no-install vite build) >>"$LOG" 2>&1 \
    || { echo "vkb: build failed — see $LOG" >&2; exit 1; }
fi

url="http://127.0.0.1:${PORT}/viewer/${system}"
if ! curl -sf -m 3 "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
  echo "vkb: obs-api is not answering on :${PORT} — the viewer is served by it." >&2
  echo "     Check: coding-features status   (observations must be on)" >&2
  exit 1
fi

if [ "$open_it" = false ]; then echo "$url"; exit 0; fi

case "$(uname -s)" in
  Darwin) open "$url" ;;
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null && command -v wslview >/dev/null 2>&1; then wslview "$url"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
    else echo "$url"; fi ;;
  *) echo "$url" ;;
esac
echo "vkb: $url"
