#!/usr/bin/env bash
# Open the knowledge viewer — no dev server, no host build.
#
#   vkb               open the coding graph
#   vkb okb           the operational knowledge base instead
#   vkb --no-open     just print the URL
#
# The coding-services container serves the built viewer under /viewer/ from
# the dashboard frontend (:3032, static-server.js + lib/viewer/mount.mjs); the
# image builds it (docker/Dockerfile.coding-services). The page reads its data
# from obs-api (:12436) on the host. The :5173 vite dev server is only for
# working on the viewer itself.
# Replaces the vkb command that went with vkb-server (2026-09-08).
set -euo pipefail

if [ -z "${CODING_REPO:-}" ]; then
  CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
  export CODING_REPO
fi
# shellcheck source=/dev/null
. "$CODING_REPO/lib/features/require-feature.sh"
require_feature knowledge

PORT="${HEALTH_DASHBOARD_PORT:-3032}"
DATA_PORT="${OBSERVATIONS_API_PORT:-12436}"

system=coding open_it=true
for arg in "$@"; do
  case "$arg" in
    coding|okb)  system="$arg" ;;
    --no-open)   open_it=false ;;
    -h|--help)   sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)           echo "vkb: unknown argument: $arg (try --help)" >&2; exit 2 ;;
  esac
done

url="http://127.0.0.1:${PORT}/viewer/${system}"
# The mount marks its answers (X-Coding-Viewer); a plain 200 can be the
# dashboard's own shell from a container that predates the viewer mount.
mark="$(curl -s -o /dev/null -D - -m 5 "$url" 2>/dev/null | tr -d '\r' \
        | awk -F': ' 'tolower($1)=="x-coding-viewer" {print $2}' || true)"
case "$mark" in
  built) ;;
  not-built|"")
    if [ -z "$mark" ] && ! curl -s -o /dev/null -m 5 "http://127.0.0.1:${PORT}/" 2>/dev/null; then
      echo "vkb: nothing answers on :${PORT} — the viewer is served by the coding-services container." >&2
      echo "     Check: docker ps (coding-services up?) and coding-features status (health on?)" >&2
      exit 1
    fi
    echo "vkb: the container on :${PORT} has no viewer build — its image predates it." >&2
    echo "     Rebuild: docker compose -f \"$CODING_REPO/docker/docker-compose.yml\" build coding-services" >&2
    echo "              docker compose -f \"$CODING_REPO/docker/docker-compose.yml\" up -d coding-services" >&2
    exit 1 ;;
esac
if ! curl -sf -m 3 "http://127.0.0.1:${DATA_PORT}/health" >/dev/null 2>&1; then
  echo "vkb: warning — obs-api is not answering on :${DATA_PORT}; the viewer opens but shows no graph." >&2
  echo "     Check: coding-features status   (observations must be on)" >&2
fi

if [ "$open_it" = false ]; then echo "$url"; exit 0; fi

case "$(uname -s)" in
  Darwin) open "$url" ;;
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null && command -v wslview >/dev/null 2>&1; then wslview "$url"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
    else echo "$url"; fi ;;
  *) echo "$url" ;;
esac
echo "vkb: $url"
