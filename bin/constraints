#!/usr/bin/env bash
# Host entry point to the constraint-monitor CLI.
#
# Deliberately in-process rather than a call into the coding-services container:
# this is the same code path the PreToolUse/UserPromptSubmit hooks take, so a
# constraint check keeps working when the container is down.
#
# Replaces the former `constraint-monitor` MCP server. See /constraints.
set -euo pipefail

# config-manager.js resolves .constraint-monitor.yaml from CODING_REPO and
# refuses to guess, so the repo root is resolved from this script's location
# when the caller has not already exported it.
if [[ -z "${CODING_REPO:-}" ]]; then
    CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
    export CODING_REPO
fi

exec node "$CODING_REPO/integrations/mcp-constraint-monitor/src/cli.js" "$@"
