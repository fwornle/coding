#!/bin/bash
# Clean Knowledge Base - Remove garbage patterns and duplicates
# Maintains only high-quality, transferable insights

set -euo pipefail

# Feature gate. Without it this command fails with whatever its backend happens
# to say — "connection refused", "no such container", a timeout — none of which
# mention that the feature is switched off. See docs/architecture/features.md.
if [ -z "${CODING_REPO:-}" ]; then
  CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
  export CODING_REPO
fi
# shellcheck source=/dev/null
. "$CODING_REPO/lib/features/require-feature.sh"
require_feature knowledge


# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🧹 Knowledge Base Cleanup${NC}"
echo -e "${BLUE}========================${NC}"
echo

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODING_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$CODING_ROOT"

# Knowledge export file (new format)
KB_FILE=".data/knowledge-export/coding.json"

# Check if knowledge export file exists
if [[ ! -f "$KB_FILE" ]]; then
    echo -e "${RED}❌ Knowledge base file not found: $KB_FILE${NC}"
    exit 1
fi

# Show current stats
echo -e "${BLUE}📊 Before Cleanup:${NC}"
ENTITIES=$(jq '.entities | length' "$KB_FILE" 2>/dev/null || echo "0")
RELATIONS=$(jq '.relations | length' "$KB_FILE" 2>/dev/null || echo "0")
FILE_SIZE=$(du -h "$KB_FILE" | cut -f1)

echo -e "  Entities: $ENTITIES"
echo -e "  Relations: $RELATIONS"
echo -e "  File size: $FILE_SIZE"

# Check for garbage patterns
GARBAGE_COUNT=$(jq '[.entities[] | select(.name | test("^(GitPattern_|ConversationPattern_|SuccessPattern_.*post-logged)"))] | length' "$KB_FILE" 2>/dev/null || echo "0")

if [[ "$GARBAGE_COUNT" -gt 0 ]]; then
    echo -e "${YELLOW}⚠️  Found $GARBAGE_COUNT garbage patterns${NC}"
fi

# Check for duplicate observations
ENTITIES_WITH_DUPS=$(jq '[.entities[] | select(.observations and (.observations | length) > (.observations | unique | length))] | length' "$KB_FILE" 2>/dev/null || echo "0")

if [[ "$ENTITIES_WITH_DUPS" -gt 0 ]]; then
    echo -e "${YELLOW}⚠️  Found $ENTITIES_WITH_DUPS entities with duplicate observations${NC}"
fi

echo

# Run cleanup if needed
if [[ "$GARBAGE_COUNT" -gt 0 ]] || [[ "$ENTITIES_WITH_DUPS" -gt 0 ]]; then
    echo -e "${BLUE}🧹 Running cleanup...${NC}"

    # Run garbage pattern removal
    node "$CODING_ROOT/scripts/remove-garbage-patterns.js"

    # Run duplicate relation cleanup
    node "$CODING_ROOT/scripts/cleanup-knowledge-export.js"

    echo
    echo -e "${BLUE}📊 After Cleanup:${NC}"
    NEW_ENTITIES=$(jq '.entities | length' "$KB_FILE" 2>/dev/null || echo "0")
    NEW_RELATIONS=$(jq '.relations | length' "$KB_FILE" 2>/dev/null || echo "0")
    NEW_FILE_SIZE=$(du -h "$KB_FILE" | cut -f1)

    echo -e "  Entities: $NEW_ENTITIES (was $ENTITIES)"
    echo -e "  Relations: $NEW_RELATIONS (was $RELATIONS)"
    echo -e "  File size: $NEW_FILE_SIZE (was $FILE_SIZE)"
    echo

    REMOVED_ENTITIES=$((ENTITIES - NEW_ENTITIES))
    REMOVED_RELATIONS=$((RELATIONS - NEW_RELATIONS))

    if [[ "$REMOVED_ENTITIES" -gt 0 ]] || [[ "$REMOVED_RELATIONS" -gt 0 ]]; then
        echo -e "${GREEN}🗑️  Removed: $REMOVED_ENTITIES garbage entities, $REMOVED_RELATIONS duplicate relations${NC}"
    fi

    echo -e "${GREEN}✅ Knowledge base cleaned!${NC}"
else
    echo -e "${GREEN}✅ Knowledge base is already clean!${NC}"
fi

echo
echo -e "${BLUE}💡 Quality Guidelines:${NC}"
echo -e "  • Only add significant, transferable insights"
echo -e "  • Use MCP semantic-analysis workflow for curation"
echo -e "  • Avoid auto-discovery of low-quality patterns"
echo -e "  • Run 'clean-knowledge-base' periodically"
