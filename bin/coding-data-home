#!/usr/bin/env node
/**
 * Print where this installation's data lives, so shell callers do not have to
 * reimplement the derivation.
 *
 * docker-compose.yml mounts $CODING_DATA_HOME and refuses to start without it
 * (a wrong data path opens an EMPTY graph, which looks exactly like a knowledge
 * base that lost its content). Every launcher therefore has to export it, and
 * they are shell, not node — this is the one-line bridge.
 *
 *   export CODING_DATA_HOME="$(bin/coding-data-home)"
 *
 * Flags:
 *   --ensure      create the root and its subtrees first, then print
 *   --explain     human-readable scope provenance and layout
 *   --scope       print just the resolved scope
 *
 * `--scope` exists for the same reason this file does: docker-compose has to be
 * TOLD the scope (`~/.coding/scope` is a per-machine fact that does not exist in
 * the image, exactly as with the data root), the launchers that tell it are
 * shell, and a second derivation in bash would be a second implementation of
 * tenancy — the thing lib/scope exists to prevent.
 */

// ESM, not CJS: the root package.json declares "type": "module", so an
// extensionless bin is loaded as ESM and `require` is not defined. That is the
// same trap that left src/live-logging/ExchangeRouter.js permanently unloadable.
import { dataHome, ensureDataHome, explain } from '../lib/paths/index.mjs';
import { requireScope, resolveScope, ScopeError } from '../lib/scope/index.mjs';

const argv = process.argv.slice(2);

if (argv.includes('--help') || argv.includes('-h')) {
  process.stdout.write(
    'usage: coding-data-home [--ensure] [--explain] [--scope] [--require-scope]\n' +
      '  (no flags)       print the resolved data root\n' +
      '  --ensure         create the root and its history/ kb/ var/ subtrees first\n' +
      '  --explain        print the scope, where it came from, and the layout\n' +
      '  --scope          print just the resolved scope (may be the placeholder)\n' +
      '  --require-scope  print the scope, or exit 2 if it is the placeholder\n',
  );
  process.exit(0);
}

// --require-scope before --scope: a caller that passes both is asking the
// stricter question, and `argv.includes` has no notion of flag order.
//
// This is the shell-callable form of requireScope(), so install.sh can validate
// an answer by RUNNING the resolver instead of carrying a second copy of
// SCOPE_RE in bash. Exit 2 rather than 1 matches scripts/migrate-data-home.mjs,
// the other surface that refuses on the placeholder.
if (argv.includes('--require-scope')) {
  try {
    process.stdout.write(`${requireScope()}\n`);
    process.exit(0);
  } catch (err) {
    if (err instanceof ScopeError) {
      process.stderr.write(`${err.message}\n`);
      process.exit(2);
    }
    throw err;
  }
}

if (argv.includes('--scope')) {
  process.stdout.write(`${resolveScope()}\n`);
  process.exit(0);
}

if (argv.includes('--ensure')) ensureDataHome();

if (argv.includes('--explain')) {
  const e = explain();
  const lines = [
    `scope        ${e.scope}${e.scopeIsDefault ? '   (PLACEHOLDER — no ~/.coding/scope)' : ''}`,
    `  from       ${e.scopeSource}${e.scopePath ? ` (${e.scopePath})` : ''}`,
    `data home    ${e.dataHome}${e.dataHomeOverridden ? '   (CODING_DATA_HOME)' : ''}`,
    `  exists     ${e.exists}`,
    `  tracked    ${e.tracked}${e.tracked ? '' : '   (no git repo — data is local only)'}`,
    `history      ${e.history}        tracked`,
    `kb           ${e.kb}             tracked`,
    `var          ${e.var}            NOT tracked`,
  ];
  process.stdout.write(`${lines.join('\n')}\n`);
  process.exit(0);
}

process.stdout.write(`${dataHome()}\n`);
