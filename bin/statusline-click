#!/usr/bin/env bash
#
# Act on a click in the tmux status line.
#
# Invoked by the MouseDown1Status binding installed in
# scripts/tmux-session-wrapper.sh, with the tag tmux reports in
# #{mouse_status_range} (set by the `#[range=user|…]` markers that
# lib/statusline/clickable.cjs writes into the line) plus the pane that was
# active at the time — needed because display-popup has to be told where to
# draw when it is reached from a shell rather than from a key binding.
#
# Every action is read-only: it opens a page or shows a report. Nothing here
# restarts, toggles or writes anything, because a status line is glanced at far
# more often than it is deliberately clicked, and a stray click must never be
# able to change the system's state.
set -uo pipefail

TAG="${1:-}"
PANE="${2:-}"
CODING_REPO="${CODING_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

DASHBOARD="http://localhost:3032"
CONSTRAINTS="http://localhost:3030"
COORDINATOR="http://localhost:3034"
PROXY="http://localhost:12435"

note() { [ -n "$PANE" ] && tmux display-message -t "$PANE" "$*" || true; }

# Every dispatch is recorded, tag included. A click that does nothing is
# otherwise indistinguishable from a click tmux never reported: both leave no
# trace at all, and telling those two apart is the whole first step of
# debugging this — it decides whether to look at this script or at the binding
# that calls it. One line per click; nothing else rotates this file, so it caps
# itself rather than growing for the life of the install.
: "${STATUSLINE_CLICK_LOG:=$CODING_REPO/.logs/statusline-click.log}"
mkdir -p "$(dirname "$STATUSLINE_CLICK_LOG")" 2>/dev/null

# All logging goes through here, and the whole GROUP is redirected.
#
# `printf ... >>"$log" 2>/dev/null` does NOT do this. Redirections are applied
# left to right, so when the append fails the shell reports it on stderr that is
# still the terminal — the 2>/dev/null arrives too late to matter. On a
# read-only checkout every click then printed
#   bash: .logs/statusline-click.log: Read-only file system
# and tmux renders any output from run-shell in a view the user must dismiss:
# a diagnostic aid becoming the interruption it exists to prevent. Found by
# running this script in a container with the repo mounted read-only.
click_log() {
  { printf '%s\n' "$*" >>"$STATUSLINE_CLICK_LOG"; } 2>/dev/null || true
}

click_log "$(date -u +%Y-%m-%dT%H:%M:%SZ) tag=${TAG:-<empty>} pane=${PANE:-<none>}"
# Same left-to-right redirection trap as click_log: `wc -c <"$f" 2>/dev/null`
# reports an unopenable $f on the stderr it has at that moment, which is still
# the terminal. The group redirection is what actually silences it.
if [ "$( { wc -c <"$STATUSLINE_CLICK_LOG"; } 2>/dev/null || echo 0)" -gt 131072 ]; then
  { tail -n 500 "$STATUSLINE_CLICK_LOG" >"$STATUSLINE_CLICK_LOG.tmp" \
      && mv "$STATUSLINE_CLICK_LOG.tmp" "$STATUSLINE_CLICK_LOG"; } 2>/dev/null || true
fi

# The pane's own environment does NOT reach us: run-shell runs in the tmux
# SERVER's environment, not the pane's, so CODING_AGENT / TMUX_SESSION_NAME /
# TRANSCRIPT_SOURCE_PROJECT are all unset here however they were exported at
# launch. They are recovered from the session name tmux gives us plus the map
# scripts/tmux-session-wrapper.sh writes at launch — the same record the context
# gauge and the LSL badge already read, so this cannot drift from what the
# status line itself is displaying.
pane_session=""; pane_agent="claude"; pane_project="$CODING_REPO"
if [ -n "$PANE" ]; then
  pane_session="$(tmux display-message -p -t "$PANE" '#{session_name}' 2>/dev/null || true)"
fi
if [ -n "$pane_session" ] && [ -r "$CODING_REPO/.data/agent-sessions/$pane_session.json" ]; then
  map="$CODING_REPO/.data/agent-sessions/$pane_session.json"
  pane_agent="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("agent","claude"))' "$map" 2>/dev/null || echo claude)"
  pane_project="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("projectPath",""))' "$map" 2>/dev/null || echo "")"
fi

# Chrome by name rather than `open <url>`: the dashboards keep per-origin state
# (auth, tab position) that only lines up if they always land in the same
# browser, whatever the OS default happens to be that week.
#
# REUSES AN EXISTING TAB. A status line is clicked often, and `open` would leave
# a fresh duplicate tab behind every single time. The AppleScript below looks for
# a tab whose URL starts with $2 — the ORIGIN for the dashboards, so any tab
# already showing one is re-used and merely navigated to the route being asked
# for (that is what selects the sub-tab), and the full repo URL for a project
# bubble, so two different repos still get a tab each. A tab already sitting on
# the exact target is focused WITHOUT being reloaded, which keeps its scroll
# position and any filter the user had set.
# Is an AUTOMATION Chrome running — gsd-browser, Playwright, Puppeteer?
#
# This decides whether the tab-reuse script below can be trusted at all, and it
# is not a detail. Apple Events are addressed by BUNDLE ID, and an automation
# browser is the same bundle as the user's, distinguished only by its own
# --user-data-dir. When one is running it answers `tell application "Google
# Chrome"` FIRST, so the reuse script drives the automation profile instead of
# the browser on the user's screen — it finds a tab, navigates it, reports
# success, and the user sees nothing change. That is not hypothetical: it is
# what shipped, and what made the fault so hard to see, because verifying the
# fix by asking AppleScript what happened asks the WRONG browser both times.
#
# Raising the user's Chrome first does not help — Apple Events do not follow
# frontmost-ness (measured). LaunchServices `open` does route to the user's
# default-profile instance, so that is the safe path whenever an automation
# browser is up.
#
# The test is "any Chrome with an explicit --user-data-dir", not "gsd-browser"
# specifically: every automation runner sets one and the user's own never does,
# so this covers Playwright and Puppeteer too. Erring toward "automation is
# running" costs only a duplicate tab; erring the other way loses the click.
automation_chrome_running() {
  pgrep -f 'Google Chrome\.app/Contents/MacOS/Google Chrome.*--user-data-dir=' >/dev/null 2>&1
}

# Which platform's opener applies. STATUSLINE_CLICK_PLATFORM overrides it so the
# suite can exercise every branch from one machine — without that seam the Linux
# and Windows paths would only ever be checked by a user on those systems, which
# is exactly how they came to be broken in the first place.
click_platform() {
  if [ -n "${STATUSLINE_CLICK_PLATFORM:-}" ]; then echo "$STATUSLINE_CLICK_PLATFORM"; return; fi
  case "$(uname -s)" in
    Darwin) echo macos ;;
    # WSL reports Linux but has no working xdg-open by default and CAN reach the
    # Windows shell, so it is its own case — same split install.sh makes.
    Linux) if grep -qi microsoft /proc/version 2>/dev/null; then echo wsl; else echo linux; fi ;;
    MINGW*|MSYS*|CYGWIN*) echo windows ;;
    *) echo unknown ;;
  esac
}

# Run the first opener that exists, and SAY SO when none does.
#
# The silence is the point. `open` does not exist on Linux, and with stderr
# discarded a dashboard click there was a no-op that logged nothing and showed
# nothing — the same failure shape as the automation-browser bug, and for the
# same reason: a browser-opening path that cannot report its own failure. Every
# branch here ends in either a launched browser or a message in the pane.
try_openers() {
  local url="$1"; shift
  local cmd
  for cmd in "$@"; do
    # shellcheck disable=SC2086 # deliberate: entries carry their own arguments
    if command -v ${cmd%% *} >/dev/null 2>&1; then
      click_log "$(date -u +%Y-%m-%dT%H:%M:%SZ)   open_url url=$url via=$cmd"
      eval "$cmd \"\$url\"" >/dev/null 2>&1
      return 0
    fi
  done
  click_log "$(date -u +%Y-%m-%dT%H:%M:%SZ)   open_url url=$url NO OPENER (tried: $*)"
  note "statusline: no way to open a browser here (tried: $*)"
  return 1
}

open_url() {
  local url="$1" prefix="${2:-$1}"
  local platform; platform="$(click_platform)"
  # Test seam: the suites (and a human checking a mapping) need to see WHICH url
  # a tag resolves to without a browser window appearing on someone's screen.
  if [ -n "${STATUSLINE_CLICK_DRYRUN:-}" ]; then
    echo "would open: $url (reuse prefix: $prefix) [$platform]"; return
  fi

  case "$platform" in
    macos) ;;  # falls through to the Chrome/AppleScript path below
    linux)
      # No scripting bridge to Chrome here, so no tab reuse — a new tab is the
      # honest ceiling rather than a silent miss.
      try_openers "$url" xdg-open 'gio open' sensible-browser x-www-browser firefox; return ;;
    wsl)
      # wslview (wslu) hands the URL to the Windows default browser; cmd.exe is
      # the fallback every WSL install has. The empty "" is the window TITLE
      # argument start consumes — without it the URL becomes the title and
      # nothing opens.
      try_openers "$url" wslview 'cmd.exe /c start ""' 'powershell.exe -NoProfile Start-Process'; return ;;
    windows)
      try_openers "$url" 'cmd /c start ""' 'powershell -NoProfile Start-Process' start; return ;;
    *)
      note "statusline: unknown platform '$(uname -s)' — cannot open $url"; return ;;
  esac

  if [ ! -d "/Applications/Google Chrome.app" ]; then open "$url" >/dev/null 2>&1; return; fi

  if automation_chrome_running; then
    # Correctness over tidiness: a new tab in the RIGHT browser beats a reused
    # tab in one the user cannot see. `open` both routes and raises.
    click_log "$(date -u +%Y-%m-%dT%H:%M:%SZ)   open_url url=$url via=launchservices (automation chrome up)"
    open "$url" >/dev/null 2>&1
    return
  fi

  # A first run prompts for permission to control Chrome; a refusal (or a
  # scripting error of any kind) must still get the user their page, so every
  # failure path falls through to a plain open.
  # stdout is DISCARDED, not just stderr. osascript prints the handler's return
  # value ("reused" / "new-tab"), and tmux's run-shell renders ANY output from
  # the command in a view the user then has to dismiss with ESC — so a
  # successful click would interrupt the very session it was meant to serve.
  # The return values are kept because they are useful when debugging this by
  # hand; they are simply not allowed to reach tmux.
  # The AppleScript's verdict is CAPTURED, not discarded. It is the only place
  # that knows which of the three paths ran and which tab it picked, and a click
  # that lands on the wrong tab looks identical from outside to one that worked.
  # It still must not reach tmux's stdout (run-shell renders any output in a
  # view the user has to dismiss with ESC), so it goes to the same log.
  local verdict
  verdict="$(osascript - "$url" "$prefix" 2>&1 <<'AS'
on run argv
  set targetURL to item 1 of argv
  set matchPrefix to item 2 of argv
  tell application "Google Chrome"
    if (count of windows) is 0 then
      make new window
      set URL of active tab of front window to targetURL
      activate
      return "new-window"
    end if
    repeat with w in windows
      set idx to 0
      repeat with t in tabs of w
        set idx to idx + 1
        if (URL of t as string) starts with matchPrefix then
          if (URL of t as string) is not targetURL then set URL of t to targetURL
          set active tab index of w to idx
          set index of w to 1
          activate
          return "reused idx=" & idx & " active=" & (active tab index of w) & " wins=" & (count of windows)
        end if
      end repeat
    end repeat
    tell front window to make new tab with properties {URL:targetURL}
    activate
    return "new-tab"
  end tell
end run
AS
)"
  local rc=$?
  click_log "$(date -u +%Y-%m-%dT%H:%M:%SZ)   open_url url=$url rc=$rc verdict=${verdict//$'\n'/ }"

  # RAISING CHROME IS A SEPARATE STEP, and it is not optional.
  #
  # `activate` inside the AppleScript above is not enough. Issued from the tmux
  # SERVER process it routinely loses macOS's focus-stealing check, and the
  # result is the worst possible failure mode: the tab really is re-used and
  # navigated, so nothing is broken and nothing is logged, but the window stays
  # behind the terminal and the click reads as a dead no-op. That is the
  # regression the tab-reuse rewrite introduced — the `open` call it replaced
  # was raising the window as a side effect of going through LaunchServices.
  #
  # `open -a` with NO url is that same LaunchServices activation on its own: it
  # wins focus where `activate` does not, and opens no tab, so it composes with
  # the reuse above instead of undoing it. On the AppleScript failure path the
  # url comes with it, since there is then no tab to raise.
  if [ "$rc" -eq 0 ]; then
    open -a "Google Chrome" >/dev/null 2>&1
  else
    open -a "Google Chrome" "$url" >/dev/null 2>&1
  fi
}

# Show a report in a popup over the clicked pane. Held open until a keypress —
# a popup that vanishes with its command is unreadable for anything longer than
# one line.
popup() {
  local title="$1" cmd="$2"
  # Same test seam as open_url: run the report to stdout instead of throwing a
  # popup over whatever the user is actually doing.
  if [ -n "${STATUSLINE_CLICK_DRYRUN:-}" ]; then
    echo "would popup: $title"; eval "$cmd"; return
  fi
  if [ -z "$PANE" ]; then eval "$cmd"; return; fi
  tmux display-popup -E -t "$PANE" -w 84% -h 60% -T " $title " \
    "bash -lc $(printf '%q' "$cmd"'; printf "\n── any key to close ──"; read -rsn1')"
}

# Project name -> checkout path, from the health coordinator (the only place
# that knows where each running session's project actually lives). Matched by
# PREFIX: tmux caps a range tag at 15 bytes, so a long project name reaches us
# truncated, and re-deriving the abbreviation here would mean a second copy of
# getProjectAbbreviation() drifting against the one in the status line.
project_path_for() {
  curl -s --max-time 4 "$COORDINATOR/health/state" 2>/dev/null | python3 -c '
import json, sys
want = sys.argv[1].lower()
try:
    state = json.load(sys.stdin)
except Exception:
    sys.exit(1)
best = None
for entry in (state.get("lsl") or {}).values():
    name, path = (entry.get("projectName") or ""), entry.get("projectPath")
    if not name or not path:
        continue
    if name.lower().startswith(want):
        # Shortest match wins: "cod" must resolve to "coding", not "coding-experiments".
        if best is None or len(name) < len(best[0]):
            best = (name, path)
if best:
    print(best[1])
' "$1" 2>/dev/null
}

# git remote -> browsable URL. Covers the three remote spellings in use here:
# scp-style ssh (git@host:owner/repo.git), ssh:// URLs, and plain https.
remote_web_url() {
  git -C "$1" remote get-url origin 2>/dev/null | sed -E \
    -e 's#^git@([^:]+):#https://\1/#' \
    -e 's#^ssh://git@([^/]+)/#https://\1/#' \
    -e 's#\.git$##'
}

# Open a page AND say which one, in the pane.
#
# tmux has no hover event — its mouse-key list (MouseDown/Up/Drag/Wheel/Click)
# has no MouseMove at all — so a field cannot light up under the pointer to
# advertise that it is clickable. This is the affordance that is actually
# available: the first time someone clicks a field, even by accident, the pane
# says what it just did, and clickability is discovered from there.
#
# It doubles as delivery confirmation, which this feature has badly needed. A
# click that opened a page in a browser the user could not see, or on a platform
# with no `open`, was indistinguishable from a click that never registered —
# twice over. A named message is the difference between "nothing happened" and
# "it went somewhere I did not expect".
#
# Popups need none of this: the popup IS the feedback, immediately and on top.
open_named() {
  note "→ $1"
  open_url "$2" "${3:-$2}"
}

case "$TAG" in
  health)      open_named "System Health dashboard" "$DASHBOARD/" "$DASHBOARD" ;;
  lsl)         open_named "Sessions (live session logs)" "$DASHBOARD/sessions" "$DASHBOARD" ;;
  obs)         open_named "Observations" "$DASHBOARD/observations" "$DASHBOARD" ;;
  ukb)         open_named "Performance (UKB)" "$DASHBOARD/performance" "$DASHBOARD" ;;
  constraints) open_named "Constraints dashboard" "$CONSTRAINTS/" "$CONSTRAINTS" ;;

  p:*)
    name="${TAG#p:}"
    path="$(project_path_for "$name")"
    if [ -z "$path" ]; then
      note "statusline: no running project matching '$name'"
      exit 0
    fi
    url="$(remote_web_url "$path")"
    if [ -z "$url" ]; then
      note "statusline: $path has no 'origin' remote"
      exit 0
    fi
    open_named "$name — $url" "$url" "$url"
    ;;

  net)      popup "Network and LLM routing" "CODING_REPO='$CODING_REPO' node '$CODING_REPO/scripts/statusline-click-report.mjs' net" ;;
  semantic) popup "Semantic readiness"        "CODING_REPO='$CODING_REPO' node '$CODING_REPO/scripts/statusline-click-report.mjs' semantic" ;;
  ctx)      popup "Context window" \
              "CODING_REPO='$CODING_REPO' CODING_AGENT='$pane_agent' \
               TMUX_SESSION_NAME='$pane_session' TRANSCRIPT_SOURCE_PROJECT='$pane_project' \
               node '$CODING_REPO/scripts/statusline-click-report.mjs' ctx" ;;

  ''|window|pane|session) : ;;   # not one of ours — the binding handles these
  *) note "statusline: unmapped field '$TAG'" ;;
esac

# ALWAYS exit 0. tmux renders a failing `run-shell` in a view the user then has
# to dismiss with ESC, so a click that could not find a browser would interrupt
# the session it was meant to serve — punishing the user for a missing xdg-open.
# Everything above reports its own failure through note()/the log, which is the
# channel that belongs to this feature; the exit status belongs to tmux.
exit 0
