#!/usr/bin/env bash
# Self-healing front end to the gsd-browser CLI.
#
# gsd-browser runs a background `_serve` daemon that owns one headless Chrome.
# The two can get out of step: kill the browser and the daemon stays up holding
# a dead CDP connection, after which EVERY command fails with
#
#     Error: navigate failed: send failed because receiver is gone
#
# and keeps failing forever, because nothing notices. The daemon is not
# supervised — no launchd job, no KeepAlive — and the published binary is a
# closed prebuilt (a root-owned symlink into ~/.gsd-browser/bin), so the restart
# cannot be added where it belongs, inside the daemon. This shim is the next
# best place: it sits earlier on PATH than /usr/local/bin, notices that exact
# failure, restarts the daemon, and retries once.
#
# How it happens in practice: the documented fix for a *different* fault — an
# orphaned Chrome holding a SingletonLock — is `pkill -9 -f chromiumoxide-runner`.
# That kills the browser and leaves the daemon, i.e. it converts one broken
# state into this one. On 2026-09-01 a stray pkill did the same thing by
# accident and left the tool dead for a day; the recipe everyone reaches for
# (kill chrome, clear Singleton*) does not fix this variant, because the stale
# component is the daemon.
#
# Deliberately narrow: only this signature retries, only once, and only the
# daemon is restarted. A blanket "retry on any error" would paper over real
# failures — a bad selector, an unreachable URL — and turn a fast no into a slow
# one. Set GSD_BROWSER_NO_AUTOHEAL=1 to pass straight through.

# No `-e`: this script's whole job is to inspect a non-zero exit code.
set -uo pipefail

REAL="${GSD_BROWSER_BIN:-${HOME}/.gsd-browser/bin/gsd-browser}"

if [[ ! -x "${REAL}" ]]; then
    echo "gsd-browser: real binary not found at ${REAL}" >&2
    echo "  set GSD_BROWSER_BIN to its path, or reinstall gsd-browser" >&2
    exit 127
fi

# Refuse to invoke ourselves. If the install ever moves such that ${REAL}
# resolves back to this shim, recursing would fork-bomb rather than fail.
if [[ "$(cd "$(dirname "${REAL}")" && pwd -P)/$(basename "${REAL}")" == "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")" ]]; then
    echo "gsd-browser: GSD_BROWSER_BIN points back at this shim — refusing to recurse" >&2
    exit 127
fi

if [[ -n "${GSD_BROWSER_NO_AUTOHEAL:-}" ]]; then
    exec "${REAL}" "$@"
fi

# TWO wedges, and healing the first can cause the second — which is why both
# are handled here rather than only the one that prompted this.
#
#   A. Daemon alive, browser dead  -> "…send failed because receiver is gone"
#   B. Stale SingletonLock         -> "daemon exited during startup with status
#                                      exit status: 1", and with GSD_BROWSER_DEBUG=1,
#                                      "Failed to create …/SingletonLock: File exists"
#
# B is what a SIGKILLed Chrome leaves behind: the lock in the automation profile
# is only removed on a clean exit. So `pkill -9 -f chromiumoxide-runner` — the
# standard fix for A — reliably produces B, and a restart that does not also
# clear the lock just trades one dead state for another. Observed doing exactly
# that on 2026-09-02 while testing this shim.
DEAD_RECEIVER='receiver is gone'
DEAD_DAEMON='daemon exited during startup'

# Chrome profile the daemon drives. Its own dir, not the user's real profile —
# clearing a lock here cannot touch a browsing session.
# The gsd-browser build of 2026-09-04 MOVED this profile out of the temp dir to
# ~/.gsd-browser/browser-profile, and the session manifest is the only thing that
# actually knows where it is. Hardcoding the old temp path made every branch
# below a silent no-op: `pkill -f chromiumoxide-runner` matched nothing (that
# string is a --user-data-dir argument, so it moved with the profile), and the
# lock clear cleaned a directory Chrome had stopped using. The visible symptom
# was Chrome's "Something went wrong when opening your profile" dialog on every
# single launch, because nothing was left to reset the crash flag.
#
# Read the manifest, fall back to the current default, and only then to the old
# temp path so an older binary still recovers.
CHROME_PROFILE="$(
    node -e 'try{const j=require(process.env.HOME+"/.gsd-browser/session.json");if(j.browserUserDataDir)process.stdout.write(j.browserUserDataDir)}catch{}' 2>/dev/null
)"
[[ -z "${CHROME_PROFILE}" || ! -d "${CHROME_PROFILE}" ]] && CHROME_PROFILE="${HOME}/.gsd-browser/browser-profile"

# Fall back to the legacy temp path only when it actually EXISTS — i.e. an older
# binary really is using it. The first spelling of this dropped to the legacy path
# whenever the CURRENT default was absent, which is exactly the state of a fresh
# install: session.json is written by the daemon and browser-profile is created on
# first start, so before the first run neither exists and the shim aimed its reset
# at a directory nothing would ever use. Same silent no-op this commit's parent set
# out to remove, reintroduced for new machines.
if [[ ! -d "${CHROME_PROFILE}" && -d "${TMPDIR:-/tmp}/chromiumoxide-runner" ]]; then
    CHROME_PROFILE="${TMPDIR:-/tmp}/chromiumoxide-runner"
fi

# Match the automation Chrome by its --user-data-dir, which is what makes it the
# automation instance. Never a bare "Chrome": this pattern is passed to pkill -9,
# and matching the user's own browser would kill their real session.
CHROME_MATCH="user-data-dir=${CHROME_PROFILE}"

# Did WE start this browser, or were we pointed at one that was already running
# (`daemon --cdp-url ws://…`, "attach to an already-running Chrome")? Only the
# first is ours to kill. In attach mode the manifest's browserUserDataDir names
# the profile of a browser THE USER started — very possibly their real, logged-in
# one — and CHROME_MATCH would then be a pkill pattern aimed straight at it.
LAUNCH_MODE="$(
    node -e 'try{const j=require(process.env.HOME+"/.gsd-browser/session.json");if(j.launchMode)process.stdout.write(String(j.launchMode))}catch{}' 2>/dev/null
)"

# Whether the automation Chrome may be SIGKILLed.
#
# The PATH is the decisive test, not launchMode: gsd-browser's own profile lives
# under its own directories, and a browser we merely attached to does not. That
# ordering matters — an older binary writes no launchMode at all, and gating on
# the field being present would silently turn the autoheal reset into a no-op on
# exactly the installs that still need it. So: the path decides, and launchMode
# only ever VETOES.
browser_is_ours() {
    case "${CHROME_PROFILE}" in
        "${HOME}/.gsd-browser/"*) ;;
        "${TMPDIR:-/tmp}/"*) ;;
        *) return 1 ;;  # not one of ours — never a pkill target
    esac
    # An explicit attach, even to a profile inside our tree, is still not ours.
    [[ -n "${LAUNCH_MODE}" && "${LAUNCH_MODE}" != "launched" ]] && return 1
    return 0
}

# Explicit XXXXXX template, not `mktemp -t gsd-browser-err`: GNU coreutils is
# ahead of /usr/bin on this PATH and its -t wants a template with X's, so the
# BSD spelling fails with "too few X's in template" — and, because the error
# lands on stderr while mktemp still exits into an empty variable, it fails by
# redirecting every command's stderr to "" rather than by stopping.
ERRFILE="$(mktemp "${TMPDIR:-/tmp}/gsd-browser-err.XXXXXX")" || {
    echo "gsd-browser: could not create a temp file for stderr capture" >&2
    exec "${REAL}" "$@"
}
trap 'rm -f "${ERRFILE}"' EXIT

# stdout is NOT captured — `screenshot` and `page-source` emit raw bytes, and
# routing them through a shell variable would corrupt them and buffer them.
# Only stderr is inspected, which is where every error above goes.
run() {
    "${REAL}" "$@" 2> "${ERRFILE}"
}

# How much the last sweep actually killed. Read by the `daemon stop` path below
# to report only when there was something to report.
SWEPT_DAEMONS=0
SWEPT_BROWSER=0

# SIGKILL both halves and clear what a SIGKILL leaves behind. Two callers with
# the same need: the autoheal retry below, and `daemon stop`, which reports
# success without stopping anything.
sweep_daemons_and_browser() {
    SWEPT_DAEMONS=0
    SWEPT_BROWSER=0

    # Test seam. The real reset SIGKILLs the daemon and every automation Chrome,
    # which a test suite must not do to a developer's live session just by
    # running. A hook lets the retry logic be exercised for real while the
    # destructive half is stubbed — and lets the test assert the reset was
    # actually reached, which a no-op flag could not.
    if [[ -n "${GSD_BROWSER_RESET_HOOK:-}" && -x "${GSD_BROWSER_RESET_HOOK}" ]]; then
        "${GSD_BROWSER_RESET_HOOK}"
        return 0
    fi

    # Kill by executable name, never by `pkill -f 'gsd-browser _serve'`: this
    # shim's own command line CONTAINS that string when invoked as
    # `gsd-browser _serve`, so a -f match would have the shim kill itself.
    # Filtering on comm= means only the real binary's processes are candidates.
    local pid pids=()
    while read -r pid; do
        [[ -z "${pid}" || "${pid}" == "$$" ]] && continue
        [[ "$(/bin/ps -o comm= -p "${pid}" 2>/dev/null | xargs basename 2>/dev/null)" == "gsd-browser" ]] \
            && pids+=("${pid}")
    done < <(pgrep -f '_serve' 2>/dev/null)

    if (( ${#pids[@]} > 0 )); then
        kill -9 "${pids[@]}" 2>/dev/null
        SWEPT_DAEMONS=${#pids[@]}
    fi

    # Then the browser it was driving. An orphaned automation Chrome is a wedge
    # in its own right — the third state, and the one that actually blocked
    # recovery here: with the daemon gone its Chrome kept running, kept holding
    # a VALID SingletonLock naming its own pid, and every new daemon was refused
    # the profile by ProcessSingleton. Preserving that lock is pointless (no
    # daemon is using the browser) and fatal (nothing else can start one).
    #
    # This whole half — the kill, the lock clear, the crash-flag rewrite — is
    # gated on the profile being ours. The comment that used to sit here said it
    # was "safe by construction, a temp --user-data-dir, so nothing here can
    # touch a real browsing session". That is true of a browser we LAUNCHED and
    # false of one we were told to ATTACH to, where every path below is aimed at
    # the user's own profile: pkill on their session, rm on their SingletonLock,
    # and a rewrite of their Preferences. Construction was never what made it
    # safe; the guard is.
    if browser_is_ours; then
        pgrep -f "${CHROME_MATCH}" >/dev/null 2>&1 && SWEPT_BROWSER=1
        pkill -9 -f "${CHROME_MATCH}" 2>/dev/null

        # Wait for the profile to actually be free before clearing. Killing is
        # asynchronous, and removing a lock while its owner is still exiting invites
        # the two-processes-one-profile corruption the lock exists to prevent.
        local waited=0
        while pgrep -f "${CHROME_MATCH}" >/dev/null 2>&1 && (( waited < 10 )); do
            sleep 0.5
            waited=$(( waited + 1 ))
        done

        # Only now, and only if the profile is genuinely unowned.
        if ! pgrep -f "${CHROME_MATCH}" >/dev/null 2>&1; then
            rm -f "${CHROME_PROFILE}"/Singleton* 2>/dev/null

            # Clearing the lock is not enough. A SIGKILLed Chrome also leaves
            # profile.exit_type = "Crashed" in Default/Preferences, and on the next
            # start that raises a MODAL "Something went wrong when opening your
            # profile" dialog. Headless it is invisible but still blocking; headful
            # the operator has to dismiss it by hand, once per launch, forever —
            # observed 8-10 times in a row on 2026-09-05 because this reset was
            # pointed at the wrong directory and never ran.
            #
            # Chrome itself only rewrites this on a clean exit, which is precisely
            # what -9 denies it, so the reset that caused the flag has to clear it.
            local prefs="${CHROME_PROFILE}/Default/Preferences"
            [[ -f "${prefs}" ]] && node -e '
                const fs = require("fs"), p = process.argv[1];
                try {
                    const j = JSON.parse(fs.readFileSync(p, "utf8"));
                    j.profile = j.profile || {};
                    j.profile.exit_type = "Normal";
                    j.profile.exited_cleanly = true;
                    fs.writeFileSync(p, JSON.stringify(j));
                } catch { /* unreadable/partial profile: Chrome rebuilds it */ }
            ' "${prefs}" 2>/dev/null
        fi
    fi
    return 0
}

# Is this invocation `daemon stop` against the DEFAULT session?
#
# Conservative by construction: it walks to the first two non-option tokens and
# demands exactly "daemon" "stop". An option that takes a value (`--browser-path
# /path/to/chrome`) puts a non-option token first and the match simply fails —
# no sweep, which is the safe way to be wrong.
#
# `--session` and `--cdp-url` are refused outright. Both mean the daemon being
# stopped is not the one the default manifest describes: a named session has its
# own daemon and its own profile, and an attached browser is not ours at all.
# Sweeping the default profile on either would kill the wrong thing.
is_daemon_stop() {
    local a seen=()
    for a in "$@"; do
        case "${a}" in
            --session|--session=*|--cdp-url|--cdp-url=*) return 1 ;;
        esac
    done
    for a in "$@"; do
        [[ "${a}" == -* ]] && continue
        seen+=("${a}")
        (( ${#seen[@]} == 2 )) && break
    done
    (( ${#seen[@]} == 2 )) && [[ "${seen[0]}" == "daemon" && "${seen[1]}" == "stop" ]]
}

run "$@"
rc=$?

if (( rc != 0 )) \
    && { grep -qF "${DEAD_RECEIVER}" "${ERRFILE}" 2>/dev/null \
      || grep -qF "${DEAD_DAEMON}" "${ERRFILE}" 2>/dev/null; }; then
    echo "gsd-browser: browser/daemon out of step — resetting both and retrying once" >&2
    sweep_daemons_and_browser
    run "$@"
    rc=$?
fi

# `daemon stop` says "Daemon stopped." and exits 0 while stopping neither half.
# Verified 2026-09-05 against the live install: 11 orphaned daemons and 2
# automation Chromes before the call, the same 11 and 2 after it. The manifest
# shows why it cannot do better — it records `daemonPid: null`, so stop has no
# pid to signal, and it records `browserPid` and then never uses it.
#
# The cost is not cosmetic: every orphaned daemon holds a dead CDP connection,
# and an orphaned Chrome keeps a VALID SingletonLock on the profile, which is
# the state that refuses every future daemon the profile (wedge C above). So the
# thing the user asked to stop is also the thing that wedges the next start.
#
# Only on rc == 0: a stop that FAILED has not established that anything should
# be torn down, and killing both halves after an error would destroy the state
# needed to diagnose it.
if (( rc == 0 )) && is_daemon_stop "$@"; then
    sweep_daemons_and_browser
    if (( SWEPT_DAEMONS > 0 || SWEPT_BROWSER > 0 )); then
        swept="${SWEPT_DAEMONS} orphaned daemon(s)"
        (( SWEPT_BROWSER > 0 )) && swept="${swept} and the automation browser"
        echo "gsd-browser: stop left ${swept} running — swept" >&2
    fi
fi

cat "${ERRFILE}" >&2
exit "${rc}"
