#!/bin/bash
# Manual post-session logger trigger


# Feature gate. Without it this command fails with whatever its backend happens
# to say — "connection refused", "no such container", a timeout — none of which
# mention that the feature is switched off. See docs/architecture/features.md.
if [ -z "${CODING_REPO:-}" ]; then
  CODING_REPO="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
  export CODING_REPO
fi
# shellcheck source=/dev/null
. "$CODING_REPO/lib/features/require-feature.sh"
require_feature lsl

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODING_REPO_DIR="$(dirname "$SCRIPT_DIR")"

echo "📝 Manually triggering post-session logging..."

# Run the simplified session logger with multi-topic support
if [[ -f "$CODING_REPO_DIR/scripts/post-session-logger.js" ]]; then
    node "$CODING_REPO_DIR/scripts/post-session-logger.js" "$(pwd)" "$CODING_REPO_DIR"
else
    echo "❌ Post-session logger not found at: $CODING_REPO_DIR/scripts/post-session-logger.js"
    exit 1
fi