# graphify ignore file (.gitignore syntax) — scopes the code-graph extraction to
# project SOURCE, excluding vendored deps, build outputs, data, and logs. This is
# read directly by graphify (independent of git) and "can only ever exclude MORE",
# so it is the authoritative guard against walking node_modules etc.

# Vendored / installed dependencies
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/__pycache__/
*.egg-info/

# Build / compiled outputs
dist/
**/dist/
build/
**/build/
*.min.js
*.map

# Runtime data, caches, exports, logs (not source)
.data/
.observations/
.cache/
**/.cache/
logs/
.logs/
coverage/
**/coverage/

# Session logs / planning history (large, non-code)
.specstory/

# VCS
.git/
**/.git/

# Agent local machine-state — tracked but constantly rewritten; never source.
.claude/settings.local.json

# Published benchmark reports — the answer key for kgbench.
#
# These name every question and the facts an answer must contain. Publishing them is
# right for a reader, but graphify indexes markdown HEADINGS as nodes, so leaving them
# in gives the graph arms of the next run a hint no grep arm can see: the run tree
# strips this directory (DEFAULT_EXCLUDES in lib/kgbench/sandbox.mjs), and without the
# matching entry here the exclusion would hold for files and leak through the index.
# One heading alone names the abstain class as the-answer-is-not-here — decisive for
# exactly the class the benchmark exists to test.
docs/benchmarks/coding-v1/
