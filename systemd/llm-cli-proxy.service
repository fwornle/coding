# coding: LLM proxy, rapid-llm-proxy on :12435 (feature: llm-proxy)
# Linux twin of launchd/com.coding.llm-cli-proxy.plist, which carries the reasoning
# behind each setting. tests/features/systemd-units.test.mjs keeps the two equal.
#
# Restart=always for the same reason the plist's KeepAlive is <true/>: the
# daemon traps SIGTERM and exits 0, so on-failure would leave any stray stop
# permanent. A deliberate stop is `systemctl --user stop`, which it respects.
[Unit]
Description=coding: LLM proxy, rapid-llm-proxy on :12435 (feature: llm-proxy)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__CODING_REPO__
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
Environment=CODING_REPO=__CODING_REPO__
ExecStart=/bin/bash "__CODING_REPO__/scripts/llm-proxy-service.sh"
Restart=always
RestartSec=10
StandardOutput=append:__CODING_REPO__/.logs/llm-proxy-service.log
StandardError=append:__CODING_REPO__/.logs/llm-proxy-service.log

[Install]
WantedBy=default.target
