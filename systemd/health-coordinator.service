# coding: health coordinator on :3034 (feature: health)
# Linux twin of launchd/com.coding.health-coordinator.plist, which carries the reasoning
# behind each setting. tests/features/systemd-units.test.mjs keeps the two equal.
#
# Restart=always for the same reason the plist's KeepAlive is <true/>: the
# daemon traps SIGTERM and exits 0, so on-failure would leave any stray stop
# permanent. A deliberate stop is `systemctl --user stop`, which it respects.
[Unit]
Description=coding: health coordinator on :3034 (feature: health)

[Service]
Type=simple
WorkingDirectory=__CODING_REPO__
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
Environment=HEALTH_COORDINATOR_PORT=3034
ExecStart=/bin/sh -c 'exec node "$$@"' node "__CODING_REPO__/scripts/health-coordinator.js"
Restart=always
RestartSec=30
StandardOutput=append:__CODING_REPO__/.logs/health-coordinator.log
StandardError=append:__CODING_REPO__/.logs/health-coordinator.log

[Install]
WantedBy=default.target
