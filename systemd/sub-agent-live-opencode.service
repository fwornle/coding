# coding: live opencode sub-agent transcript capture (feature: lsl)
# Linux twin of launchd/com.coding.sub-agent-live-opencode.plist, which carries the reasoning
# behind each setting. tests/features/systemd-units.test.mjs keeps the two equal.
#
# Restart=always for the same reason the plist's KeepAlive is <true/>: the
# daemon traps SIGTERM and exits 0, so on-failure would leave any stray stop
# permanent. A deliberate stop is `systemctl --user stop`, which it respects.
[Unit]
Description=coding: live opencode sub-agent transcript capture (feature: lsl)

[Service]
Type=simple
WorkingDirectory=__CODING_REPO__
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec node "$$@"' node "__CODING_REPO__/scripts/sub-agent-live-opencode.mjs" --state-file "__CODING_REPO__/.data/sub-agent-live-state-opencode.json"
Restart=always
RestartSec=60
StandardOutput=append:__CODING_REPO__/.data/live-opencode.log
StandardError=append:__CODING_REPO__/.data/live-opencode.log

[Install]
WantedBy=default.target
