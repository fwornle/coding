<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.coding.measurement-reconciler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec node "$@"</string>
        <string>node</string>
        <string>__CODING_REPO__/scripts/measurement-reconciler.mjs</string>
        <string>--verbose</string>
    </array>
    <!--
      KeepAlive is UNCONDITIONAL. It was {SuccessfulExit: false, NetworkState:
      true}, and the reconciler traps SIGTERM and exits 0 — so SuccessfulExit
      made any signalled stop permanent: a bootout or a migration's SIGTERM
      (2026-09-28) left it dead with nothing restarting it, for five days.
      NetworkState is not implemented at all (man 5 launchd.plist). Same defect,
      same fix, as the sub-agent live daemons' 14.5h outage on 2026-09-01. Stop
      it with `launchctl bootout`, not a kill.
    -->
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>WorkingDirectory</key>
    <string>__CODING_REPO__</string>
    <key>StandardErrorPath</key>
    <string>__CODING_REPO__/.data/measurement-reconciler.log</string>
    <key>StandardOutPath</key>
    <string>__CODING_REPO__/.data/measurement-reconciler.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin</string>
    </dict>
</dict>
</plist>
